# Base de données (Neon)
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Discord (Developer Portal → New Application → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Webhook du salon où poster les résultats/rappels (Salon → Intégrations → Webhooks)
DISCORD_WEBHOOK_URL=

# Steam (https://steamcommunity.com/dev/apikey — compte avec ≥5$ dépensés requis)
STEAM_API_KEY=

# IGDB (compte Twitch dev → https://dev.twitch.tv/console → application)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optionnel : protège /api/cron/reminders contre un déclenchement par un
# tiers qui devinerait l'URL. Vercel Cron envoie automatiquement
# `Authorization: Bearer <CRON_SECRET>` si cette variable est configurée
# sur le projet (aucune config supplémentaire côté vercel.json).
CRON_SECRET=
