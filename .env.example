# Base de données (Neon)
DATABASE_URL=
# Recette locale uniquement : PostgreSQL sur loopback, jamais une URL hébergée.
#TEST_DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Discord (Developer Portal → New Application → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Webhook du salon où poster les résultats/rappels (Salon → Intégrations → Webhooks)
DISCORD_WEBHOOK_URL=

# Optionnel : jeton du BOT de l'application (Developer Portal → ton appli →
# Bot → Reset Token), invité sur le serveur Discord du groupe. Utilisé
# UNIQUEMENT par /api/cron/refresh-discord-profiles, en REPLI pour les users
# qui n'ont pas encore de jeton OAuth personnel enregistré en base (voir
# README, section F1 bis) — le mécanisme principal du cron réutilise/rafraîchit
# désormais le jeton OAuth propre à chaque user (persisté en base à chaque
# connexion, sans dépendre de ce jeton bot ni du réseau d'amis Discord du
# bot). Sans cette variable, seul le repli est désactivé, le cron continue de
# fonctionner pour tous les users déjà passés par une reconnexion.
DISCORD_BOT_TOKEN=

# Steam (https://steamcommunity.com/dev/apikey — compte avec ≥5$ dépensés requis)
STEAM_API_KEY=

# IGDB (compte Twitch dev → https://dev.twitch.tv/console → application)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optionnel : traduction FR des descriptions IGDB (anglais uniquement) sur
# la fiche jeu. Compte gratuit sur https://www.deepl.com/pro-api (plan
# Free, 500k caractères/mois) → clé dans le compte, onglet API. Sans
# cette variable, la fiche jeu affiche la description originale en
# anglais (pas de traduction, pas d'erreur).
DEEPL_API_KEY=

# Optionnel : upload de bannière de profil (URL reste utilisable sans ça).
# Vercel Blob, plan Hobby → 5 Go gratuits. Vercel → onglet Storage → Create
# Database → Blob → Create Store, puis onglet ".env.local" du store créé
# pour copier le token (ou `vercel env pull` si le projet est lié en CLI).
# Sans cette variable, l'onglet "Uploader une image" de /profil/parametres
# affiche "Fonctionnalité désactivée" au lieu de planter.
BLOB_READ_WRITE_TOKEN=
# Jeton d'un store Vercel Blob PRIVATE dédié aux médias de soirée.
SESSION_MEDIA_BLOB_TOKEN=
# Clips MP4 dans la galerie privée; OFF tant que la valeur n'est pas exactement `true`.
SESSION_VIDEO_ENABLED=

# Optionnel (recommandée en prod) : protège /api/cron/reminders contre un
# déclenchement par un tiers qui devinerait l'URL. Le plan Vercel Hobby
# n'autorisant pas un cron à 15 min, F7 est déclenchée par un cron externe
# (ex. cron-job.org) — configure-le pour envoyer l'en-tête
# `Authorization: Bearer <CRON_SECRET>` (voir README, section F7).
# ATTENTION (PR "Accès & secrets") : les routes /api/cron/* et
# /api/backfill/* sont maintenant fail-closed — si cette variable est
# absente, elles répondent 503 (désactivées) au lieu de s'exécuter sans
# authentification.
CRON_SECRET=

# Chiffrement au repos des jetons OAuth Discord stockés en base
# (User.discordAccessToken/discordRefreshToken) — AES-256-GCM. Clé DÉDIÉE,
# distincte de AUTH_SECRET/CRON_SECRET/DATABASE_URL. Générer avec :
#   openssl rand -base64 32
# À CONFIGURER SUR VERCEL (Production ET Preview) AVANT de déployer le code
# qui l'utilise. Sans cette variable, les nouveaux jetons ne sont plus
# persistés en base (jamais en clair) — la connexion reste fonctionnelle,
# seul le rafraîchissement auto d'avatar/pseudo par cron en pâtit pour
# l'utilisateur concerné (repli automatique sur le jeton du bot si
# DISCORD_BOT_TOKEN est configuré). Voir README, section "Chiffrement des
# jetons OAuth Discord", pour le détail (rollout, perte/rotation de clé).
DISCORD_TOKEN_ENCRYPTION_KEY=

# Requise pour avoir au moins un admin dès le premier déploiement (PR
# "Accès & secrets") : liste de discordId (le snowflake Discord, PAS le
# pseudo — mode développeur Discord → clic droit sur ton profil → "Copier
# l'ID utilisateur"), séparés par des virgules si plusieurs. Un discordId
# listé ici est TOUJOURS traité comme admin de /admin, même si sa colonne
# `role` en base dit `USER` (filet anti-verrouillage). Voir README pour le
# détail.
ADMIN_DISCORD_IDS=

# Optionnel, DÉSACTIVÉ PAR DÉFAUT (exécuteur de notifications, PR 3/N du
# chantier notifications Discord — voir README, section "Exécuteur de
# notifications"). Doit valoir EXACTEMENT "true" pour activer
# /api/cron/notification-executor — toute autre valeur (absente, vide,
# "false"...) laisse la route répondre sans réclamer la moindre livraison
# ni faire le moindre appel Discord. Verrou INDÉPENDANT de
# DISCORD_BOT_SESSION_ANNOUNCE_ENABLED ci-dessous : les deux doivent être
# activés ENSEMBLE pour qu'une annonce/fil de soirée bot parte réellement.
# Non configurée par cette PR — à activer manuellement plus tard, voir le
# README pour la procédure.
NOTIFICATION_EXECUTOR_ENABLED=

# Optionnel, DÉSACTIVÉ PAR DÉFAUT (chantier annonces Discord bot — salons
# #🎮-soirées/#🏆-tournois et fils par événement, voir README). Le serveur
# Discord et les salons d'annonces sont EXCLUSIVEMENT des variables
# d'environnement, jamais une destination choisie par un formulaire.
# `DISCORD_BOT_GUILD_ID` : ID du serveur (mode développeur Discord → clic
# droit sur le serveur → "Copier l'ID du serveur"), PARTAGÉ par les deux
# chantiers (un seul serveur Discord pour toute l'app).
# `DISCORD_BOT_SESSION_CHANNEL_ID` : ID du salon #🎮-soirées. Sans les
# DEUX renseignés, ou sans `DISCORD_BOT_SESSION_ANNOUNCE_ENABLED=true`
# (exactement cette valeur), toute nouvelle session continue d'utiliser le
# webhook existant (DISCORD_WEBHOOK_URL, inchangé). `DISCORD_BOT_TOURNAMENT_CHANNEL_ID` :
# ID du salon #🏆-tournois, même procédure (clic droit sur le salon →
# "Copier l'ID du salon"), même règle d'activation avec
# `DISCORD_BOT_TOURNAMENT_ANNOUNCE_ENABLED` — verrou ENTIÈREMENT SÉPARÉ de
# celui des soirées (activer l'un n'active jamais l'autre). Voir le README
# pour la procédure d'activation progressive et de rollback. Non
# configurées par cette PR.
DISCORD_BOT_GUILD_ID=
DISCORD_BOT_SESSION_CHANNEL_ID=
DISCORD_BOT_SESSION_ANNOUNCE_ENABLED=
DISCORD_BOT_TOURNAMENT_CHANNEL_ID=
DISCORD_BOT_TOURNAMENT_ANNOUNCE_ENABLED=

# Nettoyage automatique des fils Discord (soirées/tournois terminés) — route
# `/api/cron/discord-thread-cleanup`, voir README, section "Nettoyage
# automatique des fils Discord". Désactivée tant que ENABLED n'est pas
# exactement `true` ; en dry-run (rapport seul) tant que MODE n'est pas
# exactement `execute`. Nécessite la permission Discord MANAGE_THREADS.
DISCORD_THREAD_CLEANUP_ENABLED=
DISCORD_THREAD_CLEANUP_MODE=
# Archive le fil dès la fin de la soirée (au lieu du cron suivant) ; exige
# aussi le nettoyage ci-dessus en `execute`. Actif uniquement si `true`.
DISCORD_THREAD_CLOSE_ON_END_ENABLED=

# MP des soirées (V2) — annonce, changement de date, « Soirée validée » et
# rappels d'une soirée bot envoyés AUSSI en MP à chaque pote concerné (double
# ping : sa mention dans le fil est conservée). Une modification ou la fin de
# la soirée ÉDITE le MP d'invitation, sans nouvelle notification. Le créateur
# reçoit les MP mais n'est pas mentionné dans le fil (sauf mention de secours
# si son MP est fermé). Désactivé tant que la valeur n'est pas exactement
# `true`. Sans effet si le chemin bot des soirées
# (DISCORD_BOT_SESSION_ANNOUNCE_ENABLED) n'est pas actif.
DISCORD_DM_SESSION_ENABLED=

# MP des tournois et de la roulette (V2) — éteints tant que la valeur n'est
# pas exactement `true`, indépendants l'un de l'autre et de
# DISCORD_DM_SESSION_ENABLED. Voir README, section "MP des tournois et de la
# roulette". Le cron `notification-executor` doit tourner.
DISCORD_DM_TOURNAMENT_ENABLED=
DISCORD_DM_ROULETTE_ENABLED=

# « Jouer maintenant » (V2) — invitation rapide envoyée en MP aux potes
# invités. Aucun salon requis (un MP ne cible jamais un salon) ;
# DISCORD_BOT_TOKEN reste nécessaire. Désactivé tant que la valeur n'est pas
# exactement `true`. Le cron `notification-executor` doit tourner.
DISCORD_BOT_INSTANT_SESSION_INVITE_ENABLED=

# Multi-communautés — création automatique d'une communauté (statut PENDING,
# jamais ACTIVE : un admin l'active) quand le bot est ajouté à un serveur.
# Deux chemins : le webhook d'événements Discord `APPLICATION_AUTHORIZED`
# (Developer Portal → Webhooks → URL `/api/discord/webhook-events`) et le cron
# `/api/cron/community-guild-sync` (rattrapage + détection du départ du bot).
# `DISCORD_APP_PUBLIC_KEY` : clé publique de l'application (Developer Portal →
# General Information → Public Key), sert à vérifier la signature Ed25519 du
# webhook (503 si absente, 401 si invalide). Désactivé tant que
# `COMMUNITY_AUTO_CREATE_ENABLED` n'est pas exactement `true`.
DISCORD_APP_PUBLIC_KEY=
COMMUNITY_AUTO_CREATE_ENABLED=

# Multi-communautés — commande Discord `/gamenight setup` (PR6) : un membre avec
# la permission « Gérer le serveur » active lui-même la communauté de son serveur
# (aucune validation manuelle). Endpoint `/api/discord/interactions` à renseigner
# au portail (General Information → Interactions Endpoint URL) ; exige
# `DISCORD_APP_PUBLIC_KEY` (503 sans clé, 401 si signature invalide). Le PING de
# validation de l'URL est toujours acquitté. Désactivé tant que la valeur n'est
# pas exactement `true` (la commande répond alors « pas activée »). La commande
# s'enregistre une fois : `node scripts/register-discord-commands.mjs --execute`.
COMMUNITY_SETUP_COMMAND_ENABLED=

# Multi-communautés — salons d'annonce PAR communauté (table
# CommunityChannelConfig : un salon SESSION et un salon TOURNAMENT par
# communauté ACTIVE, serveur = Community.discordGuildId). Désactivé tant que la
# valeur n'est pas exactement `true` : les soirées et tournois utilisent alors
# uniquement DISCORD_BOT_GUILD_ID / DISCORD_BOT_*_CHANNEL_ID, comme avant.
# Activé : la communauté `default` retombe sur ces variables si elle n'a pas de
# salon configuré ; toute AUTRE communauté sans salon configuré n'annonce rien
# (jamais de repli vers le salon d'une autre communauté).
COMMUNITY_CHANNELS_ENABLED=

# Multi-communautés — ISOLATION des données par communauté : un utilisateur ne
# voit que les soirées, tournois, potes et classements des communautés ACTIVE où
# il a un Membership ACTIVE (communityId null = communauté `default`). Désactivé
# tant que la valeur n'est pas exactement `true` : aucun filtre, comportement
# actuel. NE PAS ACTIVER tant que la liste « non couvert » du README (section
# PR4) n'est pas traitée, et seulement après un passage de
# /api/backfill/seed-reconcile (sans Membership, plus rien n'est visible).
COMMUNITY_ISOLATION_ENABLED=

# Multi-communautés — SÉLECTEUR de serveur (/serveurs) : un utilisateur membre
# de plusieurs serveurs choisit celui que GameNight affiche (User.activeCommunityId,
# migration add_user_active_community — à appliquer AVANT d'allumer). Désactivé
# tant que la valeur n'est pas exactement `true` : /serveurs répond 404, aucune
# redirection, comportement actuel. Allumé : 0 serveur = message, 1 serveur =
# redirection, plusieurs = choix, imposé sur l'accueil, /sessions, /tournois et
# /classement. Le choix est une préférence revalidée contre les Membership
# ACTIFS à chaque usage, jamais une autorisation.
COMMUNITY_PICKER_ENABLED=

# Multi-communautés — ADMINISTRATION (onglet « Communautés » de /admin) : lister les
# communautés, passer une communauté PENDING en ACTIVE et choisir ses salons
# SESSION / TOURNAMENT (vérifiés auprès de Discord : le salon doit appartenir au
# serveur de la communauté). Réservé aux admins. Désactivé tant que la valeur
# n'est pas exactement `true` : onglet absent, actions sans effet, aucune lecture.
# Aucune migration. Les salons enregistrés ne servent qu'avec COMMUNITY_CHANNELS_ENABLED.
COMMUNITY_ADMIN_ENABLED=

# Sondages éclair par serveur, résultats agrégés ; migration community_quick_polls requise, OFF par défaut.
COMMUNITY_QUICK_POLLS_ENABLED=
# Cimetière des jeux par serveur, sans retrait des bibliothèques ; migration community_game_epitaphs requise, OFF par défaut.
COMMUNITY_GAME_GRAVEYARD_ENABLED=
# Expressions et running gags par serveur ; OFF par défaut. Migration community_expressions requise.
COMMUNITY_EXPRESSIONS_ENABLED=

# Rétention / purge des données anciennes — route `/api/cron/retention-cleanup`
# (voir README, section "Activation du nettoyage"). Désactivée tant que
# ENABLED n'est pas exactement `true`. MODE vaut `dry_run` par défaut (rapport
# seul, aucune écriture) ; seule la valeur exacte `execute` déclenche de vraies
# suppressions. Aucun job cron-job.org n'est configuré à ce jour.
RETENTION_CLEANUP_ENABLED=
RETENTION_CLEANUP_MODE=

# Titres d'onglet par page (« Calendrier · GameNight »…) — voir README, section
# « Titres de page ». Désactivé tant que la valeur n'est pas exactement `true`.
# Un changement demande un redéploiement (lu au build pour les pages statiques).
PAGE_TITLES_ENABLED=

# Collecte des violations CSP — voir README, section « Collecte des violations
# CSP ». Désactivé tant que la valeur n'est pas exactement `true` ; activé, ajoute
# `report-uri /api/csp-report` à la CSP (en-têtes calculés au build : redéployer).
CSP_REPORT_ENABLED=

# Titres d'onglet dynamiques (nom du jeu, du pote) — voir README, section
# « Titres de page ». Exige aussi PAGE_TITLES_ENABLED. Désactivé tant que la
# valeur n'est pas exactement `true`.
PAGE_TITLES_DYNAMIC_ENABLED=

# Guide (/guide) : sections « Jouer maintenant » et « Tournois ». Désactivé tant que
# la valeur n'est pas exactement `true` (lu à chaque requête).
GUIDE_V2_ENABLED=

# Tournois : saisie facultative des scores des matchs (affichés dans le bracket seulement).
# Désactivé tant que la valeur n'est pas exactement `true`. Exige la migration tournament_match_scores.
TOURNAMENT_SCORES_ENABLED=

# Veto au vote de jeu : 1 veto par personne et par soirée, un jeu vetoé ne peut pas être retenu
# ni tiré. Désactivé tant que la valeur n'est pas exactement `true`. S'applique aussi au jeu tiré par la roulette asynchrone. Exige les migrations add_session_veto et add_roulette_veto.
VOTE_VETO_ENABLED=

# Roulette : filtre « nombre de joueurs » (tirage asynchrone et roulette instantanée). Ne garde que les jeux
# qui acceptent le nombre de joueurs inscrits ; repli sur tous les jeux si aucun ne convient. Allume aussi, sur la
# roulette instantanée, « Relancer » sans doublon et « Recommencer ». Désactivé
# tant que la valeur n'est pas exactement `true`. Sans migration.
ROULETTE_PLAYER_FILTER_ENABLED=

# Accueil v2 (/accueil-v2) — mêmes données que l'accueil, hiérarchie revue — voir
# README, section « Accueil v2 ». Désactivé (404) tant que la valeur n'est pas
# exactement `true` (lu à chaque requête).
HOME_V2_ENABLED=

# Indicateur « 🟢 En jeu » sur /potes — voir README, section « Indicateur « En
# jeu » ». Exige la migration `steam_now_playing` (déjà appliquée au build).
# Désactivé tant que la valeur n'est pas exactement `true` : sans lui, aucun
# appel Steam de plus et aucune écriture.
STEAM_NOW_PLAYING_ENABLED=

# Lien d'évitement « Aller au contenu » (accessibilité clavier) — voir README,
# section « Lien d'évitement ». Désactivé tant que la valeur n'est pas
# exactement `true` (lu à chaque requête).
SKIP_LINK_ENABLED=

# Checklist des participants des soirées prévues ; activer après migration session_preparation.
SESSION_PREPARATION_ENABLED=

# Durée estimée de préparation sur les fiches jeu ; OFF par défaut.
GAME_PREPARATION_TIME_ENABLED=

# Chroniques privées des soirées terminées
SESSION_CHRONICLES_ENABLED=

# Pronostics tournoi (sans mise ni gain XP)
TOURNAMENT_PREDICTIONS_ENABLED=
# Musée communautaire, après migration community_highlights ; OFF par défaut.
COMMUNITY_HIGHLIGHTS_ENABLED=

# Web Push navigateur. Inactif tant que WEB_PUSH_ENABLED n'est pas exactement `true`
# et que les trois valeurs VAPID ne sont pas configurées. Aucun secret n'est stocké ici.
WEB_PUSH_ENABLED=
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Abonnement iCal privé et révocable, après migration calendar_feed_tokens. OFF par défaut.
CALENDAR_SUBSCRIPTIONS_ENABLED=

# Annulation des occurrences futures des nouvelles séries récurrentes. OFF par défaut.
# Exige la migration recurring_session_cancellation; anciennes séries indépendantes conservées.
SESSION_SERIES_CANCEL_ENABLED=

# Offres de jeux gratuits automatiques depuis GamerPower, avec attribution.
# OFF par défaut; seule la valeur exacte `true` active le flux. Le réglage
# communautaire freeGamesEnabled doit aussi être activé. Les offres restent
# à vérifier sur la boutique pour les conditions et la disponibilité régionale.
FREE_GAME_FEED_ENABLED=
