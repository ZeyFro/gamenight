# Base de données (Neon)
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Discord (Developer Portal → New Application → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Webhook du salon où poster les résultats/rappels (Salon → Intégrations → Webhooks)
DISCORD_WEBHOOK_URL=

# Optionnel : jeton du BOT de l'application (Developer Portal → ton appli →
# Bot → Reset Token), invité sur le serveur Discord du groupe. Utilisé
# UNIQUEMENT par /api/cron/refresh-discord-profiles, en REPLI pour les users
# qui n'ont pas encore de jeton OAuth personnel enregistré en base (voir
# README, section F1 bis) — le mécanisme principal du cron réutilise/rafraîchit
# désormais le jeton OAuth propre à chaque user (persisté en base à chaque
# connexion, sans dépendre de ce jeton bot ni du réseau d'amis Discord du
# bot). Sans cette variable, seul le repli est désactivé, le cron continue de
# fonctionner pour tous les users déjà passés par une reconnexion.
DISCORD_BOT_TOKEN=

# Steam (https://steamcommunity.com/dev/apikey — compte avec ≥5$ dépensés requis)
STEAM_API_KEY=

# IGDB (compte Twitch dev → https://dev.twitch.tv/console → application)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optionnel : traduction FR des descriptions IGDB (anglais uniquement) sur
# la fiche jeu. Compte gratuit sur https://www.deepl.com/pro-api (plan
# Free, 500k caractères/mois) → clé dans le compte, onglet API. Sans
# cette variable, la fiche jeu affiche la description originale en
# anglais (pas de traduction, pas d'erreur).
DEEPL_API_KEY=

# Optionnel : upload de bannière de profil (URL reste utilisable sans ça).
# Vercel Blob, plan Hobby → 5 Go gratuits. Vercel → onglet Storage → Create
# Database → Blob → Create Store, puis onglet ".env.local" du store créé
# pour copier le token (ou `vercel env pull` si le projet est lié en CLI).
# Sans cette variable, l'onglet "Uploader une image" de /profil/parametres
# affiche "Fonctionnalité désactivée" au lieu de planter.
BLOB_READ_WRITE_TOKEN=

# Optionnel (recommandée en prod) : protège /api/cron/reminders contre un
# déclenchement par un tiers qui devinerait l'URL. Le plan Vercel Hobby
# n'autorisant pas un cron à 15 min, F7 est déclenchée par un cron externe
# (ex. cron-job.org) — configure-le pour envoyer l'en-tête
# `Authorization: Bearer <CRON_SECRET>` (voir README, section F7).
# ATTENTION (PR "Accès & secrets") : les routes /api/cron/* et
# /api/backfill/* sont maintenant fail-closed — si cette variable est
# absente, elles répondent 503 (désactivées) au lieu de s'exécuter sans
# authentification.
CRON_SECRET=

# Chiffrement au repos des jetons OAuth Discord stockés en base
# (User.discordAccessToken/discordRefreshToken) — AES-256-GCM. Clé DÉDIÉE,
# distincte de AUTH_SECRET/CRON_SECRET/DATABASE_URL. Générer avec :
#   openssl rand -base64 32
# À CONFIGURER SUR VERCEL (Production ET Preview) AVANT de déployer le code
# qui l'utilise. Sans cette variable, les nouveaux jetons ne sont plus
# persistés en base (jamais en clair) — la connexion reste fonctionnelle,
# seul le rafraîchissement auto d'avatar/pseudo par cron en pâtit pour
# l'utilisateur concerné (repli automatique sur le jeton du bot si
# DISCORD_BOT_TOKEN est configuré). Voir README, section "Chiffrement des
# jetons OAuth Discord", pour le détail (rollout, perte/rotation de clé).
DISCORD_TOKEN_ENCRYPTION_KEY=

# Requise pour avoir au moins un admin dès le premier déploiement (PR
# "Accès & secrets") : liste de discordId (le snowflake Discord, PAS le
# pseudo — mode développeur Discord → clic droit sur ton profil → "Copier
# l'ID utilisateur"), séparés par des virgules si plusieurs. Un discordId
# listé ici est TOUJOURS traité comme admin de /admin, même si sa colonne
# `role` en base dit `USER` (filet anti-verrouillage). Voir README pour le
# détail.
ADMIN_DISCORD_IDS=
