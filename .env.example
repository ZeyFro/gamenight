# Panneau d'accueil The Tower : aucune publication automatique ; OFF par défaut.
TOWER_ONBOARDING_PANEL_ENABLED=
TOWER_DISCORD_WELCOME_CHANNEL_ID=

# Base de données (Neon)
DATABASE_URL=
# Recette locale uniquement : PostgreSQL sur loopback, jamais une URL hébergée.
TEST_DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Discord (Developer Portal → New Application → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Facultatif, NON secret : lien d'invitation du serveur Discord The Tower
# (https://discord.gg/… ou https://discord.com/invite/…). Affiché sur l'écran
# « Connexion refusée » pour un compte qui n'est pas membre du serveur. Absent
# ou invalide : le message s'affiche sans lien.
DISCORD_INVITE_URL=
# Webhook du salon où poster les résultats/rappels (Salon → Intégrations → Webhooks)
DISCORD_WEBHOOK_URL=

# Optionnel : jeton du BOT de l'application (Developer Portal → ton appli →
# Bot → Reset Token), invité sur le serveur Discord du groupe. Utilisé
# UNIQUEMENT par /api/cron/refresh-discord-profiles, en REPLI pour les users
# qui n'ont pas encore de jeton OAuth personnel enregistré en base (voir
# docs/COMMUNITY_ROLLOUT.md) — le mécanisme principal du cron réutilise/rafraîchit
# désormais le jeton OAuth propre à chaque user (persisté en base à chaque
# connexion, sans dépendre de ce jeton bot ni du réseau d'amis Discord du
# bot). Sans cette variable, seul le repli est désactivé, le cron continue de
# fonctionner pour tous les users déjà passés par une reconnexion.
DISCORD_BOT_TOKEN=

# Voice presence worker: intentionally off unless the dedicated self-hosted
# service explicitly selects standalone mode and all decision gates are set.
VOICE_PRESENCE_ENABLED=
# Références de décision du propriétaire, format exact YYYYMMDD-identifiant (ex. 20261023-consentement-v1) : toute autre valeur refuse le démarrage.
VOICE_PRESENCE_CONSENT_DECISION=
VOICE_PRESENCE_RETENTION_DECISION=
VOICE_PRESENCE_POLL_INTERVAL_MS=
# Réservé au worker auto-hébergé : "standalone" (vide partout ailleurs, notamment Vercel).
VOICE_PRESENCE_WORKER_MODE=
# Délai maximal d'arrêt propre du worker en ms (1000-600000, défaut 40000).
VOICE_WORKER_SHUTDOWN_TIMEOUT_MS=

# Steam (https://steamcommunity.com/dev/apikey — compte avec ≥5$ dépensés requis)
STEAM_API_KEY=

# IGDB (compte Twitch dev → https://dev.twitch.tv/console → application)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optionnel : traduction FR des descriptions IGDB. Sans cette clé, la
# description originale en anglais reste affichée.
DEEPL_API_KEY=

# Optionnel : téléversement de bannière de profil via Vercel Blob.
# Sans le token, cette fonction reste désactivée.
BLOB_READ_WRITE_TOKEN=
# Jeton d'un store Vercel Blob PRIVATE dédié aux médias de soirée.
SESSION_MEDIA_BLOB_TOKEN=
# Clips MP4 dans la galerie privée; OFF tant que la valeur n'est pas exactement `true`.
SESSION_VIDEO_ENABLED=
# Rivalités entre équipes + « Jouer maintenant » Rejoindre/Intéressé avec expiration à 2 h. Migration
# 20261118130700_team_rivalries. OFF par défaut ; voir docs/RIVALITES_EQUIPES.md.
TEAM_RIVALRIES_ENABLED=
# Projets à organisateur (/projets) : entrées validées, date de fin, fils Discord public + privé via la file et
# l'executor, archivage 7 jours après clôture. Migration 20261118130600_project_entries. OFF par défaut ;
# voir docs/PROJETS_ORGANISATEUR.md.
PROJECT_ORGANIZER_ENABLED=
# Visibilité des soirées (publique / candidature / privée), coorganisateur, espace Discord temporaire (fil privé +
# vocal 30 min avant, supprimés vides après la fin, via la file et l'executor). Migration
# 20261118130300_session_visibility_waitlist. OFF par défaut ; voir docs/SOIREES_VISIBILITE.md.
SESSION_VISIBILITY_ENABLED=

# Secret requis pour appeler les routes /api/cron/* et /api/backfill/*.
# Sans lui, elles répondent 503. Les cadences se configurent hors dépôt ; voir docs/CRONS.md.
CRON_SECRET=

# Chiffrement au repos des jetons OAuth Discord stockés en base (AES-256-GCM).
# Clé dédiée, différente de AUTH_SECRET, CRON_SECRET et DATABASE_URL.
# Générer une valeur locale avec openssl rand -base64 32. Sans cette clé,
# les nouveaux jetons ne sont pas persistés (jamais enregistrés en clair).
DISCORD_TOKEN_ENCRYPTION_KEY=

# Liste facultative de discordId Discord séparés par des virgules. Les IDs
# listés sont admins de l’application, même si role vaut USER en base.
ADMIN_DISCORD_IDS=
# Exécuteur de notifications Discord, OFF par défaut. La livraison par bot
# exige aussi le flag d’annonce correspondant et une tâche externe.
# Routes et méthodes : docs/CRONS.md ; options : docs/COMMUNITY_ROLLOUT.md.
NOTIFICATION_EXECUTOR_ENABLED=

# Annonces bot pour soirées et tournois, OFF par défaut. Le serveur et les
# salons sont des IDs Discord ; chaque type d’annonce a son flag séparé.
# Détails d’activation et de retour arrière : docs/COMMUNITY_ROLLOUT.md.
DISCORD_BOT_GUILD_ID=
DISCORD_BOT_SESSION_CHANNEL_ID=
DISCORD_BOT_SESSION_ANNOUNCE_ENABLED=
DISCORD_BOT_TOURNAMENT_CHANNEL_ID=
DISCORD_BOT_TOURNAMENT_ANNOUNCE_ENABLED=

# Nettoyage automatique des fils Discord (soirées/tournois terminés) — route
# `/api/cron/discord-thread-cleanup` (route, méthode et auth : docs/CRONS.md). Désactivée tant que ENABLED n'est pas
# exactement `true` ; en dry-run (rapport seul) tant que MODE n'est pas
# exactement `execute`. Nécessite la permission Discord MANAGE_THREADS.
DISCORD_THREAD_CLEANUP_ENABLED=
DISCORD_THREAD_CLEANUP_MODE=
# Archive le fil dès la fin de la soirée (au lieu du cron suivant) ; exige
# aussi le nettoyage ci-dessus en `execute`. Actif uniquement si `true`.
DISCORD_THREAD_CLOSE_ON_END_ENABLED=

# MP des soirées (V2) — annonce, changement de date, « Soirée validée » et
# rappels d'une soirée bot envoyés AUSSI en MP à chaque pote concerné (double
# ping : sa mention dans le fil est conservée). Une modification ou la fin de
# la soirée ÉDITE le MP d'invitation, sans nouvelle notification. Le créateur
# reçoit les MP mais n'est pas mentionné dans le fil (sauf mention de secours
# si son MP est fermé). Désactivé tant que la valeur n'est pas exactement
# `true`. Sans effet si le chemin bot des soirées
# (DISCORD_BOT_SESSION_ANNOUNCE_ENABLED) n'est pas actif.
DISCORD_DM_SESSION_ENABLED=

# MP des tournois et de la roulette (V2) — éteints tant que la valeur n'est
# pas exactement `true`, indépendants l'un de l'autre et de
# DISCORD_DM_SESSION_ENABLED. Le cron externe `notification-executor` doit tourner ; route, méthode et auth : docs/CRONS.md.
DISCORD_DM_TOURNAMENT_ENABLED=
DISCORD_DM_ROULETTE_ENABLED=

# « Jouer maintenant » (V2) — invitation rapide envoyée en MP aux potes
# invités. Aucun salon requis (un MP ne cible jamais un salon) ;
# DISCORD_BOT_TOKEN reste nécessaire. Désactivé tant que la valeur n'est pas
# exactement `true`. Le cron `notification-executor` doit tourner.
DISCORD_BOT_INSTANT_SESSION_INVITE_ENABLED=

# Multi-communautés — création automatique d'une communauté (statut PENDING,
# jamais ACTIVE : un admin l'active) quand le bot est ajouté à un serveur.
# Deux chemins : le webhook d'événements Discord `APPLICATION_AUTHORIZED`
# (Developer Portal → Webhooks → URL `/api/discord/webhook-events`) et le cron
# `/api/cron/community-guild-sync` (rattrapage + détection du départ du bot).
# `DISCORD_APP_PUBLIC_KEY` : clé publique de l'application (Developer Portal →
# General Information → Public Key), sert à vérifier la signature Ed25519 du
# webhook (503 si absente, 401 si invalide). Désactivé tant que
# `COMMUNITY_AUTO_CREATE_ENABLED` n'est pas exactement `true`.
DISCORD_APP_PUBLIC_KEY=
COMMUNITY_AUTO_CREATE_ENABLED=

# Multi-communautés — commande Discord /gamenight setup :
# la permission « Gérer le serveur » active lui-même la communauté de son serveur
# (aucune validation manuelle). Endpoint `/api/discord/interactions` à renseigner
# au portail (General Information → Interactions Endpoint URL) ; exige
# `DISCORD_APP_PUBLIC_KEY` (503 sans clé, 401 si signature invalide). Le PING de
# validation de l'URL est toujours acquitté. Désactivé tant que la valeur n'est
# pas exactement `true` (la commande répond alors « pas activée »). La commande
# s'enregistre une fois : `node scripts/register-discord-commands.mjs --execute`.
COMMUNITY_SETUP_COMMAND_ENABLED=

# Multi-communautés — salons d'annonce PAR communauté (table
# CommunityChannelConfig : un salon SESSION et un salon TOURNAMENT par
# communauté ACTIVE, serveur = Community.discordGuildId). Désactivé tant que la
# valeur n'est pas exactement `true` : les soirées et tournois utilisent alors
# uniquement DISCORD_BOT_GUILD_ID / DISCORD_BOT_*_CHANNEL_ID, comme avant.
# Activé : la communauté `default` retombe sur ces variables si elle n'a pas de
# salon configuré ; toute AUTRE communauté sans salon configuré n'annonce rien
# (jamais de repli vers le salon d'une autre communauté).
COMMUNITY_CHANNELS_ENABLED=

# Multi-communautés — filtres communautaires étendus pour les sessions, tournois,
# joueurs et classements. La garde de Membership sur les données collectives,
# y compris default lorsque ce flag est OFF, a été corrigée dans la PR #309.
# Suivre docs/COMMUNITY_ROLLOUT.md et docs/SECURITE_CLAUDE.md avant activation.
COMMUNITY_ISOLATION_ENABLED=

# Multi-communautés — SÉLECTEUR de serveur (/serveurs) : un utilisateur membre
# de plusieurs serveurs choisit celui que GameNight affiche (User.activeCommunityId,
# migration add_user_active_community — à appliquer AVANT d'allumer). Désactivé
# tant que la valeur n'est pas exactement `true` : /serveurs répond 404, aucune
# redirection, comportement actuel. Allumé : 0 serveur = message, 1 serveur =
# redirection, plusieurs = choix, imposé sur l'accueil, /sessions, /tournois et
# /classement. Le choix est une préférence revalidée contre les Membership
# ACTIFS à chaque usage, jamais une autorisation.
COMMUNITY_PICKER_ENABLED=

# Multi-communautés — ADMINISTRATION (onglet « Communautés » de /admin) : lister les
# communautés, passer une communauté PENDING en ACTIVE et choisir ses salons
# SESSION / TOURNAMENT (vérifiés auprès de Discord : le salon doit appartenir au
# serveur de la communauté). Réservé aux admins. Désactivé tant que la valeur
# n'est pas exactement `true` : onglet absent, actions sans effet, aucune lecture.
# Aucune migration. Les salons enregistrés ne servent qu'avec COMMUNITY_CHANNELS_ENABLED.
COMMUNITY_ADMIN_ENABLED=

# Sondages éclair par serveur, résultats agrégés ; migration community_quick_polls requise, OFF par défaut.
COMMUNITY_QUICK_POLLS_ENABLED=
# Cimetière des jeux par serveur, sans retrait des bibliothèques ; migration community_game_epitaphs requise, OFF par défaut.
COMMUNITY_GAME_GRAVEYARD_ENABLED=
# Expressions et running gags par serveur ; OFF par défaut. Migration community_expressions requise.
COMMUNITY_EXPRESSIONS_ENABLED=

# Rétention / purge via /api/cron/retention-cleanup, OFF par défaut.
# MODE=dry_run ne supprime rien ; seul execute lance les suppressions.
# Les cadences des tâches sont configurées hors dépôt : docs/CRONS.md.
RETENTION_CLEANUP_ENABLED=
RETENTION_CLEANUP_MODE=

# Titres d’onglet par page. Désactivés tant que PAGE_TITLES_ENABLED n’est pas true.
# Les pages statiques nécessitent une recompilation après changement.
PAGE_TITLES_ENABLED=

# Collecte CSP derrière /api/csp-report ; voir docs/SECURITE_CLAUDE.md.
# OFF par défaut ; l’en-tête CSP change au prochain build après activation.
CSP_REPORT_ENABLED=

# Titres d’onglet dynamiques selon le jeu ou le joueur ; exige aussi
# PAGE_TITLES_ENABLED et reste OFF tant que cette valeur n’est pas true.
PAGE_TITLES_DYNAMIC_ENABLED=

# Guide (/guide) : sections « Jouer maintenant » et « Tournois ». Désactivé tant que
# la valeur n'est pas exactement `true` (lu à chaque requête).
GUIDE_V2_ENABLED=

# Tournois : saisie facultative des scores des matchs (affichés dans le bracket seulement).
# Désactivé tant que la valeur n'est pas exactement `true`. Exige la migration tournament_match_scores.
TOURNAMENT_SCORES_ENABLED=

# Veto au vote de jeu : 1 veto par personne et par soirée, un jeu vetoé ne peut pas être retenu
# ni tiré. Désactivé tant que la valeur n'est pas exactement `true`. S'applique aussi au jeu tiré par la roulette asynchrone. Exige les migrations add_session_veto et add_roulette_veto.
VOTE_VETO_ENABLED=

# Roulette : filtre « nombre de joueurs » (tirage asynchrone et roulette instantanée). Ne garde que les jeux
# qui acceptent le nombre de joueurs inscrits ; repli sur tous les jeux si aucun ne convient. Allume aussi, sur la
# roulette instantanée, « Relancer » sans doublon et « Recommencer ». Désactivé
# tant que la valeur n'est pas exactement `true`. Sans migration.
ROULETTE_PLAYER_FILTER_ENABLED=

# Variante d’accueil /accueil-v2 ; OFF par défaut et route 404 sans activation.
HOME_V2_ENABLED=

# Indicateur Steam « En jeu » sur /potes ; nécessite la migration
# steam_now_playing sur la base cible et reste OFF par défaut.
STEAM_NOW_PLAYING_ENABLED=

# Lien d’évitement clavier « Aller au contenu » ; OFF par défaut.
SKIP_LINK_ENABLED=

# Textes d’ouverture (V3-02, V3-12, V3-18) : phrase « accès réservé » et lien d’invitation (DISCORD_INVITE_URL) sur la
# page de connexion, phrase sur les étages Tower (/tower, /ascension), blocs techniques de /sessions/[id] masqués quand la
# fonction est éteinte ou non configurée. Sans migration ; OFF par défaut (valeur exacte `true`), éteint = rendu identique.
LAUNCH_TEXTS_ENABLED=

# Lien « The Tower » dans la barre latérale et le menu mobile (V3-15) ; barre basse inchangée. Sans migration ; OFF par défaut.
NAV_TOWER_ENABLED=
# Vie privée des médias ; OFF par défaut (valeur exacte true). Fiche jeu : la vidéo YouTube ne se charge
# qu'après un clic ; galerie des soirées : case obligatoire d'accord des personnes reconnaissables ou audibles.
# Sans migration (docs/SOIREE_ACTIVATION.md § 9 quater).
MEDIA_PRIVACY_ENABLED=

# Suppression de compte (anonymisation) et export des données personnelles, /profil/compte ; OFF par défaut (404 côté serveur).
# Activer seulement après la migration account_deletion_log (docs/SUPPRESSION_COMPTE.md). Aucun appel Discord.
ACCOUNT_DELETION_ENABLED=

# Checklist des participants des soirées prévues ; activer après migration session_preparation.
SESSION_PREPARATION_ENABLED=

# Durée estimée de préparation sur les fiches jeu ; OFF par défaut.
GAME_PREPARATION_TIME_ENABLED=

# Chroniques privées des soirées terminées
SESSION_CHRONICLES_ENABLED=

# Pronostics tournoi (sans mise ni gain XP)
TOURNAMENT_PREDICTIONS_ENABLED=
# Musée communautaire, après migration community_highlights ; OFF par défaut.
COMMUNITY_HIGHLIGHTS_ENABLED=
# Visibilité du profil (masquer son profil dans Potes), après migration profile_visibility ; OFF par défaut.
PROFILE_VISIBILITY_ENABLED=
# Personnalisation du profil (pseudo, cartes, cadres, bannières, effets, titre, vitrine de badges), après migration profile_customization ; OFF par défaut. Décoratif uniquement.
PROFILE_CUSTOMIZATION_ENABLED=
# Candidatures d'équipe (/equipes/candidatures), après migration team_applications ; OFF par défaut, exige aussi communityTeamsEnabled.
TEAM_APPLICATIONS_ENABLED=
# Recruteurs d'équipe (2 au plus, MP seulement au capitaine et à eux), relance à 48 h, expiration à 7 jours, invités de tournoi,
# après migration team_recruiters_guest ; OFF par défaut, exige TEAM_APPLICATIONS_ENABLED (MP : aussi NOTIFICATION_EXECUTOR_ENABLED et le jeton du bot).
TEAM_RECRUITERS_ENABLED=
# Niveaux de jeu auto-déclarés par jeu (profil), après migration user_game_levels ; OFF par défaut.
GAME_LEVELS_ENABLED=
# Niveau par jeu dans le matchmaking et l'équilibrage de tournoi ; OFF par défaut, exige aussi GAME_LEVELS_ENABLED ; sans migration.
GAME_LEVELS_MATCHMAKING_ENABLED=


# Objectifs et critères de recrutement d'équipe, après migration team_recruitment_criteria ; OFF par défaut, exige aussi communityTeamsEnabled.
TEAM_RECRUITMENT_CRITERIA_ENABLED=
# Titres et cadres cosmétiques saisonniers attribués automatiquement aux 3 premiers du palmarès (cron notification-executor), après migration tower_season_awards ; OFF par défaut, exige aussi TOWER_CHALLENGES_ENABLED.
TOWER_SEASON_AWARDS_ENABLED=
# Propositions de défis par les Ranker/High Ranker, validées par le staff (/tower/propositions, /admin/tower-propositions), après migration tower_rank_challenge_proposals ; OFF par défaut, exige aussi TOWER_CHALLENGES_ENABLED.
TOWER_CHALLENGE_PROPOSALS_ENABLED=
# Remplacement d'un défi solo dont le jeu n'est pas possédé (/tower), après migration tower_challenge_replacement ; OFF par défaut, exige aussi TOWER_CHALLENGES_ENABLED.
TOWER_CHALLENGE_REPLACEMENT_ENABLED=
# Irregular The Tower attribué à la main par le staff (/admin/tower-irregular), après migration tower_irregular_grants ; OFF par défaut, exige aussi TOWER_CHALLENGES_ENABLED.
TOWER_IRREGULAR_GRANTS_ENABLED=

# Web Push navigateur. Inactif tant que WEB_PUSH_ENABLED n'est pas exactement `true`
# et que les trois valeurs VAPID ne sont pas configurées. Aucun secret n'est stocké ici.
# Si WEB_PUSH_ENABLED=true, le sujet doit être mailto: ou https:// et la paire VAPID valide (voir docs/LIVRAISON-PUSH-CALENDRIER.md) ;
# sinon aucun envoi et un avertissement `web-push` nomme les variables fautives (jamais leurs valeurs).
WEB_PUSH_ENABLED=
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Abonnement iCal privé et révocable, après migration calendar_feed_tokens. OFF par défaut.
CALENDAR_SUBSCRIPTIONS_ENABLED=

# Page /ce-soir « Qui joue ce soir ? » : dispo en un clic (1 à 3 jeux, jusqu’à 4 h), joueurs dispo,
# parties en cours et soirées visibles de ce soir. Sans migration (petites annonces existantes) ;
# exige aussi playerClassifiedsEnabled sur la communauté. Aucune notification. OFF par défaut.
WHO_PLAYS_TONIGHT_ENABLED=

# Annulation des occurrences futures des nouvelles séries récurrentes. OFF par défaut.
# Exige la migration recurring_session_cancellation; anciennes séries indépendantes conservées.
SESSION_SERIES_CANCEL_ENABLED=

# Offres de jeux gratuits automatiques depuis GamerPower, avec attribution.
# OFF par défaut; seule la valeur exacte `true` active le flux. Le réglage
# communautaire freeGamesEnabled doit aussi être activé. Les offres restent
# à vérifier sur la boutique pour les conditions et la disponibilité régionale.
FREE_GAME_FEED_ENABLED=

# Annonces Discord automatiques des offres GamerPower : à activer seulement
# après configuration d'un salon FREE_GAMES par communauté et des permissions
# du bot. Il faut aussi NOTIFICATION_EXECUTOR_ENABLED et COMMUNITY_CHANNELS_ENABLED.
DISCORD_BOT_FREE_GAME_ANNOUNCE_ENABLED=

# /role : attribution libre-service des rôles de jeu Discord (aucune migration).
# Rien ne part vers Discord avant `DISCORD_ROLE_COMMAND_ENABLED=true`.
# DISCORD_ROLE_SELF_CREATION_ENABLED : OFF par défaut (absent, vide ou autre que `true`
# = fermé). Exactement `true` autorise /role à CRÉER, en direct, un rôle de jeu absent
# pour tout joueur (rôle toujours créé sans permission, borné par un quota par joueur et
# par DISCORD_ROLE_MAX_GUILD_ROLES). Fermé, /role n'attribue que les rôles existants.
# DISCORD_ROLE_AUTOCREATE_ENABLED ouvre aussi la création, mais par la file et l'executor.
# DISCORD_ROLE_MAX_GUILD_ROLES : plafond de rôles du serveur au-delà duquel
# /role refuse toute création (défaut 200).
DISCORD_ROLE_COMMAND_ENABLED=
DISCORD_ROLE_SELF_CREATION_ENABLED=
DISCORD_ROLE_MAX_GUILD_ROLES=
# Soutiens Nitro (lot 3, sujet M), STRICTEMENT COSMÉTIQUE : le cron /api/cron/booster-sync (CRON_SECRET, cadence externe,
# aucun cron créé) lit premium_since en REST (sans gateway) ; rôle « Soutien de la Tour » sans permission, retiré
# automatiquement à la fin du boost, salons écrit + vocal réservés, Mur des soutiens (/soutiens), badge de profil.
# Écritures Discord uniquement par la file et l'executor (exige NOTIFICATION_EXECUTOR_ENABLED et le bot).
# Migration 20261118131200_booster_support. OFF par défaut.
DISCORD_BOOSTERS_ENABLED=
# Commande contextuelle « Signaler » (message, type 3) : ticket privé dans le salon staff, AUCUNE sanction automatique.
# Ticket posté par la file et l'executor (exige NOTIFICATION_EXECUTOR_ENABLED et le bot) dans le salon staff PRIVÉ
# DISCORD_REPORT_STAFF_CHANNEL_ID ; sans ce salon le signalement reste enregistré (visible dans /admin). Migration
# 20261118131100_moderation_reports. Commande à enregistrer à la main (scripts/discord-commands.json). OFF par défaut.
DISCORD_REPORT_COMMAND_ENABLED=
DISCORD_REPORT_STAFF_CHANNEL_ID=
# Création AUTOMATIQUE de rôle de jeu par /role (lot 3, sujet F) : demande enregistrée puis exécutée par la file
# et l'executor (rôle SANS permission, attribué au demandeur), 1 création par joueur et par semaine, plafond
# DISCORD_ROLE_MAX_GUILD_ROLES (défaut 200, jamais plus de 250), alerte staff dès 80 % de 250 rôles.
# Exige DISCORD_ROLE_COMMAND_ENABLED, NOTIFICATION_EXECUTOR_ENABLED et le bot. Migration
# 20261118130500_discord_role_requests. OFF par défaut ; supprimer d'abord les rôles « Étage » (docs/DISCORD_ROLE_AUTOCREATE.md).
DISCORD_ROLE_AUTOCREATE_ENABLED=
# Tableau de bord staff v2 (lot 3, sujet O) : /admin/tableau-de-bord, LECTURE SEULE, admins uniquement, sans migration :
# candidatures en attente, opérations Discord échouées, espaces d'équipe archivés, contestations ouvertes, rôles et
# salons contre les limites Discord (250 / 500). Éteint = 404. OFF par défaut.
ADMIN_DASHBOARD_V2_ENABLED=

# /profil : étage, niveau, badges et équipes du membre, en lecture seule et en
# privé. `/aide` reste toujours disponible (aucune donnée personnelle).
DISCORD_PROFILE_COMMAND_ENABLED=

# /boost : avantages Booster Discord, lus à la source (`premium_since`).
# Aucun droit d’administration, de modération, de vote ou multiplicateur d’étages.
DISCORD_BOOSTER_ENABLED=

# The Tower : aucun effet avant migration validée + activation de la communauté.
# Réutilise le bot et l'exécuteur de notifications existants ; aucun nouveau token.
TOWER_CHALLENGES_ENABLED=false
TOWER_DISCORD_ANNOUNCE_ENABLED=false
# Validation automatique des défis mesurables Steam (cron /api/cron/tower-steam-autovalidate) ; exige TOWER_DISCORD_ANNOUNCE_ENABLED et STEAM_API_KEY.
TOWER_STEAM_AUTOVALIDATE_ENABLED=
# Votes de preuves par boutons ✅/❌ : message public mis à jour + un fil par preuve ; exige TOWER_DISCORD_ANNOUNCE_ENABLED.
TOWER_DISCORD_VOTES_ENABLED=
TOWER_DISCORD_GUILD_ID=
TOWER_DISCORD_CHANNEL_ID=
TOWER_DISCORD_GENERAL_CHANNEL_ID=

# Préflight Tower : GET /api/admin/tower-preflight (admins seulement) liste en lecture seule
# les salons du serveur DISCORD_BOT_GUILD_ID. 404 tant que la valeur n'est pas exactement `true`.
TOWER_DISCORD_PREFLIGHT_ENABLED=

# /soiree — soirées GameNight (Session/SessionInvite existants) depuis Discord.
# Lecture seule : liste, voir. Écriture (création, inscription, désinscription) :
# interrupteur distinct, fermé par défaut. Aucune annonce Discord n'est envoyée.
DISCORD_SESSION_COMMAND_ENABLED=
DISCORD_SESSION_WRITE_ENABLED=

# /tournoi — lecture seule sur les tournois de la communauté (aucune écriture).
DISCORD_TOURNAMENT_COMMAND_ENABLED=

# /tournoi inscription|desinscription — écritures via les services du site
# (registerTournamentParticipant / unregisterTournamentParticipant).
DISCORD_TOURNAMENT_WRITE_ENABLED=

# /joueurs — annonces de la page /joueurs (PlayerClassified, 24 h).
DISCORD_PLAYER_COMMAND_ENABLED=
# Écritures : publier / retirer une annonce depuis Discord.
DISCORD_PLAYER_WRITE_ENABLED=

TOWER_TEAM_DAILY_ENABLED=

# /projet : façade sur les équipes (mêmes services que /equipe). Lecture, puis écritures (créer, rejoindre, quitter,
# recrutement, espace). Aucun enregistrement de commande automatique.
DISCORD_PROJECT_COMMAND_ENABLED=
DISCORD_PROJECT_WRITE_ENABLED=

# Espaces Discord d'équipe (option A du 18/11/2026) : salon textuel privé permanent + salon vocal privé
# permanent + rôle sans permission, uniquement par la file de notifications et l'executor (exige aussi
# NOTIFICATION_EXECUTOR_ENABLED et le bot). Migrations 20261118110000_discord_team_space puis
# 20261118110100_discord_team_space_voice. Ne jamais l'activer sur une Preview ni avant revue du propriétaire.
DISCORD_TEAM_SPACES_ENABLED=
# Quota produit d'espaces (donc de paires de salons) par communauté ; défaut 5, maximum 200. Les limites
# Discord réelles (500 salons et 250 rôles par serveur) restent vérifiées séparément par le planificateur.
DISCORD_TEAM_SPACES_MAX_PER_COMMUNITY=

# Passation du capitaine inactif 30 jours : OFF et simulation par défaut.
# Cron externe non configuré. Ne jamais exécuter sur une Preview.
TEAM_CAPTAIN_HANDOVER_ENABLED=
TEAM_CAPTAIN_HANDOVER_MODE=
# Tournois par équipes inscrites (public/privé, un tournoi par jeu, résultat confirmé par les deux capitaines), après migration tournament_teams ; OFF par défaut, exige communityTeamsEnabled (MP : aussi NOTIFICATION_EXECUTOR_ENABLED et le jeton du bot).
TOURNAMENT_TEAMS_ENABLED=

# Garde de build Production (scripts/assert-migrations-applied.mjs) : exactement `true` = le build
# échoue si une migration du commit n'est pas appliquée (l'ancien déploiement reste servi). Sinon mode
# rapport, jamais bloquant. À définir dans Vercel Production seulement, après lecture du rapport.
MIGRATION_GATE_ENFORCE=

# Rôle dédié de la garde de build (SELECT sur _prisma_migrations seulement). Vercel Production seulement ;
# à défaut la garde utilise DATABASE_URL. Ne jamais publier de valeur.
MIGRATION_GATE_DATABASE_URL=

# Console (sujet J) : scope OAuth `connections` optionnel (consentement explicite) pour suggérer les identifiants
# de plateformes ; plateformes/crossplay des jeux, ajout rapide par plateforme, défis jamais impossibles.
# OFF par défaut ; migration 20261118130900_platform_identities_crossplay.
DISCORD_CONNECTIONS_SCOPE_ENABLED=
GAME_PLATFORMS_ENABLED=
# Centre de notifications (sujet I) : /notifications, opt-in aux jeux suivis, MP réservés à ce qui vise le joueur,
# jamais @everyone. OFF par défaut ; migration 20261118130800_notification_center.
NOTIFICATION_CENTER_ENABLED=

# Pages légales publiques (/mentions-legales, /confidentialite, /conditions) et liens
# du pied de page ; OFF par défaut (404). Ne l'activer qu'après avoir renseigné les
# quatre variables ci-dessous (sinon « À COMPLÉTER » reste visible) et la relecture
# juridique. Aucune de ces valeurs n'est un secret.
LEGAL_PAGES_ENABLED=
# Éditeur : nom et coordonnées, ou association (texte libre).
LEGAL_PUBLISHER=
LEGAL_PUBLICATION_DIRECTOR=
# Adresse e-mail dédiée (droits RGPD, signalement de contenu illicite).
LEGAL_CONTACT_EMAIL=
# Âge minimum : 13, 15 ou 16.
LEGAL_MIN_AGE=

# Enregistrement des commandes Discord DEPUIS LE SERVEUR (route POST /api/admin/discord-commands) : le jeton du bot ne
# sort jamais de Vercel. OFF par défaut (valeur exacte `true`, sinon 404). Exige aussi le secret ci-dessous et un
# administrateur connecté. À allumer le temps de l'enregistrement, puis à retirer (docs/SOIREE_ACTIVATION.md § 9 sexies).
DISCORD_COMMAND_REGISTRATION_ENABLED=
# Secret dédié (jamais CRON_SECRET), envoyé en en-tête x-registration-secret. Longue valeur aléatoire ; à supprimer ensuite.
DISCORD_COMMAND_REGISTRATION_SECRET=
