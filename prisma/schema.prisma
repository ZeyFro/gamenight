// Schéma Prisma — GameNight
// Voir SPEC-gamenight.md §5 pour le modèle de données complet.
// F1 (Auth Discord) : User.
// F2/F3 (lien Steam, biblio, ajout manuel, enrichissement IGDB) : Game, UserGame.
// F4 (dispos récurrentes + exceptions) : WeeklyAvailability, AvailabilityOverride.
// F5 (proposition + vote de soirée) : Session, Proposal, Vote.
// Les autres modèles seront ajoutés au fil des features F6 à F8.

// Reçu d'une tentative utilisateur ; conservé même après purge de l'événement.
model CreationIntent {
  id         String   @id @default(cuid())
  actorId    String
  kind       String
  key        String
  resourceId String
  createdAt  DateTime @default(now())

  @@unique([actorId, kind, key])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// PR "Accès & secrets" — désigne les users autorisés sur /admin. `USER` par
// défaut pour tout compte (existant ou nouveau) : personne ne devient admin
// implicitement à cette migration. Filet anti-verrouillage indépendant de ce
// champ : `ADMIN_DISCORD_IDS` (env, voir src/lib/admin.ts) traite toujours un
// discordId listé comme admin même si `role` dit `USER` en base.
enum UserRole {
  USER
  ADMIN
}

enum FreeGameStore {
  STEAM
  EPIC
}

model User {
  quickPollsCreated CommunityQuickPoll[]
  quickPollVotes CommunityQuickPollVote[]
  gameEpitaphs CommunityGameEpitaph[]
  communityExpressions CommunityExpression[]
  communityHighlights CommunityHighlight[]
  availabilityPollsCreated SessionAvailabilityPoll[] @relation("AvailabilityPollCreator")
  communityDatesCreated CommunityDate[] @relation("CommunityDateCreator")
  communityBirthdays CommunityDate[] @relation("CommunityDateMember")
  availabilityPollParticipations SessionAvailabilityPollParticipant[]
  id                       String    @id @default(cuid())
  discordId                String    @unique
  discordName              String
  discordAvatar            String?
  // Fix bug remonté (cron avatars Discord silencieux) — cette app utilise
  // une session JWT sans base (`session: { strategy: "jwt" }` dans
  // auth.ts, pas d'adapter Prisma), donc PAS de table `Account` Auth.js
  // standard où piocher les jetons OAuth : contrairement à ce qu'on
  // pourrait attendre par défaut, `access_token`/`refresh_token` ne
  // vivaient jusqu'ici que dans le JWT chiffré de la session active de
  // CHAQUE user (`token.discordAccessToken`), jamais en base — donc
  // jamais accessibles depuis un cron qui tourne hors de toute session.
  // Ces 3 champs persistent maintenant les jetons OAuth Discord de
  // chaque user (posés à chaque vraie reconnexion, callback `jwt` dans
  // auth.ts) pour que le cron `refresh-discord-profiles` puisse les
  // réutiliser ET les rafraîchir lui-même (`POST /oauth2/token`,
  // `grant_type=refresh_token`) sans dépendre d'une session active.
  // Rollout : `null` pour tout user qui ne s'est pas reconnecté depuis ce
  // déploiement — se peuple progressivement à la prochaine vraie
  // reconnexion de chacun (pas à chaque chargement de page, le JWT
  // persiste jusqu'à 30 jours sans repasser par le provider).
  discordAccessToken       String?   @db.Text
  discordRefreshToken      String?   @db.Text
  discordTokenExpiresAt    DateTime?
  // Feature "forcer la reconnexion globale" (/admin, PR 75) — posé à la
  // même valeur sur TOUS les users par `triggerGlobalRelogin`
  // (`src/lib/force-relogin.ts`). Sessions JWT (pas de table `Session` en
  // base, cf. commentaire ci-dessus) : impossible de les révoquer une par
  // une côté serveur. À la place, chaque JWT porte son propre
  // `sessionCreatedAt` (posé une seule fois, à la connexion — voir
  // `auth.ts`) ; `getCurrentUser` traite la session comme déconnectée si
  // `forceReloginAt` est plus récent que `sessionCreatedAt` du token (ou si
  // le token n'a pas ce champ — cas de TOUTES les sessions actives avant ce
  // déploiement). Une vraie reconnexion repose un `sessionCreatedAt` frais,
  // qui repasse après `forceReloginAt` : pas de reboucle.
  forceReloginAt           DateTime?
  // PR 8/9 — bannière de profil personnalisable. URL absolue uniquement
  // (pas de stockage de fichier ni service d'upload tiers — décision
  // documentée dans le README : la complexité d'un vrai upload n'était
  // pas justifiée pour v1). `null` = bannière par défaut (dégradé violet
  // CSS, `.profile-banner-default`).
  bannerUrl                String?
  steamId64                String?   @unique
  // Identifiants déclaratifs facultatifs ; aucune liaison OAuth ni preuve de propriété.
  psnId                    String?   @db.VarChar(100)
  xboxGamertag             String?   @db.VarChar(100)
  switchFriendCode         String?   @db.VarChar(100)
  epicDisplayName          String?   @db.VarChar(100)
  battleTag                String?   @db.VarChar(100)
  steamPublic              Boolean   @default(false)
  preferredGameCategories  String[]  @default([])
  refusedGameCategories    String[]  @default([])
  gameRefusals             UserGameRefusal[]
  inputDevices             String[]  @default([])
  availablePlatforms       String[]  @default([])
  microphoneAvailable      Boolean?
  // Fix bug remonté (biblio Steam auto-sync) — posé par `importSteamLibrary`
  // à CHAQUE appel (lien initial, bouton "Réimporter", cron quotidien,
  // resync Family) : source de vérité unique pour "Dernière sync : il y a
  // Xj" sur /profil/parametres, plutôt que de la déduire indirectement de
  // `Game.createdAt`/`UserGame.createdAt` (imprécis : une sync sans aucun
  // nouveau jeu ne toucherait aucune de ces dates alors qu'une sync a bien
  // eu lieu).
  steamLastSyncAt          DateTime?
  // Fix (cron Steam surdimensionné) — `steamLastSyncAt` ci-dessus reste
  // EXCLUSIVEMENT réservé à une synchronisation COMPLÈTE de la
  // bibliothèque réussie (`importSteamLibrary`, écrit seulement après la
  // boucle d'upserts + badges + wishlist, jamais avant — un import
  // interrompu ne doit jamais se faire passer pour réussi). Ces deux
  // nouveaux champs sont distincts, pour ne jamais laisser croire que la
  // bibliothèque a été resynchronisée alors que seule l'activité a été
  // vérifiée, ni qu'une tentative a réussi alors qu'elle a seulement été
  // lancée.
  //
  // Posé par le cron LÉGER (`refreshSteamActivity`, toutes les ~2 min) —
  // pour TOUT compte effectivement atteint par ce passage, succès ou
  // erreur Steam confondus (seul un compte jamais atteint par le lot le
  // laisse intact) : distingue sans ambiguïté "jamais atteint" de "erreur
  // Steam sur ce compte".
  steamActivityCheckedAt   DateTime?
  // Posé par le cron d'import COMPLET (`steam-library-full-sync`), AVANT
  // chaque tentative, inconditionnellement — sert uniquement à
  // l'ordonnancement du round-robin (`orderBy` sur ce champ, pas sur
  // `steamLastSyncAt`) : si un compte échoue systématiquement pendant
  // l'import (bibliothèque trop volumineuse, panne persistante), il avance
  // quand même en fin de file à chaque tentative plutôt que de monopoliser
  // indéfiniment la première place.
  steamFullSyncAttemptedAt DateTime?
  // F7 : coupe les pings `@<@discordId>` dans les rappels Discord pour cet
  // utilisateur — le message est quand même posté dans le salon, il n'est
  // simplement pas mentionné.
  silenceReminders         Boolean   @default(false)
  createdAt                DateTime  @default(now())
  // PR "Accès & secrets" — voir l'enum `UserRole` ci-dessus pour le
  // mécanisme complet (filet anti-verrouillage `ADMIN_DISCORD_IDS`).
  role                     UserRole  @default(USER)

  // PR 4/4 (sous-PR 1) — couleur perso, retrouvée partout dans l'app
  // (calendrier, bannière fallback, /potes/[id], avatars voteurs,
  // classement). Défaut violet (= l'accent existant) pour tout nouveau
  // compte tant qu'il n'a rien choisi. `colorCustomized` distingue "valeur
  // par défaut jamais touchée" de "choisie par l'utilisateur" — même
  // pattern que `Game.playInfoManual` (PR 32) : sans ce garde-fou, le
  // backfill qui diversifie les couleurs des comptes par défaut (rejoué à
  // chaque déploiement pour couvrir les nouveaux comptes) écraserait
  // indéfiniment un choix humain au déploiement suivant.
  color           String  @default("#8b5cf6")
  colorCustomized Boolean @default(false)

  // PR B : colonnes historiques conservées sans modification pour audit et
  // backfill. La progression courante est exclusivement CommunityMemberStats.
  xpTotal            Int       @default(0)
  streakCount        Int       @default(0)
  streakLastActiveAt DateTime?
  bestStreakCount    Int       @default(0)

  // Sprint 2 PR-B — onboarding premier login (4 écrans swipe). `false`
  // par défaut pour tout compte existant : migration additive, ne
  // redéclenche PAS l'onboarding pour les comptes déjà actifs — le
  // déclenchement réel se base sur "aucune soirée jouée ET aucune dispo
  // réglée" (voir `src/lib/onboarding.ts`), ce champ sert uniquement à ne
  // plus jamais raffiche l'écran une fois qu'il a été vu/skippé, y
  // compris si l'utilisateur joue une soirée puis en recrée un compte
  // vide (edge case volontairement couvert par ce booléen explicite
  // plutôt que par une simple détection d'activité, qui se remettrait à
  // "premier login" après un reset de données).
  onboardingCompleted Boolean @default(false)

  addedGames Game[]     @relation("GameAddedBy")
  userGames  UserGame[]

  weeklyAvailability    WeeklyAvailability[]
  availabilityOverrides AvailabilityOverride[]
  proposals             Proposal[]
  votes                 Vote[]
  sessionVetoes         SessionVeto[]
  rouletteVetoes        RouletteVeto[]
  createdSessions       Session[]
  xpEvents              XpEvent[]
  sessionResults        SessionResult[]
  sessionRatings        SessionRating[]
  lifetimeStats         UserLifetimeStats?
  communityMemberStats CommunityMemberStats[]

  // Confidentialité des soirées — voir `SessionInvite` plus bas. Trois
  // relations distinctes vers `User` (invité, invitant, révocateur),
  // jamais confondues.
  sessionInvitesReceived SessionInvite[] @relation("SessionInviteUser")
  sessionPreparations SessionPreparation[]
  sessionSeats SessionSeat[]
  sessionInvitesSent     SessionInvite[] @relation("SessionInviteInvitedBy")
  sessionInvitesRevoked  SessionInvite[] @relation("SessionInviteRevokedBy")

  // Audit trail (PR 5/9 du chantier XP, à la demande de l'utilisateur —
  // craint qu'un pote modifie un superlatif de façon abusive pour se
  // farmer de l'XP). Pas de blocage, juste une trace de qui a touché quoi
  // en dernier, affichée discrètement sur /admin/messages et
  // /admin/jeux-stats. `createdMessageTemplates` (qui l'a créé, inchangé
  // depuis PR1) et `modifiedMessageTemplates` (qui l'a modifié EN
  // DERNIER, nouveau) sont deux relations distinctes vers le même modèle
  // — noms de relation explicites obligatoires côté Prisma dès qu'un
  // modèle a plusieurs FK vers `User`.
  createdMessageTemplates  MessageTemplate[] @relation("MessageTemplateCreatedBy")
  modifiedMessageTemplates MessageTemplate[] @relation("MessageTemplateModifiedBy")
  modifiedGameStatTypes    GameStatType[]
  modifiedSuperlatives     Superlative[]

  // PR 5/9 — vote de superlatifs entre potes. Trois relations distinctes
  // vers `SuperlativeVote` (votant ≠ voté pour) obligent des noms
  // explicites, même raison que pour `MessageTemplate` plus haut.
  modifiedSuperlativeCategories SuperlativeCategory[]
  superlativeVotesCast          SuperlativeVote[]     @relation("SuperlativeVoter")
  superlativeVotesReceived      SuperlativeVote[]     @relation("SuperlativeVotedFor")
  superlativeAwardsWon          SuperlativeAward[]

  // PR 6/9 — tierlist perso (classement S/A/B/C/D de toute la biblio
  // commune, voir `TierlistEntry`).
  tierlistEntries TierlistEntry[]

  // PR 7/9 — badges automatiques débloqués (voir `Badge`/`UserBadge`).
  userBadges     UserBadge[]
  // PR 8/9 — audit trail sur /admin/badges (qui a créé/modifié un badge).
  modifiedBadges Badge[]

  // Refonte home — historique des passages de niveau (voir `LevelUpEvent`).
  levelUpEvents LevelUpEvent[]

  // Sprint 2 PR-C — préférence son des célébrations in-app (défaut activé,
  // n'affecte jamais l'envoi des webhooks Discord, seulement la lecture
  // locale d'un son côté client). Voir `soundEnabled` sur
  // `/profil/parametres` et `src/lib/haptics.ts`/`CelebrationConfetti`
  // pour le pendant haptique/visuel, déjà en place.
  soundEnabled Boolean @default(true)

  // Sprint 2 PR-C — historique des notifications in-app (voir `Notification`).
  notifications Notification[]
  webPushSubscriptions WebPushSubscription[]

  // Préférences de sollicitations personnelles par catégorie. Une ligne
  // explicite prime sur `silenceReminders`; l'ancien booléen reste présent
  // pendant la transition et sert de repli aux comptes sans ligne.
  notificationPreferences UserNotificationPreference[]

  // Sprint 3 (FEATURE 6) — tags perso auto-attribués (voir `Tag`/`UserTag`).
  userTags UserTag[]

  // Sprint 3 (roulette asynchrone) — voir `Roulette`/`RouletteEntry`.
  createdRoulettes Roulette[]
  rouletteEntries  RouletteEntry[]

  // V2 ("Jouer maintenant") — voir `InstantSession`/`InstantSessionPresenceInterval`.
  createdInstantSessions   InstantSession[]                  @relation("InstantSessionCreatedBy")
  instantSessionPresence   InstantSessionPresenceInterval[]
  publishedFreeGameOffers FreeGameOffer[]

  // Sprint 3 (dettes/gage) — voir `Debt`.
  debts Debt[]

  // Sprint 4 (Pronostics) — qui a prédit quoi (voir `Pronostic`). Deux
  // relations distinctes vers `Pronostic` (voteur ≠ prédit), mêmes noms
  // explicites obligatoires que `SuperlativeVote` plus haut.
  pronosticsMade     Pronostic[] @relation("PronosticVoter")
  pronosticsReceived Pronostic[] @relation("PronosticPredicted")

  // Sprint 4 (Paris d'XP) — mêmes deux rôles distincts (parieur ≠ cible).
  xpBetsPlaced XpBet[] @relation("XpBetVoter")
  xpBetsTarget XpBet[] @relation("XpBetTarget")

  // Sprint 4 (FEATURE 4) — dernière activité Steam connue, rafraîchie par
  // le cron `steam-library-sync` existant (`GetRecentlyPlayedGames`,
  // src/lib/steam.ts). `null` tant qu'aucune partie récente n'a jamais été
  // détectée (compte non lié, ou aucune activité sur les 2 dernières
  // semaines — fenêtre imposée par l'API Steam elle-même). Consultation
  // passive uniquement (/potes, /profil) — jamais de notif Discord, cf.
  // spec.
  lastPlayedGame String?
  lastPlayedAt   DateTime?

  // « En jeu maintenant » sur /potes (drapeau STEAM_NOW_PLAYING_ENABLED,
  // src/lib/steam-now-playing.ts) — contrairement à `lastPlayedGame`
  // (passé, GetRecentlyPlayedGames), ceci est l'état COURANT, lu par un seul
  // appel groupé `GetPlayerSummaries` par passage du cron léger
  // `steam-library-sync` : nom du jeu en cours (`gameextrainfo`) et
  // horodatage RÉEL de la dernière observation « en jeu ». Les deux sont
  // remis à `null` quand l'appel réussit et que le compte n'est pas en jeu ;
  // jamais touchés si l'appel échoue. L'affichage exige une observation
  // récente (voir `activeNowPlaying`) : un cron arrêté ne laisse jamais
  // « en jeu » affiché indéfiniment.
  steamNowPlaying       String?
  steamNowPlayingSeenAt DateTime?

  // Multi-communautés, PR5 — dernier serveur choisi sur /serveurs (drapeau
  // COMMUNITY_PICKER_ENABLED). Simple PRÉFÉRENCE d'affichage, sans clé
  // étrangère : revalidée contre les Membership ACTIVE (communauté ACTIVE) à
  // chaque usage, jamais une autorisation (voir `src/lib/community-picker.ts`).
  activeCommunityId String?

  // Sprint 4 (Saisons mensuelles) — voir `SeasonSnapshot`.
  seasonSnapshots SeasonSnapshot[]

  // Sprint 5 (Tournois Bracket) — voir `Tournament`/`TournamentParticipant`/
  // `TournamentMatch`. Quatre relations distinctes vers `TournamentMatch`
  // (joueur 1 ≠ joueur 2 ≠ gagnant), mêmes noms explicites obligatoires
  // que `SuperlativeVote` plus haut.
  createdTournaments      Tournament[]
  wonTournaments          Tournament[]            @relation("TournamentChampion")
  tournamentParticipation TournamentParticipant[]
  tournamentMatchesAsP1   TournamentMatch[]       @relation("TournamentMatchPlayer1")
  tournamentMatchesAsP2   TournamentMatch[]       @relation("TournamentMatchPlayer2")
  tournamentMatchesWon    TournamentMatch[]       @relation("TournamentMatchWinner")

  // Sprint 5 (FEATURE 2, Chat in-app) — voir `ChatMessage`/`ChatReaction`.
  chatMessages  ChatMessage[]
  chatReactions ChatReaction[]

  // Sprint 5 (FEATURE 3, Wishlist) — voir `GameWishlist`/`GameWishlistVote`.
  // Trois relations distinctes vers `GameWishlist` (proposant ≠ acheteur),
  // mêmes noms explicites obligatoires que `SuperlativeVote` plus haut.
  wishlistProposals GameWishlist[]     @relation("WishlistProposedBy")
  wishlistPurchases GameWishlist[]     @relation("WishlistPurchasedBy")
  wishlistVotes     GameWishlistVote[]

  // Multi-communautés (PR A) — relation seule, aucune colonne sur `User`.
  memberships Membership[]
  gameStyleProfiles GameStyleProfile[]

  @@index([xpTotal])
}

enum GameSource {
  STEAM
  IGDB
  MANUAL
}

model Game {
  epitaphs CommunityGameEpitaph[]
  // Relevé de préparation déclaré, indépendant des prix Steam consultés.
  preparationCost       String? @db.VarChar(10)
  preparationPrice      String? @db.VarChar(120)
  downloadSizeGb        Float?
  preparationPlatform   String? @db.VarChar(80)
  preparationSourceUrl  String? @db.VarChar(500)
  preparationTimeMinutes Int?
  preparationUpdatedAt  DateTime?
  // Informations déclarées par un possesseur ; null = inconnu.
  jumpscares          Boolean?
  motionSickness      Boolean?
  textLanguages       String? @db.VarChar(120)
  audioLanguages      String? @db.VarChar(120)
  warningsUpdatedAt   DateTime?
  id         String     @id @default(cuid())
  name       String
  source     GameSource
  steamAppId Int?
  igdbId     Int?
  coverUrl   String?
  isCoop     Boolean    @default(false)
  minPlayers Int?
  maxPlayers Int?
  addedById  String
  createdAt  DateTime   @default(now())

  // PR 32 (2.5/4) : true dès que isCoop/minPlayers/maxPlayers ont été
  // saisis ou confirmés par un humain (formulaire d'ajout/édition
  // manuel, ou le bouton "Marquer comme coop" sur /bibliotheque) — jamais
  // par l'import Steam (qui pose `isCoop=false`/`maxPlayers=null` par
  // défaut, Steam ne fournissant pas cette info) ni par le backfill IGDB
  // automatique. Distingue "valeur par défaut jamais vérifiée" de
  // "confirmée par un humain" : sans ce booléen, le backfill (rejoué à
  // chaque build) écraserait indéfiniment une correction manuelle
  // (ex. quelqu'un décoche "coop" sur un jeu qu'IGDB classe à tort en
  // coop) au déploiement suivant.
  playInfoManual Boolean @default(false)

  // Cache de la fiche IGDB détaillée (F : fiche jeu), rempli à la demande
  // au premier clic sur la fiche — jamais à l'import Steam (évite un
  // timeout Vercel si on enrichissait toute une biblio importée d'un coup).
  // `null` tant que jamais fetché (ou si IGDB n'a rien trouvé). Structure
  // libre en JSON (voir `IgdbGameDetails` dans src/lib/igdb.ts) : pas de
  // colonnes dédiées ; ces métadonnées servent à l'affichage et aux suggestions, suivant la forme
  // de l'API IGDB.
  igdbDetails          Json?
  igdbDetailsFetchedAt DateTime?
  // Marque datée « IGDB ne connaît pas ce jeu » (fiche introuvable pour
  // `igdbId`) : le backfill IGDB ne le retente qu'après un délai
  // (`IGDB_NOT_FOUND_RETRY_MS`, src/lib/backfill-igdb-coop.ts) au lieu de
  // l'interroger à chaque passage. Remise à `null` dès qu'une fiche est
  // récupérée avec succès.
  igdbNotFoundAt       DateTime?

  addedBy   User       @relation("GameAddedBy", fields: [addedById], references: [id])
  userGames UserGame[]
  userRefusals UserGameRefusal[]

  proposals       Proposal[]
  decidedSessions Session[]
  statTypes       GameStatType[]
  tierlistEntries TierlistEntry[]
  news            GameNews[]
  rouletteEntries RouletteEntry[]

  // Sprint 5 (Tournois Bracket) — jeu du tournoi.
  tournaments Tournament[]

  // V2 ("Jouer maintenant") — voir `InstantSession`.
  instantSessions InstantSession[]

  // Sprint 5 (Wishlist) — au plus une entrée wishlist par jeu (voir
  // `@@unique([gameId])` sur `GameWishlist`), donc relation singulière
  // plutôt qu'un tableau.
  wishlistEntries GameWishlist[]

  // Chantier nettoyage réel du stockage (V2, suite) — compteur durable
  // "Stats du groupe" de la Home, voir `GroupGameStat`.
  groupStats GroupGameStat[]

  @@unique([steamAppId])
  @@unique([igdbId])
}

// Sprint 3 — card "Actu gaming" sur la Home. Cache des news Steam
// (`ISteamNews/GetNewsForApp`) pour les jeux les plus joués du groupe,
// rafraîchi au maximum 1x/jour par `runGameNewsBackfill`
// (src/lib/steam-news.ts), jamais appelé à un chargement de page — voir
// le commentaire en tête de ce fichier pour la même philosophie que
// `runSteamCoopBackfill`. `gameId` pointe toujours un jeu `source =
// STEAM` (seuls ceux-là ont un `steamAppId`, cf. le skip IGDB-only dans
// le backfill) mais `steamAppId` est dupliqué ici en scalaire plutôt que
// relu via la relation à chaque affichage — évite une jointure
// supplémentaire pour un champ qui ne change jamais après coup.
// `@@unique([steamAppId, title])` : idempotence du backfill (rejoué
// quotidiennement) — un même article Steam ne doit jamais créer une
// deuxième ligne.
model GameNews {
  id          String   @id @default(cuid())
  gameId      String
  steamAppId  Int
  title       String
  url         String
  feedLabel   String
  publishedAt DateTime
  fetchedAt   DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([steamAppId, title])
  @@index([publishedAt])
}

// PR "Import biblio Steam Family" : distingue COMMENT l'utilisateur
// possède ce jeu — PERSONAL (import Steam perso, `importSteamLibrary`),
// FAMILY (import copier-coller biblio famille, `matchFamilyImportBatch`),
// MANUAL (ajout manuel via /bibliotheque/ajouter). Un même `Game` (ex.
// Skyrim) reste une seule ligne en base peu importe qui le possède —
// c'est `UserGame.source` qui porte cette info par relation user↔jeu, pas
// `Game`. Défaut PERSONAL : les `UserGame` déjà en base avant cette PR
// ont tous été créés par l'import Steam perso ou l'ajout manuel, jamais
// par un mécanisme famille (qui n'existait pas) — la valeur par défaut
// de la migration additive couvre donc correctement leur backfill sans
// script séparé.
enum UserGameSource {
  PERSONAL
  FAMILY
  MANUAL
}

model UserGame {
  userId String
  gameId String
  owned  Boolean        @default(true)
  source UserGameSource @default(PERSONAL)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
}

// Dispo récurrente par défaut : un ou plusieurs créneaux par jour de la
// semaine. `dayOfWeek` suit la convention JS `Date.getUTCDay()` (0 =
// dimanche … 6 = samedi) pour rester directement comparable à la date
// d'une Session. `startTime`/`endTime` au format "HH:mm" ; un créneau dont
// `endTime` "traverse minuit" (ex. 21:00–00:00) est géré côté application.
model WeeklyAvailability {
  id        String @id @default(cuid())
  userId    String
  dayOfWeek Int
  startTime String
  endTime   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Exception ponctuelle sur une date précise : indisponibilité
// exceptionnelle (`available = false`) ou disponibilité exceptionnelle
// (`available = true`), qui prime sur `WeeklyAvailability` ce jour-là.
// `startTime`/`endTime` optionnels : absents = toute la journée.
model AvailabilityOverride {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  available Boolean
  startTime String?
  endTime   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

enum SessionStatus {
  VOTING
  SCHEDULED
  DONE
  CANCELLED
}

// Une soirée. `date` porte la date ET l'heure visée (choisies à la
// création) ; `decidedTime` est renseigné à la clôture (copie de `date`
// pour l'instant — champ distinct pour une éventuelle renégociation future
// de l'heure). Un seul jeu gagnant par soirée (`decidedGameId`), cf. §7 —
// la file de jeux multiples est un sujet v2 dédié. `votingDeadline`
// (nullable pour les sessions créées avant son ajout) ferme le vote avant
// l'heure de la session ; nul = pas de deadline distincte, seule l'heure
// de la session ferme le vote (comportement historique).
model Session {
  availabilityPoll SessionAvailabilityPoll?
  id             String        @id @default(cuid())
  date           DateTime
  votingDeadline DateTime?
  status         SessionStatus @default(VOTING)
  decidedGameId  String?
  decidedTime    DateTime?
  createdAt      DateTime      @default(now())

  // Gestion des places activée explicitement par le créateur après décision.
  // null conserve les participants historiques issus des votes.
  attendanceCapacity Int?
  preparations SessionPreparation[]
  seats SessionSeat[]
  vetoes SessionVeto[]

  // Créateur de la session — introduit après coup (les sessions créées
  // avant cette migration ont été backfillées, voir la migration SQL pour
  // la stratégie exacte). Détermine qui peut modifier/supprimer/clôturer
  // manuellement/annuler cette session (les autres membres du groupe
  // peuvent toujours proposer un jeu, voter, et consulter la session).
  createdById String

  // F7 : message de rappel perso, saisi à la création de la session. S'il
  // est renseigné, il remplace le tirage aléatoire dans MessageTemplate
  // pour tous les rappels de cette session (cf. `reminderTimings`).
  customReminderMessage String?
  // F7 : fenêtres de rappel déjà envoyées pour cette session, ex.
  // `["1440", "120"]` (minutes avant la session, en string) — évite les
  // doublons si le cron retombe plusieurs fois sur la même fenêtre.
  // Tableau JSON plutôt que des booléens dédiés : les fenêtres sont un
  // détail d'implémentation (cf. `reminderTimings` ci-dessous), pas une
  // invariante du modèle.
  remindersSent         Json    @default("[]")
  // PR 31 (2/4, Bloc A) : minutes avant la session auxquelles un rappel
  // Discord doit partir — choisi par le créateur à la création (cases à
  // cocher parmi 8 préréglages + rappels custom, 5 max). Remplace les
  // fenêtres 24h/2h fixées en dur. Défaut `[1440, 120]` (24h + 2h) =
  // comportement F7 d'origine préservé pour toute nouvelle session sans
  // réglage explicite, et pour les sessions créées AVANT cette PR (valeur
  // par défaut Postgres appliquée à la colonne existante par la
  // migration, pas de backfill séparé nécessaire).
  reminderTimings       Int[]   @default([1440, 120])

  // PR 5/9 — fenêtre de vote des superlatifs entre potes, ouverte par
  // `markSessionDone` (cf. src/lib/sessions.ts) : `superlativeVotingDeadline`
  // = maintenant + 24h à l'ouverture (nulle si la session n'a pas eu
  // assez de participants — voir plus loin — auquel cas
  // `superlativeVotingClosed` passe direct à `true`, aucun vote possible).
  // Le vote se clôture (cf. src/lib/superlative-voting.ts) dès que tous
  // les participants ont voté OU que la deadline est dépassée,
  // "whichever comes first" — vérifié paresseusement à la lecture (même
  // philosophie que `closeSessionIfDue` pour la clôture du vote de jeu),
  // pas de cron dédié. `superlativeVotingClosed` distingue "pas encore
  // clôturé" de "clôturé sans le moindre award" (0 vote au total) : sans
  // ce booléen, l'absence de `SuperlativeAward` serait ambiguë entre ces
  // deux cas.
  superlativeVotingDeadline DateTime?
  superlativeVotingClosed   Boolean   @default(false)

  // Ping sélectif à la création : liste des ids de potes à mentionner
  // (création, clôture/validation, rappels) — `null` = pas de restriction,
  // tout le groupe mentionné comme avant cette fonctionnalité (comportement
  // préservé pour toute session créée avant cette migration, colonne
  // nullable sans backfill). Un tableau JSON (même vide) est une sélection
  // explicite du créateur, respectée littéralement : tout décocher au
  // formulaire mentionne bien personne, aucun repli silencieux sur "tout
  // le monde" — même philosophie que `reminderTimings` ci-dessus. `Json?`
  // plutôt que `String[]?` : Prisma interdit les listes scalaires
  // optionnelles (seul `Json` supporte `null` vs "tableau, même vide"),
  // même famille de type que `remindersSent` ci-dessus. Simple colonne
  // scalaire plutôt qu'une table de relation : pas d'intégrité
  // référentielle nécessaire (juste un filtre de mentions Discord, jamais
  // relu/joint ailleurs).
  notifiedUserIds Json?

  // Sprint 3 (roue du gambling, /roulette) — `true` pour une session créée
  // depuis le résultat de la roue plutôt que par le formulaire habituel de
  // `/sessions`. Pas de table dédiée à la roulette elle-même : une
  // roulette EST une session, ce booléen sert uniquement à filtrer
  // l'onglet "Historique" de `/roulette` (sessions
  // `createdViaRoulette = true`, mêmes cards que `/sessions`).
  createdViaRoulette Boolean @default(false)

  // Chantier annonces Discord bot (salons/fils, après #95/#96/#97/#98) —
  // décision figée UNE SEULE FOIS, à la création de cette session précise,
  // selon la valeur de `DISCORD_BOT_SESSION_ANNOUNCE_ENABLED` À CE
  // MOMENT-LÀ (voir `src/lib/discord-bot-config.ts`) : `false` = chemin
  // webhook existant (`discord-announce.ts`/`discord-session-created.ts`/
  // `discord-session-modified.ts`, inchangés), `true` = chemin bot exclusif
  // (`src/lib/session-announce.ts`), JAMAIS les deux à la fois pour une
  // même session. Volontairement PAS relu depuis la variable d'env à
  // chaque action ultérieure (modification, clôture, rappel) : la variable
  // globale peut changer entre-temps (activation, puis retour arrière) sans
  // que ça ne doive faire basculer une session déjà annoncée d'un canal à
  // l'autre — une session dont l'annonce existe déjà sur un canal donné ne
  // peut être éditée que sur CE MÊME canal, sous peine d'éditer un message
  // qui n'existe pas là où on le cherche. `@default(false)` : toute session
  // créée avant cette colonne (et donc avant tout chemin bot) reste
  // silencieusement sur le webhook, comportement historique inchangé, sans
  // backfill nécessaire.
  announceViaBot Boolean @default(false)

  // Multi-communautés, PR3 : communauté de la soirée (salons Discord par
  // communauté). `null` = communauté par défaut (toutes les soirées créées
  // avant cette colonne, ou tant que `COMMUNITY_CHANNELS_ENABLED` est éteint).
  // Additif : jamais NOT NULL tant que l'étape « contract » n'est pas validée.
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  @@index([communityId])

  createdBy         User               @relation(fields: [createdById], references: [id])
  decidedGame       Game?              @relation(fields: [decidedGameId], references: [id])
  proposals         Proposal[]
  results           SessionResult[]
  ratings           SessionRating[]
  superlativeVotes  SuperlativeVote[]
  superlativeAwards SuperlativeAward[]
  // Sprint 3 (dettes/gage) — voir `Debt`.
  debts             Debt[]
  // Sprint 4 — voir `Pronostic`/`XpBet`.
  pronostics        Pronostic[]
  xpBets            XpBet[]
  // Sprint 5 (Chat in-app) — canal dédié à cette soirée (`ChatMessage.sessionId`).
  chatMessages      ChatMessage[]

  // Chantier confidentialité — source de vérité des invitations (voir
  // `SessionInvite` plus bas). `onDelete: Cascade` : supprimer la session
  // supprime ses invitations avec elle, jamais l'inverse.
  invites SessionInvite[]

  // Infra (Sprint 5 suite, I4) — `/sessions`, la Home et les crons
  // filtrent quasi systématiquement par `status` puis trient par `date`
  // (prochaine soirée VOTING/SCHEDULED, sessions VOTING dues pour la
  // clôture...) ; seul modèle "chaud" de l'app qui n'avait encore aucun
  // index.
  @@index([status, date])
}

// Chantier confidentialité des soirées — remplace l'ancien choix
// d'annonces collectives : seuls le créateur et les invités actifs
// peuvent désormais consulter/agir sur une soirée, sur le site ET sur
// Discord (voir `src/lib/session-access.ts`, source de vérité unique du
// contrôle d'accès serveur). Table de relation dédiée plutôt qu'une
// réutilisation de `Session.notifiedUserIds` (qui reste un simple filtre
// de mentions Discord, jamais une liste d'accès — voir son commentaire) :
// une invitation a besoin d'un historique (qui a invité qui, quand),
// d'une révocation traçable et réversible (réinviter recrée juste une
// ligne, jamais un simple booléen écrasé), et de survivre à la
// suppression d'un ancien invité sans effacer ses contributions passées
// (`Vote`/`Proposal`/`ChatMessage` déjà écrits restent intacts — seul
// l'ACCÈS futur est coupé).
//
// `status: REVOKED` PLUTÔT qu'une suppression de ligne — le retrait d'un
// invité doit rester observable (`revokedAt`/`revokedById` posés). Une
// seule ligne par (session, personne) POUR TOUJOURS (`@@unique` ci-dessous,
// sans distinction de statut) : réinviter quelqu'un après un retrait
// RÉUTILISE la même ligne (repasse `ACTIVE`, `revokedAt`/`revokedById`
// remis à `null`, `invitedById` mis à jour sur le réinvitant) plutôt que
// d'en créer une seconde — un seul cycle actif observable à la fois,
// jamais deux lignes concurrentes pour le même couple session/personne
// (voir `inviteToSession`/`revokeSessionInvite`, src/lib/session-access.ts).
model SessionInvite {
  id          String              @id @default(cuid())
  sessionId   String
  userId      String
  invitedById String
  status      SessionInviteStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  revokedAt   DateTime?
  revokedById String?

  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User    @relation("SessionInviteUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("SessionInviteInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  revokedBy User?   @relation("SessionInviteRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  // Une seule ligne par (session, personne) à la fois — réinviter après un
  // retrait est bloqué par cette contrainte tant que l'ancienne ligne
  // reste ACTIVE (impossible : le retrait la passe REVOKED avant toute
  // réinvitation, voir `revokeSessionInvite`/`inviteToSession` dans
  // session-access.ts), donc jamais deux lignes concurrentes pour le
  // même couple.
  @@unique([sessionId, userId])
  @@index([sessionId, status])
  @@index([userId, status])
}

enum SessionInviteStatus {
  ACTIVE
  REVOKED
}

// Sprint 4 (FEATURE 1, Pronostics) — avant une soirée SCHEDULED, chaque
// participant prédit qui va "carry" (gagner MVP/Carry). `voterId` = celui
// qui prédit, `predictedUserId` = celui qu'il désigne. `@@unique([sessionId,
// voterId])` : un seul prono par personne et par soirée, comme demandé.
// Résolu par `resolvePronostics` (src/lib/pronostics.ts), appelée juste
// après `finalizeSuperlativeVoting` (src/lib/superlative-voting.ts) une
// fois les awards de la soirée connus — "correct" = `predictedUserId` a
// gagné une catégorie superlatif dont le nom contient "carry" ou "mvp"
// (catégories admin-éditables sur /admin/superlatifs, pas d'enum figé
// possible ici — voir le commentaire sur `isCarryOrMvpCategory` dans
// pronostics.ts pour le detail du matching).
model Pronostic {
  // Provenance durable : conservée même si la soirée ou la communauté est purgée.
  // null = données historiques de default, jamais recalculée depuis le membre.
  communityId String?

  @@index([communityId])
  id              String   @id @default(cuid())
  // Chantier nettoyage réel du stockage (V2, suite) — nullable, `onDelete:
  // SetNull` (PAS Cascade, contrairement au commentaire historique de
  // `Debt`) : `/profil` calcule un taux de réussite À VIE
  // (`prisma.pronostic.groupBy({by:["correct"], where:{voterId,
  // correct:{not:null}}})`, src/app/profil/page.tsx) — une purge de la
  // soirée ne doit jamais faire perdre ni sous-compter ce taux. La ligne
  // elle-même est DÉJÀ minimale (aucun contenu de chat, aucune donnée
  // personnelle au-delà des deux users déjà connus par ailleurs) : la
  // laisser survivre EST le résumé durable, jamais une copie ailleurs.
  // `@@unique([sessionId, voterId])` ci-dessous reste valide une fois
  // `sessionId` `NULL` : NULL n'entre jamais en collision avec lui-même
  // dans une contrainte unique Postgres (sémantique standard).
  sessionId       String?
  voterId         String
  predictedUserId String
  // `null` tant que non résolu ; posé par `resolvePronostics` en même temps
  // que l'XP/notif — même rôle que `XpBet.won` (voir plus bas), pour ne
  // jamais recalculer la correspondance carry/mvp à chaque lecture (ex.
  // "taux de prono correct" sur /profil).
  correct         Boolean?
  createdAt       DateTime @default(now())

  session       Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  voter         User    @relation("PronosticVoter", fields: [voterId], references: [id], onDelete: Cascade)
  predictedUser User    @relation("PronosticPredicted", fields: [predictedUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, voterId])
}

// Sprint 4 (FEATURE 5, Paris d'XP) — même fenêtre que les pronostics
// (soirée SCHEDULED), mais avec une mise d'XP. `amount` est déduit du
// solde du parieur DÈS la pose du pari (mise "en jeu", jamais négative :
// `placeBetAction` valide `amount <= floor(xpTotal * 0.5)` avant d'écrire).
// `won` reste `null` tant que non résolu ; résolu en même temps que les
// pronostics, par `resolveBets` (src/lib/xp-bets.ts) — pari gagné =
// `targetUserId` a gagné une catégorie carry/mvp, double mise créditée via
// `awardXp` (reason `XP_BET_WON`) ; perdu = rien de plus (mise déjà
// déduite). `allIn` fige si la mise valait 50% pile du solde au moment du
// pari (badge "All In" : parier 50% ET gagner) — recalculer ça après coup
// à partir du seul `amount` serait faux, `xpTotal` ayant pu changer entre
// temps.
model XpBet {
  // Provenance durable : conservée même si la soirée ou la communauté est purgée.
  // null = données historiques de default, jamais recalculée depuis le membre.
  communityId String?

  @@index([communityId])
  id           String   @id @default(cuid())
  // Chantier nettoyage réel du stockage (V2, suite) — nullable, `onDelete:
  // SetNull` : `/profil` affiche un historique des 5 paris résolus les
  // plus récents ET une somme À VIE des gains (src/app/profil/page.tsx) —
  // les deux doivent survivre à la purge de la soirée. Même raisonnement
  // que `Pronostic` (voir son commentaire) : la ligne survit telle
  // quelle, jamais copiée ailleurs.
  sessionId    String?
  voterId      String
  targetUserId String
  amount       Int
  won          Boolean?
  allIn        Boolean  @default(false)
  createdAt    DateTime @default(now())
  // Dénormalisé (comme `Debt.reason`, même philosophie) — capturé à la
  // pose du pari (`placeBet`, src/lib/xp-bets.ts), où `session.decidedGame`
  // est déjà connu : évite un `include: { session: { decidedGame } } }`
  // qui échouerait silencieusement (relation devenue `null`) une fois la
  // soirée purgée. Rempli rétroactivement pour les paris déjà résolus au
  // moment de la migration (voir son SQL).
  gameName     String?

  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  voter   User    @relation("XpBetVoter", fields: [voterId], references: [id], onDelete: Cascade)
  target  User    @relation("XpBetTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, voterId])
}

enum SessionSeatStatus {
  CONFIRMED
  WAITLIST
  DECLINED
}

// La communauté et les droits privés sont hérités de Session, comme Vote.
model SessionSeat {
  id String @id @default(cuid())
  sessionId String
  userId String
  status SessionSeatStatus @default(WAITLIST)
  requestedAt DateTime @default(now())
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId, status, requestedAt])
}

model Proposal {
  id           String   @id @default(cuid())
  sessionId    String
  gameId       String
  proposedById String
  createdAt    DateTime @default(now())

  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  game       Game    @relation(fields: [gameId], references: [id])
  proposedBy User    @relation(fields: [proposedById], references: [id])
  votes      Vote[]
  vetoes     SessionVeto[]

  @@unique([sessionId, gameId])
}

// Veto au vote de jeu (flag VOTE_VETO_ENABLED) : 1 par personne et par soirée.
// Un jeu vetoé ne peut être ni retenu ni tiré.
model SessionVeto {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String
  proposalId  String
  communityId String
  createdAt   DateTime @default(now())

  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal  Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([proposalId])
  @@index([communityId])
}

// Veto du jeu tiré par une roulette asynchrone (flag VOTE_VETO_ENABLED) : 1 par participant et par roulette.
// `gameId` = le jeu vetoé (id libre, comme Roulette.resultGameId) ; les vetoés sont exclus des relances.
model RouletteVeto {
  id          String   @id @default(cuid())
  rouletteId  String
  userId      String
  gameId      String
  communityId String
  createdAt   DateTime @default(now())

  roulette  Roulette  @relation(fields: [rouletteId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([rouletteId, userId])
  @@index([communityId])
}

model Vote {
  id         String @id @default(cuid())
  proposalId String
  userId     String

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
}

// Catégories de messages Discord textuels tirés au hasard dans
// MessageTemplate. Le résultat de vote (F6) reste hors de ce système —
// c'est un embed structuré, pas un message perso tiré au hasard.
enum MessageCategory {
  SESSION_CREATED
  SESSION_MODIFIED
  REMINDER_24H
  REMINDER_2H
  // Chantier XP/niveaux/rangs — notif Discord de passage de niveau, cf.
  // src/lib/discord-level-up.ts.
  LEVEL_UP
  // PR 5/9 — annonce des superlatifs votés après une soirée, cf.
  // src/lib/discord-session-awards.ts. Ne pas confondre avec le résultat
  // de vote F6 (embed structuré indépendant, jamais dans ce système).
  SESSION_AWARDS
  // PR 7/9 — annonce du déblocage d'un badge, cf.
  // src/lib/discord-badge-unlocked.ts.
  BADGE_UNLOCKED
}

// Messages Discord perso (rappels F7, notifs de création/modification de
// session), tirés au hasard parmi les templates actifs d'une catégorie
// donnée au moment de l'envoi. Gérés depuis /admin/messages — "admin" au
// sens large, tout utilisateur connecté peut ajouter/modifier/désactiver
// (pas de rôle admin dédié dans ce MVP, cf. spec). `active = false` est un
// fusible pratique pour désactiver un message sans perdre l'historique
// (qui l'a créé) en le supprimant. Un même message peut appartenir à
// plusieurs catégories (ex. un message générique valable pour les deux
// rappels). `variables` est purement informationnel — affiché dans
// /admin/messages pour indiquer quelles variables sont utilisables selon
// les catégories cochées, jamais validé côté serveur.
model MessageTemplate {
  id          String            @id @default(cuid())
  text        String
  active      Boolean           @default(true)
  categories  MessageCategory[]
  variables   String[]          @default([])
  createdById String
  createdAt   DateTime          @default(now())

  // Audit trail — qui a modifié ce message EN DERNIER (create ou update),
  // et quand. Backfillée à createdById/createdAt pour les lignes
  // existantes lors de la migration qui a introduit ces deux champs (donc
  // "dernière modif" = "création" tant que personne n'y a retouché
  // depuis). `modifiedAt` géré automatiquement par Prisma (`@updatedAt`),
  // jamais fixé à la main.
  modifiedById String
  modifiedAt   DateTime @updatedAt

  createdBy  User @relation("MessageTemplateCreatedBy", fields: [createdById], references: [id])
  modifiedBy User @relation("MessageTemplateModifiedBy", fields: [modifiedById], references: [id])
}

// Type d'action ayant rapporté de l'XP à un user — cf. `awardXp` dans
// src/lib/xp-actions.ts. Étendu au fil du chantier, pas avant : PR 2/9
// (XP participation, Axe 1) a posé les 5 premières valeurs ; PR 3/9 ajoute
// SESSION_RESULT (podium/coop, Axe 2) ; PR 5/9 ajoute SUPERLATIVE_AWARD
// (vote entre potes, Axe 3 v2 — voir `SuperlativeCategory` plus bas) ; PR
// 7/9 ajoute BADGE_UNLOCKED (XP optionnel à l'unlock d'un badge, voir
// `Badge` plus bas) ; le profil complet (PR 8/9) ajoutera la sienne le
// moment venu — pas de valeur d'enum qui traîne sans code pour la
// déclencher.
enum XpReason {
  CREATE_SESSION
  VOTE
  PARTICIPATE
  AVAILABILITY_FIRST
  STEAM_LINK_FIRST
  SESSION_RESULT
  SUPERLATIVE_AWARD
  BADGE_UNLOCKED
  // Sprint 3 (défis hebdo) — voir `WeeklyChallenge`/`src/lib/weekly-challenges.ts`.
  CHALLENGE_COMPLETE
  // Sprint 4 — voir `Pronostic`/`src/lib/pronostics.ts`.
  PRONOSTIC_CORRECT
  // Sprint 4 — voir `XpBet`/`src/lib/xp-bets.ts`. `applyStreak: false` sur
  // l'appel `awardXp` correspondant (rendre une mise + gains n'est pas un
  // "gain" au sens streak, cf. le commentaire sur `awardXp`).
  XP_BET_WON
  // Sprint 5 (Tournois Bracket) — voir `src/lib/tournaments.ts`. Un seul
  // reason pour les 3 montants (1er/2e/demi-finaliste), même logique que
  // `SESSION_RESULT` pour le podium de soirée.
  TOURNAMENT_RESULT
  SHOP_PURCHASE
  // Correction manuelle d'un admin (onglet « Joueurs » de /admin) : écart entre
  // l'ancien et le nouveau solde, `sourceId` = identifiant du `XpAdjustment`.
  // Garde les classements par période cohérents avec le solde corrigé.
  ADMIN_ADJUSTMENT
}

// Résultat "générique" d'une soirée (Axe 2) : podium 1er/2e/3e facultatif
// pour les sessions compétitives, ou simple présence (placement = null)
// pour les sessions coop (`Game.isCoop`), où tout le monde est équivalent.
// Saisi une seule fois par le créateur depuis `/sessions/[id]/resultats`
// une fois la session `DONE` — existence de lignes pour cette session =
// "résultats déjà saisis" (pas de re-saisie possible, cf. le résumé de PR
// pour la raison : éviter la double comptabilisation d'XP si un podium
// est corrigé après coup). `@@unique([sessionId, userId])` : un seul
// résultat par participant et par session.
model SessionResult {
  // Provenance durable, indépendante de la conservation du parent.
  communityId String?

  @@index([communityId])
  // Chantier nettoyage réel du stockage (V2, suite) — RÉSUMÉ DURABLE du
  // podium d'une soirée, conçu explicitement pour survivre à la purge de
  // celle-ci (`onDelete: SetNull`, PAS Cascade) : `/profil/historique`,
  // `/profil` (win rate + jeu le plus joué) et `src/lib/revanche.ts`
  // (compteur de défaites consécutives À UN JEU DONNÉ, à travers TOUTES
  // les soirées de ce jeu, potentiellement purgées) en dépendent tous les
  // trois pour des durées bien au-delà de la fenêtre de rétention. Cette
  // ligne est DÉJÀ minimale (placement + 3 champs dénormalisés, jamais le
  // contenu du chat/des votes/des propositions) — c'est ELLE le résumé
  // durable demandé, jamais une copie séparée : rien n'est dupliqué
  // ailleurs, seul le lien vers `Session` est rendu optionnel.
  id        String    @id @default(cuid())
  sessionId String?
  userId    String
  placement Int?
  createdAt DateTime  @default(now())

  // Dénormalisés (même philosophie que `Debt.reason`) — capturés à la
  // saisie des résultats (`submitSessionResultsAction`), où `session.date`/
  // `session.decidedGame` sont déjà connus. `gameId` (pas seulement
  // `gameName`) est nécessaire pour que `revanche.ts` continue de filtrer
  // "les résultats de CE jeu précis" sans jamais rejoindre `Session` (la
  // relation `session:{decidedGameId:...}` qu'il utilisait devient
  // silencieusement incomplète dès qu'une soirée est purgée — une jointure
  // sur une ligne `NULL` l'exclut du calcul, sous-comptant l'historique
  // réel). Remplis rétroactivement pour les résultats déjà saisis au
  // moment de la migration (voir son SQL) — jamais laissés `NULL` pour une
  // ligne qui a une soirée encore identifiable à ce moment précis.
  gameId      String?
  gameName    String?
  sessionDate DateTime?

  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  // Sert `revanche.ts` (compte les résultats d'un user pour un jeu donné,
  // indépendamment de l'existence de la soirée).
  @@index([userId, gameId])
}

model SessionRating {
  id          String   @id @default(cuid())
  sessionId   String
  communityId String?
  userId      String
  rating      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session   Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([communityId, sessionId])
}

// Ledger XP append-only — préféré à un simple compteur sur `User` pour
// deux raisons : (1) idempotence, `@@unique([userId, reason, sourceId])`
// permet à `awardXp` et au script de backfill (prisma/backfill-xp.mjs) de
// se re-exécuter indéfiniment sans jamais doubler une même récompense —
// même mécanisme de prudence que le bug de seed corrigé en PR 2 du
// chantier précédent ; (2) `/classement` (PR 9/9) doit pouvoir filtrer
// "ce mois"/"cette semaine", ce qu'un total unique ne permettrait pas.
// `sourceId` identifie l'événement qui a rapporté l'XP — sa forme dépend
// de `reason` (id de Session pour CREATE_SESSION/PARTICIPATE, id de
// Proposal pour VOTE — pas l'id du Vote lui-même, pour ne pas re-créditer
// un aller-retour vote/dévote/revote sur la même proposition ; l'id du
// user lui-même pour les XP "une seule fois dans la vie").
model XpEvent {
  communityId String
  id        String   @id @default(cuid())
  userId    String
  reason    XpReason
  sourceId  String
  amount    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId, reason, sourceId])
  @@index([communityId, createdAt])
  @@index([userId])
  @@index([createdAt])
}

// Journal des corrections manuelles d'XP (onglet « Joueurs » de /admin) : qui, quand,
// ancienne et nouvelle valeur, raison. Volontairement sans clé étrangère vers
// User : l'historique d'audit survit à la suppression d'un compte, d'où les noms
// copiés (`userName`, `adminName`) à la date de la correction.
model XpAdjustment {
  id          String   @id @default(cuid())
  communityId String
  userId      String
  userName    String
  adminId     String
  adminName   String
  oldXp       Int
  newXp       Int
  reason      String?
  createdAt   DateTime @default(now())

  @@index([communityId, userId, createdAt])
  @@index([createdAt])
}

// Refonte home ("Activité récente") — un passage de niveau était jusque-là
// un événement purement transitoire, détecté à la volée dans `awardXp`
// (xp-actions.ts) juste pour déclencher la notif Discord
// (`announceLevelUp`), sans jamais être persisté. Cette table capture le
// même événement, au même endroit exact, pour pouvoir l'afficher dans le
// feed d'activité — jamais écrite par le script de backfill
// (`prisma/backfill-xp.mjs`, qui écrit l'XP directement sans passer par
// `awardXp` ni détecter de passage de niveau, précisément pour éviter de
// spammer Discord de level-ups rétroactifs à chaque déploiement — même
// raisonnement ici : pas de `LevelUpEvent` rétroactif non plus, seuls les
// VRAIS passages de niveau à partir de maintenant sont enregistrés).
model LevelUpEvent {
  communityId String
  id        String   @id @default(cuid())
  userId    String
  level     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
  @@index([createdAt])
}

enum StatType {
  INT
  FLOAT
  BOOL
}

enum SuperlativeRule {
  // Le participant avec la plus grande/plus petite valeur de la stat sur
  // la soirée gagne le superlatif (stats INT/FLOAT). En cas d'égalité,
  // l'attribution exacte (personne, plusieurs ex-aequo...) est un détail
  // d'implémentation, pas figé ici.
  MAX
  MIN
  // Stat BOOL : gagné par (chacun de) ceux dont la valeur vaut `true`
  // cette soirée-là — ex. "🏆 A gagné la partie". Le nom de la règle
  // anticipe une évolution possible où la même stat BOOL serait cumulée
  // sur plusieurs soirées ("le plus de fois true"), mais pour une saisie
  // = une soirée, c'est équivalent à "est true ce soir-là".
  TRUE_COUNT
}

// Axe 3 v1 (chantier XP) — définition des stats saisissables après une
// soirée pour un jeu donné (ex. Lethal Company : nombre de morts, butin
// récupéré...). Configuré depuis /admin/jeux-stats — "admin" au sens
// large, comme /admin/messages (pas de rôle dédié, tout le monde peut
// gérer). `higherIsBetter` est purement informatif/cosmétique (couleur
// d'affichage) : il ne détermine PAS qui gagne un superlatif, c'est le
// `rule` (MAX/MIN) de chaque `Superlative` qui le fait — une même stat
// peut porter plusieurs superlatifs avec des règles différentes (ex.
// `survivalTime` : MIN pour "😱 First blood").
//
// ABANDONNÉ EN PR 5/9 (laissé dormant, pas supprimé) : la saisie de
// stats chiffrées par soirée s'est révélée trop lourde à l'usage pour un
// groupe de potes flemmards. Remplacé par un système de VOTE entre potes,
// sans chiffres à saisir — voir `SuperlativeCategory`/`SuperlativeVote`/
// `SuperlativeAward` plus bas, complètement indépendants de ce modèle-ci.
// `/admin/jeux-stats` reste dans le code et fonctionnel (accessible par
// URL directe), juste retiré du lien de navigation sur /profil au profit
// de `/admin/superlatifs`. Ni `GameSessionResult` ni l'ancien
// `SuperlativeAward` "par jeu" envisagés à l'origine n'ont jamais été
// créés — le nouveau `SuperlativeAward` plus bas est un modèle distinct,
// sans lien avec `GameStatType`.
model GameStatType {
  id             String   @id @default(cuid())
  gameId         String
  key            String
  label          String
  type           StatType
  higherIsBetter Boolean  @default(true)
  createdAt      DateTime @default(now())

  // Audit trail (voir commentaire sur `User.modifiedGameStatTypes`) — un
  // seul champ (pas de createdById distinct) : ce modèle n'avait encore
  // aucune notion d'auteur avant cet ajout, donc "dernière modif" couvre
  // aussi "création" nativement, pas besoin d'un deuxième champ.
  modifiedById String
  modifiedAt   DateTime @updatedAt

  game         Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  modifiedBy   User          @relation(fields: [modifiedById], references: [id])
  superlatives Superlative[]

  @@unique([gameId, key])
}

// Un superlatif attribué automatiquement à partir d'une `GameStatType` —
// ex. "🐛 Bouffé par le grouille" (MAX sur la stat "morts" de Lethal
// Company). `xpReward` éditable par superlatif depuis /admin/jeux-stats
// (20 XP par défaut). ABANDONNÉ EN PR 5/9, laissé dormant — voir le
// commentaire sur `GameStatType` ci-dessus.
model Superlative {
  id             String          @id @default(cuid())
  gameStatTypeId String
  name           String
  rule           SuperlativeRule
  xpReward       Int             @default(20)
  createdAt      DateTime        @default(now())

  // Audit trail — même logique que `GameStatType.modifiedById` ci-dessus.
  modifiedById String
  modifiedAt   DateTime @updatedAt

  gameStatType GameStatType @relation(fields: [gameStatTypeId], references: [id], onDelete: Cascade)
  modifiedBy   User         @relation(fields: [modifiedById], references: [id])
}

// Axe 3 v2 (PR 5/9) — remplace le système par stats chiffrées ci-dessus
// (`GameStatType`/`Superlative`, laissé dormant) par un vote entre potes,
// génériques et indépendants du jeu joué : "qui mérite ce titre ce
// soir-là", zéro chiffre à saisir. Configuré depuis /admin/superlatifs —
// même philosophie que /admin/messages et /admin/jeux-stats (pas de rôle
// dédié, tout le monde peut gérer), avec le même audit trail
// `modifiedById`/`modifiedAt` que les autres modèles admin.
model SuperlativeCategory {
  id           String   @id @default(cuid())
  icon         String
  name         String
  description  String?
  xpReward     Int      @default(20)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  modifiedById String
  modifiedAt   DateTime @updatedAt

  modifiedBy User               @relation(fields: [modifiedById], references: [id])
  votes      SuperlativeVote[]
  awards     SuperlativeAward[]
}

// Un vote d'un participant pour un autre, sur une catégorie donnée d'une
// soirée. `@@unique([sessionId, categoryId, voterUserId])` : un seul vote
// par catégorie et par votant — pas de re-vote (appliqué côté serveur,
// cf. `submitSuperlativeVotesAction`). Voter pour soi-même est empêché
// côté UI (le votant n'apparaît jamais dans sa propre liste de choix) et
// re-vérifié côté serveur.
model SuperlativeVote {
  id             String   @id @default(cuid())
  sessionId      String
  categoryId     String
  voterUserId    String
  votedForUserId String
  createdAt      DateTime @default(now())

  session  Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  category SuperlativeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  voter    User                @relation("SuperlativeVoter", fields: [voterUserId], references: [id], onDelete: Cascade)
  votedFor User                @relation("SuperlativeVotedFor", fields: [votedForUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, categoryId, voterUserId])
}

// Résultat final d'une catégorie pour une soirée, calculé par
// `finalizeSuperlativeVoting` (src/lib/superlative-voting.ts) quand le
// vote se clôture. `voteCount` = nombre de votes reçus par le gagnant
// (utile pour l'affichage — "élu à 3 voix sur 4"). Pas de ligne créée
// pour une catégorie n'ayant reçu aucun vote : l'existence d'une ligne
// signifie "il y a eu au moins un vote", pas juste "la session est
// clôturée" (ce dernier état vit sur `Session.superlativeVotingClosed`).
// `@@unique([sessionId, categoryId])` : un seul gagnant par catégorie et
// par soirée.
model SuperlativeAward {
  // Provenance durable : conservée même si la soirée ou la communauté est purgée.
  // null = données historiques de default, jamais recalculée depuis le membre.
  communityId String?

  @@index([communityId])
  // Chantier nettoyage réel du stockage (V2, suite) — récompense DURABLE
  // (vitrine "Superlatifs gagnés" sur le profil, `/profil/superlatifs`,
  // `/potes/[id]/superlatifs`, la Home) : `onDelete: SetNull`, même
  // raisonnement exact que `SessionResult` ci-dessus.
  id           String   @id @default(cuid())
  sessionId    String?
  categoryId   String
  winnerUserId String
  voteCount    Int
  createdAt    DateTime @default(now())

  // Dénormalisés à la clôture du vote (`finalizeSuperlativeVoting`, où
  // `session.decidedGame`/`session.date` sont déjà connus) — mêmes raisons
  // que `SessionResult.gameName`/`sessionDate`. Backfillés pour les
  // récompenses déjà existantes (voir la migration).
  gameName    String?
  sessionDate DateTime?

  session  Session?            @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  category SuperlativeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  winner   User                @relation(fields: [winnerUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, categoryId])
}

enum Tier {
  S
  A
  B
  C
  D
}

// Tierlist perso (PR 6/9) — chaque user classe librement TOUTE la biblio
// commune (owned ou non par lui, cf. la même définition que
// `/bibliotheque/groupe` : tous les jeux avec au moins un `UserGame.owned`)
// dans une rangée S/A/B/C/D, par glisser-déposer sur `/tierlist`. Pas de
// ligne = "non classé" (pool à part dans l'UI, pas une 6e valeur d'enum —
// éviter une valeur qui ne serait qu'un "null" déguisé). Visible en
// lecture seule par les potes sur `/potes/[id]`, même esprit que la biblio
// et les dispos déjà exposées là. `@@unique([userId, gameId])` : un seul
// classement par jeu et par joueur ; reclasser un jeu déjà classé met à
// jour la ligne existante (`upsert`) plutôt que d'en empiler une nouvelle.
model TierlistEntry {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  tier      Tier
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

enum BadgeCategory {
  PARTICIPATION
  ENGAGEMENT
  BIBLIOTHEQUE
  VOTE
  SUPERLATIFS
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

// Badges automatiques (PR 7/9) — 100% passif, l'app détecte et attribue
// (jamais une action volontaire de l'utilisateur comme voter un
// superlatif). `criteria` en JSON plutôt que des colonnes dédiées : les 7
// types de critère (voir `BadgeCriteria` dans src/lib/badges.ts) ont tous
// la même forme `{ type, count }`, un schéma typé rigide n'apporterait
// rien ici — et ça laisse la porte ouverte à `/admin/badges` plus tard
// sans nouvelle migration. `xpReward` optionnel (certains badges pourront
// être purement honorifiques). `name` unique : sert de clé d'idempotence
// pour le seed (`prisma/seed-badges.mjs`), comme `MessageTemplate` n'en a
// pas besoin (il n'a pas de nom) mais `SuperlativeCategory` s'en sort
// avec un simple check d'existence en base à la place — ici un vrai
// contrainte unique est plus sûr vu que le seed tourne à chaque build.
model Badge {
  id          String        @id @default(cuid())
  name        String        @unique
  icon        String
  description String
  category    BadgeCategory
  rarity      BadgeRarity
  criteria    Json
  xpReward    Int?
  createdAt   DateTime      @default(now())

  // `active` (PR 8/9, /admin/badges) : même rôle que sur
  // `SuperlativeCategory` — un badge désactivé n'est plus jamais
  // débloqué (`unlockMatchingBadges` filtre dessus), mais n'est PAS
  // masqué de l'affichage `BadgeGrid` (encyclopédique : montrer un badge
  // "à venir mais pas encore actif" reste informatif) ni des `UserBadge`
  // déjà attribués (jamais de retrait rétroactif, cf. commentaire sur
  // `UserBadge` plus bas). Audit trail `modifiedById`/`modifiedAt` — même
  // logique que `SuperlativeCategory`/`GameStatType`.
  active       Boolean  @default(true)
  modifiedById String
  modifiedAt   DateTime @updatedAt

  modifiedBy User        @relation(fields: [modifiedById], references: [id])
  userBadges UserBadge[]
}

// Attribution d'un badge à un user. `@@unique([userId, badgeId])` : un
// badge ne se débloque qu'une fois par user (`unlockBadge`,
// src/lib/badges.ts, l'utilise comme filet de sécurité idempotent en plus
// du check applicatif "déjà débloqué ?"). Si les critères d'un `Badge`
// sont modifiés après coup (ex. seuil relevé), les `UserBadge` déjà
// créés restent : jamais de retrait rétroactif, un badge gagné reste
// gagné — cohérent avec le principe déjà appliqué au streak (badge
// "Marathon" débloqué une fois, jamais retiré si le streak retombe).
model UserBadge {
  communityId String
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId, badgeId])
  @@index([communityId, unlockedAt])
}

// Sprint 2 PR-C (U3) — notifications in-app, écrites en parallèle de
// chaque webhook Discord déjà envoyé (mêmes événements, mêmes données) :
// jamais une source de vérité à la place de Discord, juste une copie
// consultable dans l'app pour les utilisateurs qui ne regardent pas le
// salon en continu. `relatedSessionId`/`relatedBadgeId` sont des ids
// "libres" (PAS de relation Prisma/contrainte FK) — la notification doit
// rester lisible même si la session ou le badge est supprimé entre
// temps (une session peut être supprimée par son créateur, cf. PR2) ;
// le lien construit à l'affichage tombe simplement en 404 dans ce cas
// rare plutôt que de complexifier la migration avec des règles
// onDelete.
enum NotificationType {
  LEVEL_UP
  BADGE
  SESSION_RESULT
  SESSION_CREATED
  REMINDER
  // Sprint 3 (FEATURE 3) — suggestion de revanche, cf. `relatedGameId` et
  // `src/lib/revanche.ts`.
  REVANCHE
  // Sprint 3 (achievements de groupe) — voir `GroupAchievement`.
  ACHIEVEMENT
  // Sprint 4 — pronostic correct (voir `Pronostic`).
  PRONOSTIC
  // Sprint 4 — pari d'XP résolu, gagné ou perdu (voir `XpBet`).
  XP_BET
  // Amélioration des features existantes, PR-B (item 4, notifs plus
  // utiles) — récompense de superlatif gagnée (voir `SuperlativeAward`) ;
  // jusqu'ici seul le webhook Discord (`announceSessionAwards`) existait,
  // aucune notif in-app. Groupée par soirée dans `groupNotifications`
  // ("5 récompenses pour la soirée X") plutôt qu'affichée ligne par ligne.
  SUPERLATIVE_AWARD
  // Amélioration des features existantes, PR-B (item 4) — dette de gage
  // détectée (voir `Debt`/`detectDebts`), jusqu'ici sans aucune
  // notification in-app.
  DEBT
  // V2 ("Jouer maintenant") — invitation rapide à une session instantanée.
  // Créée UNE SEULE FOIS, à l'invitation initiale (voir le commentaire de
  // fichier de `instant-session-announce.ts` pour la limite assumée :
  // contrairement au MP Discord correspondant, cette ligne n'est jamais
  // éditée après coup — aucun mécanisme d'édition n'existe pour
  // `Notification` nulle part ailleurs dans cette app).
  INSTANT_SESSION_INVITE
}

model Notification {
  communityId String?

  @@index([communityId])
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  relatedSessionId String?
  relatedBadgeId   String?
  // Sprint 3 (FEATURE 3) — id "libre" (même philosophie que
  // `relatedSessionId`/`relatedBadgeId`, pas de relation Prisma) du jeu
  // concerné par une notif REVANCHE. Sert à construire le lien
  // "Proposer" (`/sessions?gameId=…`, préremplit la création de soirée
  // avec ce jeu — mécanisme déjà existant, réutilisé tel quel).
  relatedGameId    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model WebPushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Sprint 3 (FEATURE 6) — tags libres que chaque pote s'attribue lui-même
// depuis son profil (ex. "FPS", "Chill"), réutilisés à la création d'une
// soirée pour cocher d'un coup tous les potes portant un tag donné
// (`NotifyRecipientsField`). Pas de notion de propriétaire/créateur sur
// `Tag` : n'importe qui peut créer un nouveau tag depuis son profil (même
// esprit ouvert que `MessageTemplate`/`SuperlativeCategory` — pas de rôle
// admin dédié dans ce MVP), les 6 tags par défaut sont juste seedés en
// avance pour éviter que tout le monde retape "FPS" avec une casse
// différente. `name` unique (idempotence du seed, et évite les doublons
// quasi identiques créés à la volée).
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  userTags UserTag[]
}

// Attribution d'un tag à un user, en libre-service. `@@id([userId, tagId])`
// plutôt qu'un id dédié + contrainte unique : cette table n'est jamais
// référencée par sa propre clé ailleurs (pas de `UserTag.id` à pointer),
// juste lue en jointure depuis `User`/`Tag` — même choix que `UserGame`.
model UserTag {
  userId String
  tagId  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([tagId])
}

// Sprint 3 — roue du gambling en mode ASYNCHRONE : contrairement au mode
// instant (une session `Session.createdViaRoulette` créée directement, sans
// table dédiée, cf. commentaire sur ce champ), le mode async doit exister
// AVANT que le jeu ne soit décidé — les potes proposent leurs jeux à leur
// rythme, pas forcément tous en même temps. `status` suit un cycle simple
// OPEN (propositions ouvertes) → SPINNING (verrou transitoire pendant le
// calcul du gagnant, cf. `spinRouletteIfDue`/`src/lib/roulette.ts`, même
// rôle que le `updateMany` conditionné de `claimSessionClose` pour les
// sessions — évite un double tirage si le cron et un chargement de page
// paresseux se chevauchent) → DONE (gagnant tiré ET session créée, ou
// annulation silencieuse si moins de 2 potes ont proposé — même
// philosophie que "0 votant" sur une session classique).
//
// `resultGameId`/`resultSessionId` sont des ids "libres" (pas de relation
// Prisma), même choix que `Notification.relatedSessionId` : `null` tant
// que `status != DONE`, ou si la roulette a été annulée faute de
// participants. `notifiedUserIds` (même type `Json?` que
// `Session.notifiedUserIds`) porte la liste des potes INVITÉS à proposer
// — distincte de qui a réellement proposé (`RouletteEntry`), nécessaire
// pour afficher le compteur "X/Y ont proposé" et pour les mentions
// Discord. `reminderSent` : un seul rappel (deadline − 1h) suffit ici, pas
// besoin du tableau `remindersSent` façon `Session` (une seule fenêtre,
// pas plusieurs préréglages).
enum RouletteStatus {
  OPEN
  SPINNING
  DONE
}

// Refus personnel, distinct d'un veto ponctuel de soirée.
model UserGameRefusal {
  userId    String
  gameId    String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([gameId])
}

model Roulette {
  id          String         @id @default(cuid())
  createdById String
  scheduledAt DateTime
  deadline    DateTime
  status      RouletteStatus @default(OPEN)

  resultGameId    String?
  resultSessionId String?

  notifiedUserIds Json?
  reminderSent    Boolean  @default(false)
  createdAt       DateTime @default(now())

  createdBy User            @relation(fields: [createdById], references: [id])
  entries   RouletteEntry[]
  vetoes    RouletteVeto[]

  @@index([status, deadline])

  // Multi-communautés, PR7 : null = communauté par défaut (lignes historiques).
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  @@index([communityId])
}

// Une proposition de jeu d'un pote pour une roulette async — 2 lignes par
// pote une fois qu'il a fini de proposer (validé côté application, pas en
// base : rien n'empêche techniquement une 3e ligne, `submitRouletteEntryAction`
// refuse simplement si `count >= 2` déjà atteint pour ce user). Chaque
// ligne est un segment de la roue au tirage (mêmes règles qu'en mode
// instant : proposer 2x le même jeu compte pour 2 segments).
model RouletteEntry {
  id         String   @id @default(cuid())
  rouletteId String
  userId     String
  gameId     String
  createdAt  DateTime @default(now())

  roulette Roulette @relation(fields: [rouletteId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([rouletteId, userId, gameId])
}

// V2 — "Jouer maintenant" : sessions spontanées, distinctes des soirées
// planifiées (`Session`, créneau à l'avance, votes, confidentialité par
// invitation) ET de la roulette instantanée (`Roulette`, tirage d'UN jeu
// parmi des propositions). Ici : un jeu choisi directement, un groupe qui
// se forme en temps réel, une fenêtre de vie COURTE et FIXE (3h,
// `expiresAt`, jamais repoussée par une arrivée ou un changement de jeu —
// posée UNE FOIS à la création, jamais relue/recalculée). Accès :
// n'importe quel utilisateur authentifié peut voir/rejoindre librement
// (même portée qu'un tournoi — pas de confidentialité par invitation
// comme les soirées ; l'app ne modélise qu'une seule communauté, voir le
// README pour la limite assumée "pas d'isolation multi-serveur").
enum InstantSessionStatus {
  ACTIVE
  ENDED
}

model InstantSession {
  id          String                @id @default(cuid())
  createdById String
  gameId      String
  status      InstantSessionStatus  @default(ACTIVE)

  // Toujours posées explicitement par le code applicatif (`wallClockNow()`),
  // jamais `@default(now())` (horloge SQL, vrai UTC) — cohérence stricte
  // avec les intervalles de présence ci-dessous, qui utilisent la MÊME
  // source de temps pour tous leurs calculs de durée (voir le commentaire
  // de fichier de `src/lib/instant-sessions.ts`).
  createdAt DateTime
  // Fixée à la création (`createdAt` + 3h) et JAMAIS recalculée ensuite —
  // ni une arrivée, ni un changement de jeu ne la repousse (règle
  // produit explicite). Le serveur fait autorité : toute lecture/action
  // revérifie `expiresAt` contre l'heure courante AVANT d'agir, jamais un
  // simple filtre d'affichage (voir `settleInstantSessionIfDue`).
  expiresAt DateTime
  endedAt   DateTime?
  // Code court, libre (pas d'enum) : "creator_left" | "expired" — jamais
  // affiché tel quel à l'utilisateur (traduit côté UI), juste un
  // diagnostic/audit minimal.
  endedReason String?

  // Sélection "qui prévenir" au moment de l'invitation rapide — MÊME
  // philosophie que `Session.notifiedUserIds`/`Tournament.notifiedUserIds` :
  // un simple filtre de mentions (MP Discord + notification interne),
  // JAMAIS une liste d'accès ni une inscription automatique (n'importe
  // qui peut rejoindre librement, voir le commentaire de modèle
  // ci-dessus). `null` = jamais posé, `[]` = explicitement personne.
  notifiedUserIds Json?

  createdBy User                             @relation("InstantSessionCreatedBy", fields: [createdById], references: [id])
  game      Game                             @relation(fields: [gameId], references: [id])
  presence  InstantSessionPresenceInterval[]

  // Sert la liste "sessions actives" ET le passage périodique
  // (cron + paresseux) qui règle les sessions dont l'échéance est dépassée.
  @@index([status, expiresAt])

  // Multi-communautés, PR7 : null = communauté par défaut (lignes historiques).
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  @@index([communityId])
}

// Journal d'APPARTENANCE, pas un historique de "temps joué" — une ligne
// par passage (arrivée → départ), append-only, jamais réécrite après
// coup (sauf la clôture de `endedAt` au départ/à la fin). C'est la SEULE
// source de vérité pour calculer la présence conjointe (voir
// `computeCoPresenceMs`, src/lib/instant-sessions.ts) : le serveur ne
// fait JAMAIS confiance à un compteur transmis par le client, uniquement
// à ces horodatages serveur.
//
// `endedAt: null` = intervalle OUVERT (l'utilisateur est actuellement
// présent). Un utilisateur peut avoir PLUSIEURS lignes pour la même
// session (arrivée, départ, retour...) — jamais plus d'une ligne OUVERTE
// à la fois, ni pour cette session ni pour une AUTRE : un index unique
// PARTIEL (`InstantSessionPresenceInterval_userId_open_key`, posé par la
// migration, non représentable directement dans le schema Prisma —
// documenté ici et dans le fichier de migration, même limite déjà
// assumée que les deux dérives préexistantes du README) garantit AU
// NIVEAU BASE "au plus une session instantanée active par utilisateur, à
// la fois", même en cas de créations/jonctions concurrentes — jamais
// seulement une vérification applicative.
model InstantSessionPresenceInterval {
  id               String    @id @default(cuid())
  instantSessionId String
  userId           String
  startedAt        DateTime
  endedAt          DateTime?

  instantSession InstantSession @relation(fields: [instantSessionId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([instantSessionId, userId])
  @@index([instantSessionId, endedAt])
}

// Défi hebdo (Sprint 3 suite) — UNE ligne par semaine calendaire pour tout
// le groupe (pas par user), piochée au hasard parmi 15 templates fixes
// (voir `CHALLENGE_TEMPLATES`, src/lib/weekly-challenges.ts) au premier
// chargement de la Home dans cette semaine (`weekStart` = lundi 00:00,
// même convention horloge-murale que `getWeekStart`/calendar-dates.ts) —
// génération paresseuse, pas de cron dédié. `@@unique([weekStart])`
// garantit qu'une seule ligne existe par semaine même sous accès
// concurrents (idempotence par `catch` sur la contrainte, même mécanique
// que `unlockBadge`).
//
// `type` conserve le slug du template piochant ("T01".."T15") — permet de
// distinguer les défis en base sans reparser `description` si jamais le
// texte d'un template est retouché plus tard. `completedBySessionId`
// (id "libre", même famille que `Notification.relatedSessionId`) : la
// soirée qui a validé automatiquement le défi cette semaine-là, renseignée
// par `completeWeeklyChallenge` à la clôture de la soirée.
model WeeklyChallenge {
  id                   String    @id @default(cuid())
  description          String
  type                 String
  weekStart            DateTime
  completedAt          DateTime?
  completedBySessionId String?
  createdAt            DateTime  @default(now())


  // PR A : communauté requise ; les lignes historiques sont backfillées vers default.
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, weekStart])
}

// Trophée de GROUPE (Sprint 3 suite) — contrairement à `Badge`/`UserBadge`
// (individuels, une ligne de progrès par user), un `GroupAchievement` est
// débloqué UNE SEULE FOIS pour tout le groupe : `unlockedAt` nul = pas
// encore débloqué, non-nul = débloqué pour toujours (jamais retiré, même
// philosophie que les badges). Encyclopédique comme `Badge` : les 10
// lignes sont seedées à l'avance (`prisma/seed-group-achievements.mjs`,
// idempotent par `key`) puis seulement mises à jour (`unlockedAt`), jamais
// recréées — permet d'afficher "verrouillé" pour les trophées pas encore
// atteints sur la Home (cf. spec : "débloqués brillants, verrouillés
// grisés"). Vérifiés par `checkGroupAchievements` (src/lib/group-achievements.ts),
// appelée à chaque clôture de soirée (`markSessionDone`).
model GroupAchievement {
  id          String    @id @default(cuid())
  key         String
  name        String
  description String
  icon        String
  unlockedAt  DateTime?
  createdAt   DateTime  @default(now())

  // Multi-communautés, PR9 : obligatoire (communauté par défaut pour les lignes historiques),
  // fait partie de la clé.
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, key])
}

// Dette de gage (Sprint 3 suite, "Dettes/gage") — détectée automatiquement
// à la saisie des résultats d'une soirée (`submitSessionResultsAction`,
// src/app/sessions/actions.ts) : un voteur de la proposition gagnante qui
// n'a PAS été coché comme présent dans le formulaire de résultats devient
// débiteur. `reason` fige le contexte au moment de la détection (jeu +
// date), pour rester lisible même si la session est modifiée après coup.
// `gage` nullable : la dette existe dès la détection, le texte du gage est
// saisi séparément par le créateur de la session (`setDebtGageAction`) —
// pas de valeur par défaut, un gage non défini doit rester visiblement
// "à définir" plutôt que vide. `paidAt` nul = dette active (affichée sur
// la Home, badge "💀" sur le pseudo du débiteur), non-nul = soldée.
// `onDelete: Cascade` des deux côtés : une dette n'a plus de sens si la
// soirée ou l'utilisateur qui la doit disparaît.
// Chantier nettoyage réel du stockage (V2, suite) — `onDelete: Cascade`
// délibérément CONSERVÉ (une dette DÉJÀ SOLDÉE, `paidAt` non-nul, n'est
// plus jamais lue nulle part au-delà de la Home des dettes ACTIVES — voir
// `src/lib/debts.ts`, aucune page "historique des dettes payées" —
// disparaître avec la soirée est correct pour elle). En revanche, une
// dette ENCORE ACTIVE (`paidAt: null`) est une obligation NON RÉSOLUE :
// `src/lib/retention.ts` (`sessionPurgeEligibility`) la traite comme un
// BLOCAGE explicite de la purge de sa soirée, jamais une suppression
// silencieuse d'un gage jamais soldé.
model Debt {
  id        String    @id @default(cuid())
  debtorId  String
  sessionId String
  reason    String
  gage      String?
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  debtor  User    @relation(fields: [debtorId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Multi-communautés, PR7 : null = communauté par défaut (lignes historiques).
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  @@index([communityId])
}

// Chantier nettoyage réel du stockage (V2, suite) — résumé durable
// MINIMAL (un seul entier à ce jour) pour un critère de badge qui compte
// aujourd'hui des lignes `TournamentParticipant` VOUÉES à disparaître
// avec leur `Tournament` (aucune autre lecture durable n'en dépend, voir
// le README — contrairement à `SessionResult`/`SuperlativeAward`/
// `Pronostic`/`XpBet`, aucun découplage de `Tournament` n'était
// nécessaire/possible ici). Maintenu à l'INSCRIPTION/DÉSINSCRIPTION
// (`registerForTournamentAction`/`unregisterFromTournamentAction`,
// src/app/tournois/actions.ts) — jamais recalculé par un `count()` sur
// des lignes qui peuvent disparaître, exactement la même philosophie que
// `XpEvent` (ledger append-only) déjà utilisée partout ailleurs pour les
// critères de badge. `TOURNAMENTS_WON` n'a PAS besoin d'un champ ici : il
// se déduit déjà durablement de `XpEvent` (`reason: "TOURNAMENT_RESULT"`,
// `sourceId` se terminant par `:1st"`), voir `src/lib/badges.ts`.
model UserLifetimeStats {
  userId                       String @id
  // "Gladiateur" (5 tournois joués, gagnés ou non) — compte TOUTE
  // inscription encore active au moment de la lecture, jamais réduit par
  // la purge d'un tournoi terminé depuis longtemps (contrairement à
  // l'ancien `tournamentParticipant.count({userId})`).
  tournamentsParticipatedCount Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// PR B : progression durable propre à un serveur. Aucune FK vers Community :
// supprimer un serveur ne supprime/réattribue jamais ses récompenses historiques.
model CommunityMemberStats {
  communityId String
  userId String
  xpTotal Int @default(0)
  streakCount Int @default(0)
  streakLastActiveAt DateTime?
  bestStreakCount Int @default(0)
  tournamentsParticipatedCount Int @default(0)
  equippedTitleId String?
  equippedFrameId String?
  equippedColorId String?
  cosmetics CommunityMemberCosmetic[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([communityId, xpTotal])
  @@index([communityId, streakLastActiveAt])
}

model GameStyleProfile {
  communityId String
  userId String
  tryharder Int @default(0)
  ambianceur Int @default(0)
  stratege Int @default(0)
  chaos Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
}

model CommunityMemberCosmetic {
  communityId String
  userId String
  itemId String
  purchasedAt DateTime @default(now())

  stats CommunityMemberStats @relation(fields: [communityId, userId], references: [communityId, userId], onDelete: Cascade)

  @@id([communityId, userId, itemId])
}

// Chantier nettoyage réel du stockage (V2, suite) — résumé durable MINIMAL
// pour "Stats du groupe" (Home, `src/lib/home.ts::getGroupStats`), qui
// comptait jusqu'ici `Session.count({status:"DONE"})`/`Session.groupBy`
// sur des lignes désormais purgeables. AUCUNE ancienne soirée n'est
// conservée pour ça — seuls deux compteurs, incrémentés UNE SEULE FOIS
// par soirée, exactement au moment `SCHEDULED → DONE`
// (`markSessionDone`, `src/lib/sessions.ts` — seul point d'écriture de ce
// statut dans tout le code, transaction atomique avec l'incrément :
// jamais retouchés par la purge elle-même, donc aucune re-dérivation
// depuis des lignes vivantes après coup et aucun risque de double compte
// entre soirées encore présentes et soirées déjà purgées, y compris en
// cas d'exécution concurrente de `markSessionDone` (le `updateMany`
// conditionnel sur `status: "SCHEDULED"` sérialise déjà les appelants
// concurrents — un seul incrémente jamais). Portée et fenêtre de calcul
// identiques à l'existant avant ce chantier : total À VIE (aucune fenêtre
// de saison), TOUTES les soirées DONE sans filtre de confidentialité
// (déjà la règle en vigueur pour les agrégats de groupe — voir chantier
// confidentialité §9, "agrégats globaux non filtrés par soirée" —
// inchangée ici, jamais durcie ni assouplie par ce chantier).
model GroupSessionStats {
  // Ligne singleton (mêmes fondations que `CronLock.name`) — un seul
  // compteur global, jamais par utilisateur/par saison.
  id                  String @id @default(cuid())
  totalSessionsPlayed Int    @default(0)

  // Multi-communautés, PR9 : obligatoire (communauté par défaut pour les lignes historiques),
  // fait partie de la clé.
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId])
}

// Un compteur par jeu — jamais un historique des soirées qui l'ont joué.
// "Jeu le plus joué" se déduit d'un simple tri par `playCount` desc,
// `name`/`coverUrl` restent lus depuis `Game` (jamais dénormalisés ici :
// `Game` elle-même n'est jamais purgée par ce chantier, une jointure
// reste fiable à 100%).
model GroupGameStat {
  gameId           String
  playCount        Int    @default(0)
  totalPlayMinutes Int    @default(0)

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  // Multi-communautés, PR9 : obligatoire (communauté par défaut pour les lignes historiques),
  // fait partie de la clé.
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([communityId, gameId])
}

// Chantier nettoyage réel du stockage (V2, suite — closes #107) — résumé
// durable MINIMAL pour le trophée de groupe "Réguliers" (4 semaines
// calendaires CONSÉCUTIVES avec ≥1 soirée DONE, `checkGroupAchievements`,
// src/lib/group-achievements.ts). AUCUN agrégat durable existant
// (`GroupSessionStats`/`GroupGameStat`/`XpEvent`) ne porte de signal PAR
// SEMAINE pour CHAQUE soirée DONE (contrairement à "diversité"/"squad",
// réparés sans nouveau schéma) : une ligne par semaine calendaire ayant
// eu au moins une soirée DONE, jamais une ligne par soirée. Écrite une
// seule fois par semaine (upsert idempotent, plusieurs soirées la même
// semaine ne créent qu'une ligne), au même point que
// `GroupSessionStats`/`GroupGameStat` (`markSessionDone`,
// src/lib/sessions.ts) — jamais retouchée par la purge, donc jamais
// perdue quelle que soit l'ancienneté des soirées qui l'ont produite.
model GroupActiveWeek {
  // Lundi 00:00 UTC de la semaine (même calcul que `getWeekStart`,
  // src/lib/calendar-dates.ts) — clé naturelle, une ligne par semaine.
  weekStart DateTime

  // Multi-communautés, PR9 : obligatoire (communauté par défaut pour les lignes historiques),
  // fait partie de la clé.
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([communityId, weekStart])
}

// Sprint 4 (FEATURE 2, Recap mensuel Wrapped) — snapshot figé du mois
// précédent, généré au 1er passage du cron `monthly-tasks` sur ou après le
// 1er du mois (`generateMonthlyRecapIfDue`, src/lib/monthly-recap.ts).
// `@@unique([year, month])` : idempotent — un mois déjà recapé n'est
// jamais recalculé (le recap est un instantané, pas une vue vivante, pour
// que /recap/[year]/[month] reste identique même après coup si les stats
// sous-jacentes changeaient). `data` en JSON libre plutôt que des colonnes
// dédiées : la forme suit `MonthlyRecapData` (src/lib/monthly-recap.ts),
// display-only, jamais requêtée par champ.
model MonthlyRecap {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  data      Json
  createdAt DateTime @default(now())


  // PR A : communauté requise ; les lignes historiques sont backfillées vers default.
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, year, month])
}

// Sprint 4 (FEATURE 3, Saisons mensuelles) — reset mensuel du classement
// XP. Une seule saison `isActive` par communauté (invariant applicatif, pas de
// contrainte DB dédiée — `finalizeSeasonIfDue`, src/lib/seasons.ts, est le
// seul point d'écriture). `number` incrémental par communauté, `name`
// dérivé ("Saison N") mais stocké en dur pour rester affichable même si la
// formule de nommage change plus tard. Saison 1 bootstrapée par
// `prisma/seed-season.mjs` au déploiement, SANS reset rétroactif (scores
// actuels conservés comme tête de départ, cf. spec).
model Season {
  id        String   @id @default(cuid())
  number    Int
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)

  snapshots SeasonSnapshot[]

  // PR A : communauté requise ; les lignes historiques sont backfillées vers default.
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, number])
}

// Classement figé d'un user à la clôture d'une saison — écrit par
// `finalizeSeasonIfDue` juste avant le reset de `User.xpTotal`, seule
// façon de consulter "qui était où" une fois le classement remis à zéro.
// `position === 1` = champion de la saison (affiché "🏆 Champion Saison N"
// sur /profil/saisons et /saisons) — pas un `Badge`/`UserBadge` : le
// système de badges (critères `{ type, count }` à seuil cumulatif) ne
// modélise pas "était 1er à un instant T", c'est une notion par saison,
// pas un cumul statistique.
model SeasonSnapshot {
  id       String @id @default(cuid())
  seasonId String
  userId   String
  xp       Int
  level    Int
  rank     String
  position Int

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
}

// Sprint 5 (FEATURE 1, Tournois Bracket) — élimination directe entre
// potes. `maxPlayers` limité à {4, 6, 8} côté formulaire (pas de valeur
// arbitraire) : détermine `bracketSize` (prochaine puissance de 2 ≥
// maxPlayers — 4→4, 6→8, 8→8), calculé côté application
// (src/lib/tournaments.ts), jamais stocké. Un bracket à 6 joueurs tourne
// sur une structure à 8 slots avec des "byes" (2 slots vides, résolus
// immédiatement au tirage — cf. `generateBracket`).
enum TournamentStatus {
  REGISTRATION
  IN_PROGRESS
  DONE
  // V2 — tournoi DÉMARRÉ (IN_PROGRESS) interrompu par son créateur : les
  // matchs/résultats déjà enregistrés restent intacts (aucune donnée
  // supprimée), seule la progression s'arrête. Jamais atteignable depuis
  // DONE (un tournoi terminé garde son historique, non annulable) ; un
  // tournoi encore en REGISTRATION se SUPPRIME au lieu de passer par cet
  // état (rien à préserver avant le premier match) — voir
  // `cancelTournament`/`deleteTournament`, src/lib/tournaments.ts.
  CANCELLED
}

model Tournament {
  id          String           @id @default(cuid())
  name        String
  createdById String
  gameId      String
  status      TournamentStatus @default(REGISTRATION)
  maxPlayers  Int
  createdAt   DateTime         @default(now())

  // Dénormalisé, posé par `finalizeTournament` (src/lib/tournaments.ts) en
  // même temps que `status = DONE` — évite d'avoir à retrouver "le match
  // de la finale" (le round le plus élevé, variable selon `maxPlayers`)
  // à chaque lecture pour savoir qui a gagné (affichage, badges).
  championId String?

  createdBy    User                    @relation(fields: [createdById], references: [id])
  game         Game                    @relation(fields: [gameId], references: [id])
  champion     User?                   @relation("TournamentChampion", fields: [championId], references: [id])
  participants TournamentParticipant[]
  matches      TournamentMatch[]
  predictions  TournamentPrediction[]

  // Chantier annonces Discord tournois (#🏆-tournois, après #95/#96/#97/#98/#99)
  // — même contrat que `Session.announceViaBot` (voir son commentaire pour
  // le raisonnement complet) : décision figée UNE SEULE FOIS, à la création
  // de CE tournoi précis, selon `DISCORD_BOT_TOURNAMENT_ANNOUNCE_ENABLED` à
  // ce moment-là (`src/lib/discord-bot-config.ts`). `false` = chemin webhook
  // existant (`postToDiscord` dans `createTournamentAction`/
  // `announceTournamentFinalization`, inchangés), `true` = chemin bot
  // exclusif (`src/lib/tournament-announce.ts`), jamais les deux. Jamais
  // relu depuis la variable d'env après la création — un tournoi déjà
  // annoncé sur un canal donné reste sur CE canal. `@default(false)` : tout
  // tournoi créé avant cette colonne reste silencieusement sur le webhook.
  announceViaBot Boolean @default(false)

  // Revue ciblée avant merge #100 — destination Discord figée UNE SEULE
  // FOIS, en même temps que `announceViaBot`, à la création de CE tournoi
  // précis (jamais relue depuis l'env ensuite, y compris avant le tout
  // premier SEND) : `null`/`null` pour un tournoi webhook, sinon la copie
  // EXACTE de `DISCORD_BOT_GUILD_ID`/`DISCORD_BOT_TOURNAMENT_CHANNEL_ID`
  // lue au moment de la création. Le résolveur (`tournament-announce.ts`)
  // utilise TOUJOURS ces colonnes pour le premier SEND (vérifié via un GET
  // réel avant tout envoi, voir `verifyChannelDestination`/
  // `sendChannelMessageVerified`, discord-rest.ts) — jamais
  // `getTournamentAnnounceConfig()` pour la destination elle-même
  // (seulement pour la porte d'activation globale de la catégorie). Les
  // éditions/messages de fil qui suivent utilisent ensuite la référence du
  // message RÉELLEMENT créé (persistée sur la livraison via
  // `discordChannelId`), jamais ces colonnes ni l'env à nouveau — élimine
  // structurellement tout mélange entre une ancienne annonce et un nouveau
  // salon, y compris un changement de configuration survenu avant le tout
  // premier envoi.
  discordGuildId   String?
  discordChannelId String?

  // Multi-communautés, PR3 : communauté du tournoi (même contrat que
  // `Session.communityId` : `null` = communauté par défaut). La destination
  // Discord figée ci-dessus est calculée pour CETTE communauté à la création.
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  @@index([communityId])

  // V2 (notifications maîtrisées + annulation/suppression) — ping sélectif
  // à la création : liste des ids de potes à MENTIONNER dans l'annonce
  // Discord, jamais une liste d'accès ni des participants automatiquement
  // inscrits (un tournoi reste consultable/inscriptible par tout le monde,
  // selon les règles d'accès actuelles — aucun lien avec la confidentialité
  // des soirées, volontairement non transposée ici). Même contrat EXACT que
  // `Session.notifiedUserIds` (voir son commentaire pour le raisonnement
  // complet sur `Json?` vs `String[]?`, et le sens de `null` vs tableau
  // vide) : `null` pour tout tournoi créé avant cette colonne (comportement
  // préservé, jamais de mentions), un tableau JSON (même vide) est une
  // sélection explicite respectée littéralement.
  notifiedUserIds Json?

  // Annulation/suppression (V2) — posé par `cancelTournament`
  // (src/lib/tournaments.ts) en même temps que `status: CANCELLED`, pour
  // affichage ("annulé le ..."). `null` tant que le tournoi n'a jamais été
  // annulé ; jamais réutilisé pour autre chose (une suppression d'un
  // tournoi non démarré retire la ligne elle-même, aucun statut à marquer).
  cancelledAt DateTime?
}

// `seed` : ordre de tirage aléatoire au lancement du tournoi (pas de
// classement par XP, cf. spec) — posé par `generateBracket`, pas à
// l'inscription (`seed` vaut 0 tant que le tournoi est en REGISTRATION).
// `eliminatedAt` : posé dès la perte du premier match, purement informatif
// pour l'affichage ("éliminé") — la position réelle dans le bracket vit
// sur `TournamentMatch`, pas ici.
model TournamentPrediction {
  id String @id @default(cuid())
  communityId String
  tournamentId String
  voterId String
  predictedUserId String
  // "champion" ou identifiant de match ; une seule cible immuable par voteur.
  target String
  createdAt DateTime @default(now())
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, target, voterId])
  @@index([communityId])
}

model TournamentParticipant {
  id           String    @id @default(cuid())
  tournamentId String
  userId       String
  seed         Int       @default(0)
  eliminatedAt DateTime?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

// Un match du bracket. `round` 1-indexé (1 = premier tour, ex.
// quarts pour un bracket à 8) ; `position` 0-indexée au sein du round
// (2 matchs du round N convergent vers 1 match `position = position/2`
// du round N+1 — `advanceWinner`, src/lib/tournaments.ts). TOUS les
// matchs de TOUS les rounds sont créés d'un coup par `generateBracket`
// (round 1 avec les joueurs déjà connus, rounds suivants avec
// `player1Id`/`player2Id` null, remplis au fur et à mesure) — le bracket
// entier existe dès le lancement, jamais généré round par round.
// `player1Id`/`player2Id` null = "bye" (moins de joueurs que de slots) ou
// "en attente du round précédent". `winnerId` non-null + `completedAt`
// = résolu.
model TournamentMatch {
  id           String    @id @default(cuid())
  tournamentId String
  round        Int
  position     Int
  player1Id    String?
  player2Id    String?
  winnerId     String?
  scheduledAt  DateTime?
  completedAt  DateTime?
  // Scores optionnels (TOURNAMENT_SCORES_ENABLED) : player1 / player2.
  score1       Int?
  score2       Int?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1    User?      @relation("TournamentMatchPlayer1", fields: [player1Id], references: [id])
  player2    User?      @relation("TournamentMatchPlayer2", fields: [player2Id], references: [id])
  winner     User?      @relation("TournamentMatchWinner", fields: [winnerId], references: [id])

  @@unique([tournamentId, round, position])
}

// Sprint 5 (FEATURE 2, Chat in-app) — messagerie POLLING (PAS de
// websockets : Vercel Hobby ne supporte pas les connexions persistantes,
// cf. spec) : le client relit `getChatMessagesAction` toutes les 10s
// (src/components/chat/ChatMessages.tsx). `sessionId` null = canal
// global, sinon canal dédié à une soirée — même table pour les deux,
// filtrée par `sessionId`. `content` validé à 500 caractères max côté
// zod (src/lib/validations.ts), jamais tronqué en base. Les messages ne
// sont jamais supprimés (juste plus affichés au-delà de 200, cf.
// `getChatMessages`) — pas de `deletedAt`, l'énoncé ne demande pas de
// modération.
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  sessionId String?
  content   String
  createdAt DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   Session?       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reactions ChatReaction[]

  @@index([sessionId, createdAt])

  // Multi-communautés, PR7 : null = communauté par défaut (lignes historiques).
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  @@index([communityId])
}

// Une réaction par personne par message (`@@unique`, cf. énoncé) —
// reproposer une réaction DIFFÉRENTE remplace la précédente (upsert),
// retaper la MÊME la retire (toggle) — cf. `toggleReactionAction`.
model ChatReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

// Sprint 5 (FEATURE 3, Wishlist V17) — jeux que le groupe aimerait
// acheter, proposés puis votés. `@@unique([gameId])` : un jeu ne peut
// avoir qu'UNE seule entrée wishlist à la fois — proposer un jeu déjà
// présent revient à voter dessus plutôt qu'à dupliquer la carte.
// `purchasedById`/`purchasedAt` posés par `checkWishlistPurchases`
// (src/lib/wishlist.ts), appelée après chaque import Steam réussi (cron
// ET réimport manuel) : dès qu'un membre possède désormais ce jeu, la
// wishlist se met à jour toute seule, jamais un état à cocher à la main.
model GameWishlist {
  id            String    @id @default(cuid())
  gameId        String
  proposedById  String
  reason        String?
  createdAt     DateTime  @default(now())
  purchasedById String?
  purchasedAt   DateTime?

  game        Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  proposedBy  User               @relation("WishlistProposedBy", fields: [proposedById], references: [id])
  purchasedBy User?              @relation("WishlistPurchasedBy", fields: [purchasedById], references: [id])
  votes       GameWishlistVote[]


  // Multi-communautés, PR9 : obligatoire (communauté par défaut pour les lignes historiques),
  // fait partie de la clé.
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, gameId])
}

// `interested` : true = "Intéressé 👍", false = "Pas pour moi 👎" —
// toujours un vote explicite des deux côtés (pas de valeur par défaut
// implicite), `@@unique([wishlistId, userId])` pour qu'un revote change
// juste la valeur existante (upsert) plutôt que d'en empiler une deuxième.
model GameWishlistVote {
  id         String   @id @default(cuid())
  wishlistId String
  userId     String
  interested Boolean
  createdAt  DateTime @default(now())

  wishlist GameWishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, userId])
}

// Fix bug remonté (F7, rappels Discord en double) — verrou global pour
// qu'au plus une exécution du cron `reminders` envoie des rappels à la
// fois, même si deux exécutions se chevauchent (cron externe qui
// redéclenche avant la fin d'un run précédent, retry côté cron-job.org...).
// Une seule ligne singleton (`name = "reminders"`), créée par la migration
// qui introduit ce modèle (`prisma migrate deploy`, exécutée avant tout
// déploiement — voir cette migration) et jamais par le seed
// quotidien/décorrélé (`runSeedReconciliation`) : la route ne doit jamais
// pouvoir démarrer avant que cette ligne existe. `token` identifie
// l'exécution qui détient le verrou — une exécution ne peut libérer QUE
// son propre verrou (comparaison sur `token`), jamais celui d'une
// exécution plus récente qui aurait déjà repris la main après expiration
// du bail (`lockedAt` trop ancien, voir `src/lib/cron-lock.ts`). Limites
// assumées, documentées dans le code et le README (pas de garantie
// "exactement une fois", impossible côté webhook Discord) : un doublon
// reste possible si le traitement dépasse le bail, et un rappel peut
// rester manqué si le prochain run réussi arrive après la date de la
// session concernée.
model CronLock {
  name     String    @id
  lockedAt DateTime?
  token    String?
}

// Refonte notifications Discord — fondations de livraison (PR 1/N,
// AUCUN appelant actuel n'écrit ici, voir `src/lib/notification-delivery.ts`
// pour les garanties exactes et le README pour la procédure de validation).
// Sépare "ce qui s'est passé" (`NotificationEvent`, une fois par occurrence
// métier — création de soirée, changement de jeu d'une session instantanée,
// récap quotidien d'un joueur...) de "où ça part" (`NotificationDelivery`,
// une ligne par destinataire × canal × opération). Un même événement peut
// produire plusieurs livraisons visant des `targetSlot` DIFFÉRENTS (ex.
// éditer l'annonce ET poster dans son fil) qui ne se bloquent jamais l'une
// l'autre ; en revanche, toutes les opérations visant le MÊME `targetSlot`
// (SEND/EDIT/ARCHIVE confondus) s'excluent mutuellement — voir le
// commentaire sur `targetSlot` ci-dessous.
enum NotificationCategory {
  SESSION
  TOURNAMENT
  REWARD
  ACHIEVEMENT
  RECAP
  INSTANT_SESSION
  ADMIN
  // V2 (MP roulette) — voir la migration `20260930160000_add_roulette_notification_category`.
  ROULETTE
}

// Catégories réellement pilotables aujourd'hui depuis le profil. Cet enum
// reste volontairement plus petit que `NotificationCategory` : afficher un
// réglage qui n'est pas encore appliqué par tous les chemins donnerait un
// faux sentiment de contrôle.
enum UserNotificationCategory {
  SESSION
  ROULETTE
  // V2 (tournois) — gouverne les mentions Discord de création de tournoi
  // ET les futures sollicitations personnelles liées aux tournois. Aucune
  // ligne `UserNotificationPreference` n'existait pour cette catégorie
  // avant son introduction (elle n'existait tout simplement pas) — voir la
  // migration `20260922090000_add_tournament_notifications` pour le
  // backfill explicite (`enabled = NOT silenceReminders`, même règle que
  // SESSION/ROULETTE à leur propre introduction) : un compte ayant déjà
  // demandé le silence global ne reçoit jamais une réactivation silencieuse
  // pour cette nouvelle catégorie.
  TOURNAMENT
  // V2 ("Jouer maintenant") — gouverne le MP Discord + la notification
  // interne d'invitation rapide à une session instantanée. Distincte de
  // SESSION à dessein (règle produit explicite : distinguer clairement
  // cette fonctionnalité des soirées planifiées) — un compte peut vouloir
  // les soirées planifiées mais pas les pings spontanés, ou l'inverse.
  // Même backfill EXACT que TOURNAMENT à son introduction (migration
  // `20260926090002_backfill_instant_session_notification_preferences`) :
  // `enabled = NOT silenceReminders`, jamais une réactivation silencieuse
  // pour un compte ayant déjà demandé le silence global.
  INSTANT_SESSION
}

model UserNotificationPreference {
  userId    String
  category  UserNotificationCategory
  enabled   Boolean                  @default(true)
  updatedAt DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
}

// Destination logique d'une livraison, indépendante du transport réellement
// utilisé (`DeliveryTransport`) — une livraison DISCORD_CHANNEL part en
// webhook aujourd'hui, en bot demain, sans que cette valeur change.
enum DeliveryChannel {
  DISCORD_CHANNEL
  DISCORD_DM
  IN_APP
}

// Transport Discord choisi pour CETTE livraison précise — jamais les deux à
// la fois pour une même ligne (voir commentaire sur
// `NotificationDelivery.transport`). Condition nécessaire à la migration
// progressive webhook → bot décidée pour ce chantier : chaque notification
// part par un seul chemin, ce qui rend la bascule catégorie par catégorie
// possible sans double-envoi.
enum DeliveryTransport {
  WEBHOOK
  BOT
}

// SEND crée un nouveau message pour un `targetSlot` — exactement une fois
// par cible (l'appelant ne doit enqueuer qu'un seul SEND par `targetSlot`
// sur toute sa durée de vie). EDIT modifie le message déjà envoyé pour le
// MÊME `targetSlot` — ne devient réclamable qu'une fois le SEND
// correspondant `SENT` (voir `claimNextDelivery`, qui résout et renvoie la
// référence du message ciblé). ARCHIVE, même dépendance qu'EDIT, réservé
// aux opérations de clôture qui ne sont ni un envoi ni une édition de
// contenu (ex. verrouillage d'un fil) — non utilisé par cette PR, juste
// réservé pour ne pas re-migrer l'enum plus tard.
enum DeliveryOperation {
  SEND
  EDIT
  ARCHIVE
}

// RESERVED = en cours de traitement par un propriétaire précis, identifié
// par `reservationToken` (PAS par `reservedBy`, voir son commentaire),
// borné dans le temps (`reservedUntil`) — voir `notification-delivery.ts`
// pour le cycle claim/send/finalize complet.
enum DeliveryStatus {
  PENDING
  RESERVED
  SENT
  FAILED
  SKIPPED
}

model NotificationEvent {
  communityId String?
  payload Json?

  @@index([communityId])
  id String @id @default(cuid())

  category   NotificationCategory
  // Identifiant libre de type d'événement (ex. "SESSION_CREATED",
  // "REWARD_DAILY_RECAP", "INSTANT_SESSION_GAME_CHANGED") — pas d'enum : les
  // types d'événements des futures PR (salons, récaps, sessions instantanées)
  // ne sont pas tous connus aujourd'hui, et un enum Prisma se migre plus
  // difficilement qu'une valeur applicative validée côté code.
  eventType  String
  // Id "libre" de l'entité métier à l'origine de l'événement (sessionId,
  // tournamentId, userId pour un récap...) — même philosophie que
  // `Notification.relatedSessionId` : pas de relation Prisma/FK, cet
  // événement doit rester lisible même si l'entité source est supprimée
  // depuis.
  sourceId   String
  // Distingue deux occurrences du même (category, eventType, sourceId) —
  // ex. la date du jour pour un récap quotidien, ou un compteur de
  // modification pour une soirée éditée plusieurs fois. Chaîne vide par
  // défaut quand une seule occurrence a jamais de sens pour ce eventType.
  occurrence String               @default("")

  createdAt DateTime @default(now())

  deliveries NotificationDelivery[]

  // Idempotence de l'événement lui-même : un appelant qui déclenche deux
  // fois la même occurrence métier (retry applicatif, double clic protégé
  // par ailleurs...) ne doit jamais créer un second événement — à charge de
  // l'appelant de gérer un upsert sur cette clé.
  @@unique([category, eventType, sourceId, occurrence])
}

model NotificationDelivery {
  id      String @id @default(cuid())
  eventId String

  // Compteur global auto-incrémenté par Postgres (SERIAL) — jamais par
  // l'application. Sert UNIQUEMENT à départager, pour un même
  // (targetSlot, operation), quelle livraison est la plus récente sans
  // avoir besoin d'un compteur par cible ni d'un verrou dédié : l'ordre
  // d'insertion Postgres est atomique et total, contrairement à `createdAt`
  // qui peut être égal entre deux lignes créées dans la même milliseconde.
  // `Int` (pas `BigInt`) volontairement : un milliard de livraisons est hors
  // d'atteinte pour ce volume d'utilisateurs, et ça évite la friction
  // `bigint` JS (sérialisation JSON, comparaisons) dans tout le code appelant
  // pour un bénéfice nul ici.
  sequence Int @default(autoincrement())

  channel   DeliveryChannel
  // Choisi à la création de la livraison (routage décidé par l'appelant,
  // pas par ce modèle) — voir enum ci-dessus. Jamais modifié après coup :
  // une bascule webhook → bot crée de nouvelles livraisons, ne réutilise
  // pas une ligne existante avec un transport différent.
  transport DeliveryTransport
  operation DeliveryOperation @default(SEND)

  // "user:<id>" ou "guild:category:<category>" selon le cas — jamais NULL
  // (bug corrigé avant toute migration : une colonne nullable à l'intérieur
  // d'une contrainte unique Postgres ne déduplique rien, NULL ≠ NULL).
  recipientKey String
  // Identifie LE message Discord physique ciblé — une valeur = un message
  // (ou un fil) précis, jamais partagée entre deux messages distincts.
  // Portée obligatoire du format (pas de FK `Guild` dans cette PR, donc pas
  // de garantie DB — c'est un contrat applicatif à respecter par tout
  // appelant) : `<guildId>:<category>:<sourceId>:<rôle>`, où `<rôle>`
  // distingue les différents messages produits par un même événement/une
  // même entité source (ex. "announce" vs "thread" pour une soirée,
  // "reminder-1h" vs "reminder-1d" pour deux rappels DISTINCTS de la même
  // soirée — jamais le même `targetSlot`, sous peine de les traiter comme
  // des révisions successives du même message). `<guildId>` (littéral
  // `"default-guild"` en attendant un vrai modèle `Guild`, PR future)
  // évite toute collision si plusieurs serveurs Discord existent un jour.
  // Exemples : "default-guild:SESSION:session123:announce",
  // "default-guild:SESSION:session123:thread",
  // "default-guild:SESSION:session123:reminder-1h".
  //
  // SEND, EDIT et ARCHIVE visant le MÊME `targetSlot` s'excluent
  // mutuellement (au plus une livraison RESERVED à la fois par
  // `targetSlot`, toutes opérations confondues — voir `claimNextDelivery`
  // dans notification-delivery.ts) : ce sont trois opérations sur le MÊME
  // message physique, qui ne peuvent pas progresser en parallèle sans
  // risquer un envoi/une édition concurrente incohérente. Deux
  // `targetSlot` différents (ex. annonce et fil d'une même soirée) restent
  // entièrement indépendants et progressent en parallèle.
  targetSlot   String

  status           DeliveryStatus @default(PENDING)
  // Étiquette informative (logs/observabilité) du worker/de la requête qui
  // détient la réservation — PAS la garantie de sécurité elle-même (voir
  // `reservationToken`). Un worker peut légitimement réutiliser le même
  // identifiant `reservedBy` d'une réservation à l'autre (redémarrage,
  // identifiant statique...) sans que ça ne permette de finaliser une
  // réservation qui ne lui appartient plus.
  reservedBy       String?
  // Jeton unique généré à CHAQUE réservation réussie (`crypto.randomUUID`,
  // jamais choisi par l'appelant) — c'est LUI qui protège une finalisation
  // tardive contre une réservation déjà réattribuée, y compris si
  // `reservedBy` est réutilisé à l'identique par un nouveau worker : deux
  // réservations successives de la même ligne ont TOUJOURS des jetons
  // différents, donc un finalize avec un jeton périmé ne peut jamais
  // correspondre à la réservation courante (voir `finalizeDelivery*` dans
  // notification-delivery.ts).
  reservationToken String?
  reservedUntil    DateTime?
  attempts         Int            @default(0)
  lastError        String?
  errorClass       String?
  nextAttemptAt    DateTime?

  discordMessageId String?
  discordChannelId String?
  discordThreadId  String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  event NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Idempotence de la livraison : ré-enqueue la même intention (même
  // événement, même destinataire, même canal, même opération, même cible)
  // ne crée jamais de doublon — à charge de l'appelant d'upserter dessus.
  @@unique([eventId, channel, recipientKey, operation, targetSlot])
  // Sert la sélection des candidats PENDING/FAILED dus, par ordre
  // d'ancienneté.
  @@index([status, nextAttemptAt])
  // Sert la vérification d'exclusivité par cible au moment du claim (aucune
  // autre livraison RESERVED sur le même targetSlot, toutes opérations
  // confondues) et le lookup du SEND déjà envoyé dont une EDIT/ARCHIVE
  // dépend.
  @@index([targetSlot, status])
  // Sert le rattrapage des livraisons dépassées par une plus récente
  // (même targetSlot + même operation, voir `claimNextDelivery`).
  @@index([targetSlot, operation, status, sequence])
  // Sert le balayage de récupération des réservations expirées.
  @@index([reservedUntil])
}

// =============================================================================
// Multi-communautés — PR A (expand uniquement). Un serveur Discord = une
// communauté isolée. Ces tables s'ajoutent sans toucher à l'existant : aucun
// modèle collectif ne porte encore de `communityId` (PR suivantes). Voir le
// README, section « Architecture multi-communautés ».
// =============================================================================

// PENDING : créée à l'ajout du bot, en attente d'activation par un admin
// plateforme. LEFT : bot retiré du serveur (purge après 30 jours via la
// rétention). ARCHIVED : fermée volontairement.
enum CommunityStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LEFT
  ARCHIVED
}

enum CommunityRole {
  OWNER
  ADMIN
  MEMBER
}

enum CommunityDateKind {
  BIRTHDAY
  IMPORTANT
}

enum MembershipStatus {
  ACTIVE
  LEFT
  REMOVED
}

// Catégories de salons configurables par communauté : les deux qui existent
// aujourd'hui en variables d'environnement (`DISCORD_BOT_SESSION_CHANNEL_ID`,
// `DISCORD_BOT_TOURNAMENT_CHANNEL_ID`). Ajouter une valeur reste additif.
enum CommunityChannelCategory {
  SESSION
  TOURNAMENT
  VOICE
}

model Community {
  quickPolls CommunityQuickPoll[]
  quickPollVotes CommunityQuickPollVote[]
  gameEpitaphs CommunityGameEpitaph[]
  expressions CommunityExpression[]
  highlights CommunityHighlight[]
  availabilityPolls SessionAvailabilityPoll[]
  dates CommunityDate[]
  sessionRatings SessionRating[]
  id   String @id @default(cuid())
  // Segment d'URL `/c/[slug]/…` (PR suivante). `default` = la communauté
  // historique, créée par `ensureDefaultCommunity` (src/lib/default-community.ts).
  slug String @unique
  name String
  fairPlayCharter String? @db.Text
  guideRules String? @db.Text
  guideContacts String? @db.Text
  freeGamesEnabled Boolean @default(false)

  // Null seulement pour la communauté par défaut tant que
  // `DISCORD_BOT_GUILD_ID` n'est pas renseignée.
  discordGuildId String?         @unique
  iconHash       String?
  status         CommunityStatus @default(PENDING)

  // Qui a ajouté le bot (le payload `APPLICATION_AUTHORIZED` ne porte que
  // l'utilisateur ; Discord exige `MANAGE_GUILD` pour une installation serveur).
  installedByDiscordId String?
  activatedAt          DateTime?
  activatedById        String?
  // Départ du bot : point de départ des 30 jours de conservation.
  leftAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships    Membership[]
  channelConfigs CommunityChannelConfig[]
  sessions       Session[]
  tournaments    Tournament[]

  @@index([status])

  // Multi-communautés, PR7 : lignes rattachées aux modèles collectifs racines.
  chatMessages ChatMessage[]
  debts Debt[]
  wishlistGames GameWishlist[]
  sessionVetoes SessionVeto[]
  rouletteVetoes RouletteVeto[]
  roulettes Roulette[]
  instantSessions InstantSession[]
  freeGameOffers FreeGameOffer[]
  weeklyChallenges WeeklyChallenge[]
  monthlyRecaps MonthlyRecap[]
  seasons Season[]
  groupAchievements GroupAchievement[]
  groupSessionStats GroupSessionStats[]
  groupGameStats GroupGameStat[]
  groupActiveWeeks GroupActiveWeek[]
}

model FreeGameOffer {
  id          String        @id @default(cuid())
  communityId String
  createdById String
  store       FreeGameStore
  title       String        @db.VarChar(120)
  storeUrl    String        @db.VarChar(500)
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime      @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([communityId, startsAt, endsAt])
  @@index([createdById, communityId])
}

model CommunityQuickPoll {
  id String @id @default(cuid())
  communityId String
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdById String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  question String @db.VarChar(200)
  options String[]
  endsAt DateTime
  createdAt DateTime @default(now())
  votes CommunityQuickPollVote[]

  @@unique([id, communityId])
  @@index([communityId, createdAt])
}

model CommunityQuickPollVote {
  id String @id @default(cuid())
  communityId String
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  pollId String
  poll CommunityQuickPoll @relation(fields: [pollId, communityId], references: [id, communityId], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionIndex Int

  @@unique([pollId, userId])
  @@index([communityId, pollId])
}

model CommunityGameEpitaph {
  id String @id @default(cuid())
  communityId String
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  gameId String
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdById String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  epitaph String @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([communityId, gameId])
}

model CommunityExpression {
  id String @id @default(cuid())
  communityId String
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdById String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  title String @db.VarChar(120)
  meaning String @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([communityId, createdAt])
}
enum CommunityHighlightKind {
  FAME
  SHAME
}

model CommunityHighlight {
  id String @id @default(cuid())
  communityId String
  createdById String
  kind CommunityHighlightKind
  title String @db.VarChar(120)
  description String @db.VarChar(4000)
  mediaUrl String? @db.VarChar(2048)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  @@index([communityId, createdAt])
}

// Une proposition de créneau ne crée jamais une Session ni un rappel.
// La soirée finale est liée seulement au choix transactionnel du créateur.
enum SessionAvailabilityPollStatus {
  OPEN
  CLOSED
}

enum SessionAvailabilityPollAnswer {
  AVAILABLE
  MAYBE
  UNAVAILABLE
}

model SessionAvailabilityPoll {
  id String @id @default(cuid())
  communityId String
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdById String
  createdBy User @relation("AvailabilityPollCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title String @db.VarChar(120)
  status SessionAvailabilityPollStatus @default(OPEN)
  sessionId String? @unique
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  chosenSlotId String?
  chosenSlot SessionAvailabilityPollSlot? @relation("PollChoice", fields: [id, chosenSlotId], references: [pollId, id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  participants SessionAvailabilityPollParticipant[]
  slots SessionAvailabilityPollSlot[] @relation("PollOptions")

  @@index([communityId, createdAt])
  @@index([createdById, status])
}

model SessionAvailabilityPollParticipant {
  pollId String
  userId String
  poll SessionAvailabilityPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses SessionAvailabilityPollResponse[]

  @@id([pollId, userId])
  @@index([userId])
}

model SessionAvailabilityPollSlot {
  id String @id @default(cuid())
  pollId String
  poll SessionAvailabilityPoll @relation("PollOptions", fields: [pollId], references: [id], onDelete: Cascade)
  start DateTime
  end DateTime
  chosenBy SessionAvailabilityPoll[] @relation("PollChoice")
  responses SessionAvailabilityPollResponse[]

  @@unique([pollId, id])
  @@unique([pollId, start, end])
}

model SessionAvailabilityPollResponse {
  pollId String
  slotId String
  userId String
  answer SessionAvailabilityPollAnswer
  updatedAt DateTime @updatedAt
  slot SessionAvailabilityPollSlot @relation(fields: [pollId, slotId], references: [pollId, id], onDelete: Cascade)
  participant SessionAvailabilityPollParticipant @relation(fields: [pollId, userId], references: [pollId, userId], onDelete: Cascade)

  @@id([pollId, slotId, userId])
  @@index([pollId, userId])
}

model CommunityChannelConfig {
  id               String                   @id @default(cuid())
  communityId      String
  community        Community                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  category         CommunityChannelCategory
  discordChannelId String
  enabled          Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([communityId, category])
}

model CommunityDate {
  id String @id @default(cuid())
  communityId String
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdById String
  createdBy User @relation("CommunityDateCreator", fields: [createdById], references: [id], onDelete: Cascade)
  memberId String?
  member User? @relation("CommunityDateMember", fields: [memberId], references: [id], onDelete: Cascade)
  kind CommunityDateKind
  title String? @db.VarChar(100)
  date DateTime @db.Date
  repeatsAnnually Boolean @default(false)
  createdAt DateTime @default(now())

  @@unique([communityId, memberId])
  @@index([communityId, date])
}

// Appartenance d'un utilisateur à une communauté. Un seul OWNER actif par
// communauté : garanti en code (`ensureDefaultCommunity`), pas en base.
model Membership {
  id             String           @id @default(cuid())
  communityId    String
  community      Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           CommunityRole    @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  leftAt         DateTime?
  // Dernière vérification d'appartenance au serveur Discord (cron rotatif,
  // PR suivante).
  lastVerifiedAt DateTime?

  @@unique([communityId, userId])
  @@index([userId])
}

// Une préparation concerne le jeu retenu : un changement de jeu repart à zéro.
model SessionPreparation {
  sessionId String
  userId String
  gameId String
  installed Boolean @default(false)
  updated Boolean @default(false)
  microphone Boolean @default(false)
  lobby Boolean @default(false)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId, gameId])
}
