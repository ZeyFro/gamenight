// Schéma Prisma — GameNight
// Voir SPEC-gamenight.md §5 pour le modèle de données complet.
// F1 (Auth Discord) : User.
// F2/F3 (lien Steam, biblio, ajout manuel, enrichissement IGDB) : Game, UserGame.
// F4 (dispos récurrentes + exceptions) : WeeklyAvailability, AvailabilityOverride.
// F5 (proposition + vote de soirée) : Session, Proposal, Vote.
// Les autres modèles seront ajoutés au fil des features F6 à F8.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  discordId        String   @unique
  discordName      String
  discordAvatar    String?
  // PR 8/9 — bannière de profil personnalisable. URL absolue uniquement
  // (pas de stockage de fichier ni service d'upload tiers — décision
  // documentée dans le README : la complexité d'un vrai upload n'était
  // pas justifiée pour v1). `null` = bannière par défaut (dégradé violet
  // CSS, `.profile-banner-default`).
  bannerUrl        String?
  steamId64        String?  @unique
  steamPublic      Boolean  @default(false)
  // F7 : coupe les pings `@<@discordId>` dans les rappels Discord pour cet
  // utilisateur — le message est quand même posté dans le salon, il n'est
  // simplement pas mentionné.
  silenceReminders Boolean  @default(false)
  createdAt        DateTime @default(now())

  // Chantier XP/niveaux/rangs — `xpTotal` est un cache dénormalisé (somme
  // de `XpEvent.amount`), maintenu par `awardXp` à chaque ajout d'XP.
  // Indexé pour le scoreboard (/classement, PR 9/9) qui trie par XP sur
  // potentiellement 50+ users. `streakCount`/`streakLastActiveAt` pistent
  // les jours de connexion consécutifs (mis à jour depuis
  // `getCurrentUser()`, cf. src/lib/xp.ts) : `streakCount` repart à 1 si
  // plus de 24h se sont écoulées depuis `streakLastActiveAt`.
  xpTotal            Int       @default(0)
  streakCount        Int       @default(0)
  streakLastActiveAt DateTime?

  addedGames Game[]     @relation("GameAddedBy")
  userGames  UserGame[]

  weeklyAvailability    WeeklyAvailability[]
  availabilityOverrides AvailabilityOverride[]
  proposals             Proposal[]
  votes                 Vote[]
  createdSessions       Session[]
  xpEvents              XpEvent[]
  sessionResults        SessionResult[]

  // Audit trail (PR 5/9 du chantier XP, à la demande de l'utilisateur —
  // craint qu'un pote modifie un superlatif de façon abusive pour se
  // farmer de l'XP). Pas de blocage, juste une trace de qui a touché quoi
  // en dernier, affichée discrètement sur /admin/messages et
  // /admin/jeux-stats. `createdMessageTemplates` (qui l'a créé, inchangé
  // depuis PR1) et `modifiedMessageTemplates` (qui l'a modifié EN
  // DERNIER, nouveau) sont deux relations distinctes vers le même modèle
  // — noms de relation explicites obligatoires côté Prisma dès qu'un
  // modèle a plusieurs FK vers `User`.
  createdMessageTemplates  MessageTemplate[] @relation("MessageTemplateCreatedBy")
  modifiedMessageTemplates MessageTemplate[] @relation("MessageTemplateModifiedBy")
  modifiedGameStatTypes    GameStatType[]
  modifiedSuperlatives     Superlative[]

  // PR 5/9 — vote de superlatifs entre potes. Trois relations distinctes
  // vers `SuperlativeVote` (votant ≠ voté pour) obligent des noms
  // explicites, même raison que pour `MessageTemplate` plus haut.
  modifiedSuperlativeCategories SuperlativeCategory[]
  superlativeVotesCast          SuperlativeVote[]     @relation("SuperlativeVoter")
  superlativeVotesReceived      SuperlativeVote[]     @relation("SuperlativeVotedFor")
  superlativeAwardsWon          SuperlativeAward[]

  // PR 6/9 — tierlist perso (classement S/A/B/C/D de toute la biblio
  // commune, voir `TierlistEntry`).
  tierlistEntries TierlistEntry[]

  // PR 7/9 — badges automatiques débloqués (voir `Badge`/`UserBadge`).
  userBadges UserBadge[]
  // PR 8/9 — audit trail sur /admin/badges (qui a créé/modifié un badge).
  modifiedBadges Badge[]

  @@index([xpTotal])
}

enum GameSource {
  STEAM
  IGDB
  MANUAL
}

model Game {
  id         String     @id @default(cuid())
  name       String
  source     GameSource
  steamAppId Int?
  igdbId     Int?
  coverUrl   String?
  isCoop     Boolean    @default(false)
  minPlayers Int?
  maxPlayers Int?
  addedById  String
  createdAt  DateTime   @default(now())

  // PR 32 (2.5/4) : true dès que isCoop/minPlayers/maxPlayers ont été
  // saisis ou confirmés par un humain (formulaire d'ajout/édition
  // manuel, ou le bouton "Marquer comme coop" sur /bibliotheque) — jamais
  // par l'import Steam (qui pose `isCoop=false`/`maxPlayers=null` par
  // défaut, Steam ne fournissant pas cette info) ni par le backfill IGDB
  // automatique. Distingue "valeur par défaut jamais vérifiée" de
  // "confirmée par un humain" : sans ce booléen, le backfill (rejoué à
  // chaque build) écraserait indéfiniment une correction manuelle
  // (ex. quelqu'un décoche "coop" sur un jeu qu'IGDB classe à tort en
  // coop) au déploiement suivant.
  playInfoManual Boolean @default(false)

  // Cache de la fiche IGDB détaillée (F : fiche jeu), rempli à la demande
  // au premier clic sur la fiche — jamais à l'import Steam (évite un
  // timeout Vercel si on enrichissait toute une biblio importée d'un coup).
  // `null` tant que jamais fetché (ou si IGDB n'a rien trouvé). Structure
  // libre en JSON (voir `IgdbGameDetails` dans src/lib/igdb.ts) : pas de
  // colonnes dédiées, cette donnée est display-only et sa forme suit celle
  // de l'API IGDB.
  igdbDetails          Json?
  igdbDetailsFetchedAt DateTime?

  addedBy   User       @relation("GameAddedBy", fields: [addedById], references: [id])
  userGames UserGame[]

  proposals       Proposal[]
  decidedSessions Session[]
  statTypes       GameStatType[]
  tierlistEntries TierlistEntry[]

  @@unique([steamAppId])
  @@unique([igdbId])
}

model UserGame {
  userId String
  gameId String
  owned  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
}

// Dispo récurrente par défaut : un ou plusieurs créneaux par jour de la
// semaine. `dayOfWeek` suit la convention JS `Date.getUTCDay()` (0 =
// dimanche … 6 = samedi) pour rester directement comparable à la date
// d'une Session. `startTime`/`endTime` au format "HH:mm" ; un créneau dont
// `endTime` "traverse minuit" (ex. 21:00–00:00) est géré côté application.
model WeeklyAvailability {
  id        String @id @default(cuid())
  userId    String
  dayOfWeek Int
  startTime String
  endTime   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Exception ponctuelle sur une date précise : indisponibilité
// exceptionnelle (`available = false`) ou disponibilité exceptionnelle
// (`available = true`), qui prime sur `WeeklyAvailability` ce jour-là.
// `startTime`/`endTime` optionnels : absents = toute la journée.
model AvailabilityOverride {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  available Boolean
  startTime String?
  endTime   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

enum SessionStatus {
  VOTING
  SCHEDULED
  DONE
  CANCELLED
}

// Une soirée. `date` porte la date ET l'heure visée (choisies à la
// création) ; `decidedTime` est renseigné à la clôture (copie de `date`
// pour l'instant — champ distinct pour une éventuelle renégociation future
// de l'heure). Un seul jeu gagnant par soirée (`decidedGameId`), cf. §7 —
// la file de jeux multiples est un sujet v2 dédié. `votingDeadline`
// (nullable pour les sessions créées avant son ajout) ferme le vote avant
// l'heure de la session ; nul = pas de deadline distincte, seule l'heure
// de la session ferme le vote (comportement historique).
model Session {
  id             String        @id @default(cuid())
  date           DateTime
  votingDeadline DateTime?
  status         SessionStatus @default(VOTING)
  decidedGameId  String?
  decidedTime    DateTime?
  createdAt      DateTime      @default(now())

  // Créateur de la session — introduit après coup (les sessions créées
  // avant cette migration ont été backfillées, voir la migration SQL pour
  // la stratégie exacte). Détermine qui peut modifier/supprimer/clôturer
  // manuellement/annuler cette session (les autres membres du groupe
  // peuvent toujours proposer un jeu, voter, et consulter la session).
  createdById String

  // F7 : message de rappel perso, saisi à la création de la session. S'il
  // est renseigné, il remplace le tirage aléatoire dans MessageTemplate
  // pour tous les rappels de cette session (cf. `reminderTimings`).
  customReminderMessage String?
  // F7 : fenêtres de rappel déjà envoyées pour cette session, ex.
  // `["1440", "120"]` (minutes avant la session, en string) — évite les
  // doublons si le cron retombe plusieurs fois sur la même fenêtre.
  // Tableau JSON plutôt que des booléens dédiés : les fenêtres sont un
  // détail d'implémentation (cf. `reminderTimings` ci-dessous), pas une
  // invariante du modèle.
  remindersSent  Json          @default("[]")
  // PR 31 (2/4, Bloc A) : minutes avant la session auxquelles un rappel
  // Discord doit partir — choisi par le créateur à la création (cases à
  // cocher parmi 8 préréglages + rappels custom, 5 max). Remplace les
  // fenêtres 24h/2h fixées en dur. Défaut `[1440, 120]` (24h + 2h) =
  // comportement F7 d'origine préservé pour toute nouvelle session sans
  // réglage explicite, et pour les sessions créées AVANT cette PR (valeur
  // par défaut Postgres appliquée à la colonne existante par la
  // migration, pas de backfill séparé nécessaire).
  reminderTimings Int[]        @default([1440, 120])

  // PR 5/9 — fenêtre de vote des superlatifs entre potes, ouverte par
  // `markSessionDone` (cf. src/lib/sessions.ts) : `superlativeVotingDeadline`
  // = maintenant + 24h à l'ouverture (nulle si la session n'a pas eu
  // assez de participants — voir plus loin — auquel cas
  // `superlativeVotingClosed` passe direct à `true`, aucun vote possible).
  // Le vote se clôture (cf. src/lib/superlative-voting.ts) dès que tous
  // les participants ont voté OU que la deadline est dépassée,
  // "whichever comes first" — vérifié paresseusement à la lecture (même
  // philosophie que `closeSessionIfDue` pour la clôture du vote de jeu),
  // pas de cron dédié. `superlativeVotingClosed` distingue "pas encore
  // clôturé" de "clôturé sans le moindre award" (0 vote au total) : sans
  // ce booléen, l'absence de `SuperlativeAward` serait ambiguë entre ces
  // deux cas.
  superlativeVotingDeadline DateTime?
  superlativeVotingClosed   Boolean   @default(false)

  createdBy         User               @relation(fields: [createdById], references: [id])
  decidedGame       Game?              @relation(fields: [decidedGameId], references: [id])
  proposals         Proposal[]
  results           SessionResult[]
  superlativeVotes  SuperlativeVote[]
  superlativeAwards SuperlativeAward[]
}

model Proposal {
  id           String   @id @default(cuid())
  sessionId    String
  gameId       String
  proposedById String
  createdAt    DateTime @default(now())

  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  game       Game    @relation(fields: [gameId], references: [id])
  proposedBy User    @relation(fields: [proposedById], references: [id])
  votes      Vote[]

  @@unique([sessionId, gameId])
}

model Vote {
  id         String @id @default(cuid())
  proposalId String
  userId     String

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
}

// Catégories de messages Discord textuels tirés au hasard dans
// MessageTemplate. Le résultat de vote (F6) reste hors de ce système —
// c'est un embed structuré, pas un message perso tiré au hasard.
enum MessageCategory {
  SESSION_CREATED
  SESSION_MODIFIED
  REMINDER_24H
  REMINDER_2H
  // Chantier XP/niveaux/rangs — notif Discord de passage de niveau, cf.
  // src/lib/discord-level-up.ts.
  LEVEL_UP
  // PR 5/9 — annonce des superlatifs votés après une soirée, cf.
  // src/lib/discord-session-awards.ts. Ne pas confondre avec le résultat
  // de vote F6 (embed structuré indépendant, jamais dans ce système).
  SESSION_AWARDS
  // PR 7/9 — annonce du déblocage d'un badge, cf.
  // src/lib/discord-badge-unlocked.ts.
  BADGE_UNLOCKED
}

// Messages Discord perso (rappels F7, notifs de création/modification de
// session), tirés au hasard parmi les templates actifs d'une catégorie
// donnée au moment de l'envoi. Gérés depuis /admin/messages — "admin" au
// sens large, tout utilisateur connecté peut ajouter/modifier/désactiver
// (pas de rôle admin dédié dans ce MVP, cf. spec). `active = false` est un
// fusible pratique pour désactiver un message sans perdre l'historique
// (qui l'a créé) en le supprimant. Un même message peut appartenir à
// plusieurs catégories (ex. un message générique valable pour les deux
// rappels). `variables` est purement informationnel — affiché dans
// /admin/messages pour indiquer quelles variables sont utilisables selon
// les catégories cochées, jamais validé côté serveur.
model MessageTemplate {
  id          String            @id @default(cuid())
  text        String
  active      Boolean           @default(true)
  categories  MessageCategory[]
  variables   String[]          @default([])
  createdById String
  createdAt   DateTime          @default(now())

  // Audit trail — qui a modifié ce message EN DERNIER (create ou update),
  // et quand. Backfillée à createdById/createdAt pour les lignes
  // existantes lors de la migration qui a introduit ces deux champs (donc
  // "dernière modif" = "création" tant que personne n'y a retouché
  // depuis). `modifiedAt` géré automatiquement par Prisma (`@updatedAt`),
  // jamais fixé à la main.
  modifiedById String
  modifiedAt   DateTime @updatedAt

  createdBy  User @relation("MessageTemplateCreatedBy", fields: [createdById], references: [id])
  modifiedBy User @relation("MessageTemplateModifiedBy", fields: [modifiedById], references: [id])
}

// Type d'action ayant rapporté de l'XP à un user — cf. `awardXp` dans
// src/lib/xp-actions.ts. Étendu au fil du chantier, pas avant : PR 2/9
// (XP participation, Axe 1) a posé les 5 premières valeurs ; PR 3/9 ajoute
// SESSION_RESULT (podium/coop, Axe 2) ; PR 5/9 ajoute SUPERLATIVE_AWARD
// (vote entre potes, Axe 3 v2 — voir `SuperlativeCategory` plus bas) ; PR
// 7/9 ajoute BADGE_UNLOCKED (XP optionnel à l'unlock d'un badge, voir
// `Badge` plus bas) ; le profil complet (PR 8/9) ajoutera la sienne le
// moment venu — pas de valeur d'enum qui traîne sans code pour la
// déclencher.
enum XpReason {
  CREATE_SESSION
  VOTE
  PARTICIPATE
  AVAILABILITY_FIRST
  STEAM_LINK_FIRST
  SESSION_RESULT
  SUPERLATIVE_AWARD
  BADGE_UNLOCKED
}

// Résultat "générique" d'une soirée (Axe 2) : podium 1er/2e/3e facultatif
// pour les sessions compétitives, ou simple présence (placement = null)
// pour les sessions coop (`Game.isCoop`), où tout le monde est équivalent.
// Saisi une seule fois par le créateur depuis `/sessions/[id]/resultats`
// une fois la session `DONE` — existence de lignes pour cette session =
// "résultats déjà saisis" (pas de re-saisie possible, cf. le résumé de PR
// pour la raison : éviter la double comptabilisation d'XP si un podium
// est corrigé après coup). `@@unique([sessionId, userId])` : un seul
// résultat par participant et par session.
model SessionResult {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  placement Int?
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

// Ledger XP append-only — préféré à un simple compteur sur `User` pour
// deux raisons : (1) idempotence, `@@unique([userId, reason, sourceId])`
// permet à `awardXp` et au script de backfill (prisma/backfill-xp.mjs) de
// se re-exécuter indéfiniment sans jamais doubler une même récompense —
// même mécanisme de prudence que le bug de seed corrigé en PR 2 du
// chantier précédent ; (2) `/classement` (PR 9/9) doit pouvoir filtrer
// "ce mois"/"cette semaine", ce qu'un total unique ne permettrait pas.
// `sourceId` identifie l'événement qui a rapporté l'XP — sa forme dépend
// de `reason` (id de Session pour CREATE_SESSION/PARTICIPATE, id de
// Proposal pour VOTE — pas l'id du Vote lui-même, pour ne pas re-créditer
// un aller-retour vote/dévote/revote sur la même proposition ; l'id du
// user lui-même pour les XP "une seule fois dans la vie").
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  reason    XpReason
  sourceId  String
  amount    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, sourceId])
  @@index([userId])
  @@index([createdAt])
}

enum StatType {
  INT
  FLOAT
  BOOL
}

enum SuperlativeRule {
  // Le participant avec la plus grande/plus petite valeur de la stat sur
  // la soirée gagne le superlatif (stats INT/FLOAT). En cas d'égalité,
  // l'attribution exacte (personne, plusieurs ex-aequo...) est un détail
  // d'implémentation, pas figé ici.
  MAX
  MIN
  // Stat BOOL : gagné par (chacun de) ceux dont la valeur vaut `true`
  // cette soirée-là — ex. "🏆 A gagné la partie". Le nom de la règle
  // anticipe une évolution possible où la même stat BOOL serait cumulée
  // sur plusieurs soirées ("le plus de fois true"), mais pour une saisie
  // = une soirée, c'est équivalent à "est true ce soir-là".
  TRUE_COUNT
}

// Axe 3 v1 (chantier XP) — définition des stats saisissables après une
// soirée pour un jeu donné (ex. Lethal Company : nombre de morts, butin
// récupéré...). Configuré depuis /admin/jeux-stats — "admin" au sens
// large, comme /admin/messages (pas de rôle dédié, tout le monde peut
// gérer). `higherIsBetter` est purement informatif/cosmétique (couleur
// d'affichage) : il ne détermine PAS qui gagne un superlatif, c'est le
// `rule` (MAX/MIN) de chaque `Superlative` qui le fait — une même stat
// peut porter plusieurs superlatifs avec des règles différentes (ex.
// `survivalTime` : MIN pour "😱 First blood").
//
// ABANDONNÉ EN PR 5/9 (laissé dormant, pas supprimé) : la saisie de
// stats chiffrées par soirée s'est révélée trop lourde à l'usage pour un
// groupe de potes flemmards. Remplacé par un système de VOTE entre potes,
// sans chiffres à saisir — voir `SuperlativeCategory`/`SuperlativeVote`/
// `SuperlativeAward` plus bas, complètement indépendants de ce modèle-ci.
// `/admin/jeux-stats` reste dans le code et fonctionnel (accessible par
// URL directe), juste retiré du lien de navigation sur /profil au profit
// de `/admin/superlatifs`. Ni `GameSessionResult` ni l'ancien
// `SuperlativeAward` "par jeu" envisagés à l'origine n'ont jamais été
// créés — le nouveau `SuperlativeAward` plus bas est un modèle distinct,
// sans lien avec `GameStatType`.
model GameStatType {
  id             String   @id @default(cuid())
  gameId         String
  key            String
  label          String
  type           StatType
  higherIsBetter Boolean  @default(true)
  createdAt      DateTime @default(now())

  // Audit trail (voir commentaire sur `User.modifiedGameStatTypes`) — un
  // seul champ (pas de createdById distinct) : ce modèle n'avait encore
  // aucune notion d'auteur avant cet ajout, donc "dernière modif" couvre
  // aussi "création" nativement, pas besoin d'un deuxième champ.
  modifiedById String
  modifiedAt   DateTime @updatedAt

  game         Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  modifiedBy   User          @relation(fields: [modifiedById], references: [id])
  superlatives Superlative[]

  @@unique([gameId, key])
}

// Un superlatif attribué automatiquement à partir d'une `GameStatType` —
// ex. "🐛 Bouffé par le grouille" (MAX sur la stat "morts" de Lethal
// Company). `xpReward` éditable par superlatif depuis /admin/jeux-stats
// (20 XP par défaut). ABANDONNÉ EN PR 5/9, laissé dormant — voir le
// commentaire sur `GameStatType` ci-dessus.
model Superlative {
  id             String          @id @default(cuid())
  gameStatTypeId String
  name           String
  rule           SuperlativeRule
  xpReward       Int             @default(20)
  createdAt      DateTime        @default(now())

  // Audit trail — même logique que `GameStatType.modifiedById` ci-dessus.
  modifiedById String
  modifiedAt   DateTime @updatedAt

  gameStatType GameStatType @relation(fields: [gameStatTypeId], references: [id], onDelete: Cascade)
  modifiedBy   User         @relation(fields: [modifiedById], references: [id])
}

// Axe 3 v2 (PR 5/9) — remplace le système par stats chiffrées ci-dessus
// (`GameStatType`/`Superlative`, laissé dormant) par un vote entre potes,
// génériques et indépendants du jeu joué : "qui mérite ce titre ce
// soir-là", zéro chiffre à saisir. Configuré depuis /admin/superlatifs —
// même philosophie que /admin/messages et /admin/jeux-stats (pas de rôle
// dédié, tout le monde peut gérer), avec le même audit trail
// `modifiedById`/`modifiedAt` que les autres modèles admin.
model SuperlativeCategory {
  id           String   @id @default(cuid())
  icon         String
  name         String
  description  String?
  xpReward     Int      @default(20)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  modifiedById String
  modifiedAt   DateTime @updatedAt

  modifiedBy User               @relation(fields: [modifiedById], references: [id])
  votes      SuperlativeVote[]
  awards     SuperlativeAward[]
}

// Un vote d'un participant pour un autre, sur une catégorie donnée d'une
// soirée. `@@unique([sessionId, categoryId, voterUserId])` : un seul vote
// par catégorie et par votant — pas de re-vote (appliqué côté serveur,
// cf. `submitSuperlativeVotesAction`). Voter pour soi-même est empêché
// côté UI (le votant n'apparaît jamais dans sa propre liste de choix) et
// re-vérifié côté serveur.
model SuperlativeVote {
  id             String   @id @default(cuid())
  sessionId      String
  categoryId     String
  voterUserId    String
  votedForUserId String
  createdAt      DateTime @default(now())

  session   Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  category  SuperlativeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  voter     User                @relation("SuperlativeVoter", fields: [voterUserId], references: [id], onDelete: Cascade)
  votedFor  User                @relation("SuperlativeVotedFor", fields: [votedForUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, categoryId, voterUserId])
}

// Résultat final d'une catégorie pour une soirée, calculé par
// `finalizeSuperlativeVoting` (src/lib/superlative-voting.ts) quand le
// vote se clôture. `voteCount` = nombre de votes reçus par le gagnant
// (utile pour l'affichage — "élu à 3 voix sur 4"). Pas de ligne créée
// pour une catégorie n'ayant reçu aucun vote : l'existence d'une ligne
// signifie "il y a eu au moins un vote", pas juste "la session est
// clôturée" (ce dernier état vit sur `Session.superlativeVotingClosed`).
// `@@unique([sessionId, categoryId])` : un seul gagnant par catégorie et
// par soirée.
model SuperlativeAward {
  id           String   @id @default(cuid())
  sessionId    String
  categoryId   String
  winnerUserId String
  voteCount    Int
  createdAt    DateTime @default(now())

  session  Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  category SuperlativeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  winner   User                @relation(fields: [winnerUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, categoryId])
}

enum Tier {
  S
  A
  B
  C
  D
}

// Tierlist perso (PR 6/9) — chaque user classe librement TOUTE la biblio
// commune (owned ou non par lui, cf. la même définition que
// `/bibliotheque/groupe` : tous les jeux avec au moins un `UserGame.owned`)
// dans une rangée S/A/B/C/D, par glisser-déposer sur `/tierlist`. Pas de
// ligne = "non classé" (pool à part dans l'UI, pas une 6e valeur d'enum —
// éviter une valeur qui ne serait qu'un "null" déguisé). Visible en
// lecture seule par les potes sur `/potes/[id]`, même esprit que la biblio
// et les dispos déjà exposées là. `@@unique([userId, gameId])` : un seul
// classement par jeu et par joueur ; reclasser un jeu déjà classé met à
// jour la ligne existante (`upsert`) plutôt que d'en empiler une nouvelle.
model TierlistEntry {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  tier      Tier
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

enum BadgeCategory {
  PARTICIPATION
  ENGAGEMENT
  BIBLIOTHEQUE
  VOTE
  SUPERLATIFS
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

// Badges automatiques (PR 7/9) — 100% passif, l'app détecte et attribue
// (jamais une action volontaire de l'utilisateur comme voter un
// superlatif). `criteria` en JSON plutôt que des colonnes dédiées : les 7
// types de critère (voir `BadgeCriteria` dans src/lib/badges.ts) ont tous
// la même forme `{ type, count }`, un schéma typé rigide n'apporterait
// rien ici — et ça laisse la porte ouverte à `/admin/badges` plus tard
// sans nouvelle migration. `xpReward` optionnel (certains badges pourront
// être purement honorifiques). `name` unique : sert de clé d'idempotence
// pour le seed (`prisma/seed-badges.mjs`), comme `MessageTemplate` n'en a
// pas besoin (il n'a pas de nom) mais `SuperlativeCategory` s'en sort
// avec un simple check d'existence en base à la place — ici un vrai
// contrainte unique est plus sûr vu que le seed tourne à chaque build.
model Badge {
  id          String        @id @default(cuid())
  name        String        @unique
  icon        String
  description String
  category    BadgeCategory
  rarity      BadgeRarity
  criteria    Json
  xpReward    Int?
  createdAt   DateTime      @default(now())

  // `active` (PR 8/9, /admin/badges) : même rôle que sur
  // `SuperlativeCategory` — un badge désactivé n'est plus jamais
  // débloqué (`unlockMatchingBadges` filtre dessus), mais n'est PAS
  // masqué de l'affichage `BadgeGrid` (encyclopédique : montrer un badge
  // "à venir mais pas encore actif" reste informatif) ni des `UserBadge`
  // déjà attribués (jamais de retrait rétroactif, cf. commentaire sur
  // `UserBadge` plus bas). Audit trail `modifiedById`/`modifiedAt` — même
  // logique que `SuperlativeCategory`/`GameStatType`.
  active       Boolean  @default(true)
  modifiedById String
  modifiedAt   DateTime @updatedAt

  modifiedBy User        @relation(fields: [modifiedById], references: [id])
  userBadges UserBadge[]
}

// Attribution d'un badge à un user. `@@unique([userId, badgeId])` : un
// badge ne se débloque qu'une fois par user (`unlockBadge`,
// src/lib/badges.ts, l'utilise comme filet de sécurité idempotent en plus
// du check applicatif "déjà débloqué ?"). Si les critères d'un `Badge`
// sont modifiés après coup (ex. seuil relevé), les `UserBadge` déjà
// créés restent : jamais de retrait rétroactif, un badge gagné reste
// gagné — cohérent avec le principe déjà appliqué au streak (badge
// "Marathon" débloqué une fois, jamais retiré si le streak retombe).
model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}
