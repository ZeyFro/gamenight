# MODÈLE de configuration PRIVÉE du worker vocal : NOMS de variables uniquement, aucune valeur.
# Ne jamais remplir ce fichier dans le dépôt, ni coller son contenu remplie dans une conversation, un ticket ou un journal.
#
# Création : par le propriétaire, localement SUR l'hôte, avec les droits root, jamais copié depuis un autre poste :
#   sudo install -d -o root -g root -m 0750 /etc/gamenight
#   sudo install -o root -g root -m 0600 /dev/null /etc/gamenight/gamenight.env
#   sudoedit /etc/gamenight/gamenight.env        # y recopier les NOMS ci-dessous puis saisir les valeurs
# Contrôle (n'affiche aucune valeur) : node scripts/voice-host-diagnostic.mjs
# Même format pour l'unité systemd (EnvironmentFile) et pour `docker compose --env-file` : NOM=valeur, sans guillemets ni « export ».

# --- Requis pour démarrer le serveur (collecte éteinte) ---
DATABASE_URL=
# Doit rester EXACTEMENT « false » (une seule ligne) tant que l'activation de la collecte n'est pas autorisée.
VOICE_PRESENCE_ENABLED=false

# --- Requis seulement à l'activation de la collecte (autorisation séparée) ---
DISCORD_BOT_TOKEN=
DISCORD_BOT_GUILD_ID=
VOICE_PRESENCE_CONSENT_DECISION=
VOICE_PRESENCE_RETENTION_DECISION=
AUTH_SECRET=
CRON_SECRET=

# --- Optionnels (valeurs par défaut sûres) ---
# Fixé par l'unité systemd et le compose : n'est à définir ici que pour le remplacer.
# VOICE_PRESENCE_WORKER_MODE=
# Intervalle de poll en ms, minimum 5000, défaut 15000.
# VOICE_PRESENCE_POLL_INTERVAL_MS=
# Délai maximal d'arrêt propre en ms (1000 à 600000, défaut 40000) ; garder inférieur à TimeoutStopSec / stop_grace_period (45 s).
# VOICE_WORKER_SHUTDOWN_TIMEOUT_MS=
